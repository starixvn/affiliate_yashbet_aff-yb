@model Fanex.Affiliate.User.Core.MetalModels.Email.PaymentEmailParam
<div>
    প্রিয় @Model.User.FirstName,<br /><br />

    অনুরোধ রেফারেন্স নম্বর হল @Model.TransId, তারিখ @Model.RequestDate.ToString("MM/dd/yyyy")<br /><br />

    আপনার @Model.Amount @Model.DefaultCurrency পেমেন্ট অনুরোধটি বাতিল হয়েছে।<br /><br />

    এটি একটি সিস্টেম স্বয়ংক্রিয় জেনারেট ইমেল, দয়া করে এই ইমেলে সরাসরি উত্তর দিবেন না।<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>এ যোগাযোগ করার জন্য আপনি যদি কোনও প্রশ্ন বা মন্তব্য থাকে তাহলে আমাদের সাথে যোগাযোগ করবেন।<br /><br />

    আপনার একটি মহান দিন হোক!<br /><br />

    সবচেয়ে ভালো শুভেচ্ছা,<br /><br />

    @Model.SiteFriendlyName অফিলিয়েটস দল
</div>