@model Fanex.Affiliate.User.Core.MetalModels.Email.NewPasswordEmailParam
@{
    var userInfo = Model.User;
}
<div>
    প্রিয় @userInfo.FirstName,<br /><br />

    আপনি যে অনুরোধ করেছেন, আমরা আপনাকে একটি নতুন পাসওয়ার্ড প্রদান করেছি। আপনার নতুন অ্যাকাউন্টের তথ্য নিম্নলিখিত:<br /><br />

    --------------------------------------------------------<br />
    ব্যবহারকারী নাম: @userInfo.UserName<br />
    পাসওয়ার্ড: @Model.NewPassword<br />
    --------------------------------------------------------<br /><br />

    তবে, আপনি যে সময় চান, <a href="@Model.RootDomain">@Model.RootDomain</a> এ গিয়ে আপনার পাসওয়ার্ড পরিবর্তন করতে পারেন।<br /><br />

    আপনার একটি মহান দিন হোক!<br /><br />

    সবচেয়ে ভালো শুভেচ্ছা,<br /><br />

    @Model.SiteFriendlyName অফিলিয়েটস দল<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>