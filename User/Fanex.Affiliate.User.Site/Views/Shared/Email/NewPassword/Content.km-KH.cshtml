@model Fanex.Affiliate.User.Core.MetalModels.Email.NewPasswordEmailParam
@{
    var userInfo = Model.User;
}
<div>
    សូមគោរព @userInfo.FirstName,<br /><br />

    ដូចដែលអ្នកបានស្នើសុំ យើងបានផ្មើឱ្យអ្នកនូវលេខសម្ងាត់ថ្មី។ ព័ត៌មានថ្មីគរបស់ណនីអ្នកមានដូចខាងក្រោម៖<br /><br />

    --------------------------------------------------------<br />
    ឈ្មោះ​គណនីអ្នកប្រើប្រាស់: @userInfo.UserName<br />
    លេខសម្ងាត់: @Model.NewPassword<br />
    --------------------------------------------------------<br /><br />

    ទោះជាយ៉ាងណាក៏ដោយ អ្នកអាចទាក់ទងទៅកាន់ <a href="@Model.RootDomain">@Model.RootDomain</a> ដើម្បីផ្លាស់ប្តូរលេខសម្ងាត់របស់អ្នកបានគ្រប់ពេលវេលា<br /><br />

    សូម​ឱ្យជួបតែសំណាងល្អសម្រាប់ថ្ងៃនេះ<br /><br />

    សូមគោរព<br /><br />

    ក្រុមសាខាសម្ព័ន្ធនៅ@Model.SiteFriendlyName<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>