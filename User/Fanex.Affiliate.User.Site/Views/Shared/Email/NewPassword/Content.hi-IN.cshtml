@model Fanex.Affiliate.User.Core.MetalModels.Email.NewPasswordEmailParam
@{
    var userInfo = Model.User;
}
<div>
    प्रिय @userInfo.FirstName,<br /><br />

    जैसा आपने अनुरोध किया है, हम आपको एक नया पासवर्ड प्रदान करते हैं। आपकी नई खाता जानकारी इस प्रकार है:<br /><br />

    --------------------------------------------------------<br />
    उपयोगकर्ता नाम: @userInfo.UserName<br />
    पासवर्ड: @Model.NewPassword<br />
    --------------------------------------------------------<br /><br />

    आप किसी भी समय अपना पासवर्ड बदलने के लिए <a href="@Model.RootDomain">@Model.RootDomain</a> पर जा सकते हैं<br /><br />

    आपका दिन अच्छा रहे!<br /><br />

    सादर,<br /><br />

    @Model.SiteFriendlyName सहयोगी की टीम<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
