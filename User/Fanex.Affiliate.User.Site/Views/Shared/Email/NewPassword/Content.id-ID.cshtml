@model Fanex.Affiliate.User.Core.MetalModels.Email.NewPasswordEmailParam
@{
    var userInfo = Model.User;
}
<div>
    Yang terhotmat @userInfo.FirstName, <br /><br />

    Seperti yang Anda minta, kami berikan kata sandi yang baru. Anda informasi account baru adalah sebagai berikut: <br /><br />

    -------------------------------------------------------- <br />
    Nama Pengguna: @userInfo.UserName <br />
    Kata Sandi: @Model.NewPassword <br />
    -------------------------------------------------------- <br /><br />

    Namun, Anda dapat mengunjungi <a href="@Model.RootDomain">@Model.RootDomain</a> untuk mengubah sandi Anda kapan saja <br /><br />

    Salam Sejahtera, <br /><br />

    Tim di @Model.SiteFriendlyName Afiliasi<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>