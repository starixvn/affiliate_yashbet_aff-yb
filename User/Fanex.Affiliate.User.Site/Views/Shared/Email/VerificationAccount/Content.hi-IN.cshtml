@model Fanex.Affiliate.User.Core.MetalModels.Email.VerificationAccountEmailParam
@{
    var userInfo = Model.User;
    var forgotPasswordUrl = Model.RootDomain + "Password";
    var contacUsLink = Model.RootDomain + "ContactUs";
}
<div>
    <h3>प्रिय @userInfo.FirstName @userInfo.LastName,</h3><br />

    यहां सत्यापन कोड है जिसे आपको @userInfo.UserName खाते में लॉगिन करने की आवश्यकता है:<br />

    <h3>@Model.Code</h3><br />

    यह ईमेल <a href="@string.Format("https://iplocation.com/?ip={0}", Model.Ip)">@Model.Ip</a> . पर स्थित वेब या मोबाइल डिवाइस से लगातार कई असफल लॉगिन के कारण उत्पन्न हुआ था<br />
    लॉगिन पूरा करने के लिए सत्यापन कोड आवश्यक है। कोड 15 मिनट के बाद समाप्त हो जाएगा।<br />
    यदि आप लॉग इन करने में सक्षम नहीं हैं तो कृपया पासवर्ड बदलें, और अपने खाते की सुरक्षा सुनिश्चित करने के लिए अपना ईमेल पासवर्ड भी बदलने का प्रयास करें।<br /><br />

    यदि आप अपने खाते तक पहुंचने में असमर्थ हैं तो नया पासवर्ड प्राप्त करने में सहायता के लिए <a href='@forgotPasswordUrl'>इस पासवर्ड भूल गए लिंक का उपयोग करें</a>.<br /><br />

    @Model.SiteFriendlyName सहयोगी की टीम<br />

    <a href="@contacUsLink">@contacUsLink</a>
</div>