@model Fanex.Affiliate.User.Core.MetalModels.Email.VerificationAccountEmailParam
@{
    var userInfo = Model.User;
    var forgotPasswordUrl = Model.RootDomain + "Password";
    var contacUsLink = Model.RootDomain + "ContactUs";
}
<div>
    <h3>প্রিয় @userInfo.FirstName @userInfo.LastName,</h3><br />

    এখানে আপনার অ্যাকাউন্ট @userInfo.UserName এ লগইন করার জন্য আপনার যে যাচ্ছে যে যাচ্ছে সেটি ভেরিফিকেশন কোড:<br />

    <h3>@Model.Code</h3><br />

    এই ইমেলটি পোড়শিয়ানের <a href="@string.Format("https://iplocation.com/?ip={0}", Model.Ip)">@Model.Ip</a> স্থানে অবস্থিত একটি ওয়েব বা মোবাইল ডিভাইস থেকে অনেকগুলি অপরাধপ্রবৃত্তি স্থাপন করার জন্য উত্তীর্ণ হয়েছে<br />
    লগইন সম্পূর্ণ করতে ভেরিফিকেশন কোডটি প্রয়োজন। কোডটি 15 মিনিট পরে মেয়াদ শেষ হবে।<br />
    আপনি যদি লগইন চেষ্টা করছেন না তাহলে দয়া করে পাসওয়ার্ড পরিবর্তন করুন, এবং আপ<br /><br />

    যদি আপনি আপনার অ্যাকাউন্টে অ্যাক্সেস না করতে পারেন তাহলে <a href='@forgotPasswordUrl'>এই ভুলে গেছেন পাসওয়ার্ড লিঙ্ক</a> ব্যবহার করে নতুন পাসওয়ার্ড পেতে সাহায্য প্রাপ্ত করতে।<br /><br />

    @Model.SiteFriendlyName অফিলিয়েটস দল<br />

    <a href="@contacUsLink">@contacUsLink</a>
</div>