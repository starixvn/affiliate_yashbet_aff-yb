@model Fanex.Affiliate.User.Core.MetalModels.Email.VerificationAccountEmailParam
@{
    var userInfo = Model.User;
    var forgotPasswordUrl = Model.RootDomain + "Password";
    var contacUsLink = Model.RootDomain + "ContactUs";
}
<div>
    <h3>เรียน คุณ @userInfo.FirstName @userInfo.LastName,</h3><br />

    รหัสยืนยันความปลอดภัยดังกล่าวคุณต้องใช้ล็อกอินสำหรับพันธมิตรนี้เท่านั้น @userInfo.UserName:<br />

    <h3>@Model.Code</h3><br />

    อีเมล์นี้ส่งจากระบบเนื่องจากคุณได้เข้าสู่ระบบพันธมิตรผิดพลาดหลายครั้งจากเว็บไซต์หรือมือถือด้วยไอพีแอดเดรสนี้ <a href="@string.Format("https://iplocation.com/?ip={0}", Model.Ip)">@Model.Ip</a><br />
    รหัสยืนยันความปลอดภัยดังกล่าวต้องนำไปเข้าสู่ระบบที่หน้าเว็บไซต์ทันทีภายใน 15 นาทีหลังจากได้รับรหัสนี้<br />
    หากคุณไม่ได้เป็นผู้ขอรหัสยืนยันความปลอดภัยนี้ โปรดทำการเปลี่ยนรหัสผ่านบัญชีพันธมิตร, และแนะนำให้เปลี่ยนรหัสผ่านอีเมล์ของคุณด้วยเพื่อความปลอดภัย ป้องกันการแอบอ้างเข้าถึงบัญชีพันธมิตรของคุณ<br /><br />

    หากคุณยังไม่สามารถเข้าสู่ระบบบัญชีพันธมิตรของคุณ <a href='@forgotPasswordUrl'>โปรดใช้ลิ้งค์นี้เพื่อยืนยันการลืมรหัสผ่าน</a> เพื่อรับรหัสผ่านใหม่ใช้เข้าสู่ระบบต่อไปได้<br /><br />

    ทีมงานพันธมิตร @Model.SiteFriendlyName<br />

    <a href="@contacUsLink">@contacUsLink</a>
</div>