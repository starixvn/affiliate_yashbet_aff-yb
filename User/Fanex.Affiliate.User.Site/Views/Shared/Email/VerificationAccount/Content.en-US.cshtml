@model Fanex.Affiliate.User.Core.MetalModels.Email.VerificationAccountEmailParam
@{
    var userInfo = Model.User;
    var forgotPasswordUrl = Model.RootDomain + "Password";
    var contacUsLink = Model.RootDomain + "ContactUs";
}
<div>
    <h3>Dear @userInfo.FirstName @userInfo.LastName,</h3><br />

    Here is the verification code you need to login to account @userInfo.UserName:<br />

    <h3>@Model.Code</h3><br />

    This email was generated because of many consecutive failed logins from a web or mobile device located at <a href="@string.Format("https://iplocation.com/?ip={0}", Model.Ip)">@Model.Ip</a><br />
    The verification code is required to complete the login. The code will be expired after 15 minutes.<br />
    If you are not attempting to login then please change the password, and consider changing your email password as well to ensure your account security.<br /><br />

    If you are unable to access your account then <a href='@forgotPasswordUrl'>use this forgot password link</a> for assistance obtaining a new password.<br /><br />

    The @Model.SiteFriendlyName Affiliate team<br />

    <a href="@contacUsLink">@contacUsLink</a>
</div>