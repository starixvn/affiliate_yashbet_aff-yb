@model Fanex.Affiliate.User.Core.MetalModels.Email.VerificationAccountEmailParam
@{
    var userInfo = Model.User;
    var forgotPasswordUrl = Model.RootDomain + "Password";
    var contacUsLink = Model.RootDomain + "ContactUs";
}
<div>
    <h3>Dear @userInfo.FirstName @userInfo.LastName,</h3><br />

    Ini adalah kode verifikasi Anda silahkan lakukan login di Akun Anda @userInfo.UserName:<br />

    <h3>@Model.Code</h3><br />

    Email ini terdeteksi telah berkali kali gagal dalam melakukan login di web ataupun ponsel lokasi di <a href="@string.Format("https://iplocation.com/?ip={0}", Model.Ip)">@Model.Ip</a><br />
    Verifikasi kode diperlukan agar dapat melakukan login. Kode ini akan kadaluarsa setelah 15 menit.<br />
    Jika Anda tidak melakukan login sebelumnya,silahkan lakukan pergantian password, dan
    kami pertimbangkan Anda untuk mengubah kata sandi email Anda juga untuk memastikan keamanan akun Anda.<br /><br />

    Jika Anda tidak bisa masuk dalam Akun Anda, <a href='@forgotPasswordUrl'>silahkan gunakan link lupa password ini</a> untuk bantuan mendapatkan password terbaru Anda.<br /><br />

    Afiliasi @Model.SiteFriendlyName Tim<br />

    <a href="@contacUsLink">@contacUsLink</a>
</div>