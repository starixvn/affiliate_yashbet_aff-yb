@model Fanex.Affiliate.User.Core.MetalModels.Email.VerificationAccountEmailParam
@{
    var userInfo = Model.User;
    var forgotPasswordUrl = Model.RootDomain + "Password";
    var contacUsLink = Model.RootDomain + "ContactUs";
}
<div>
    <h3>សូមគោរព @userInfo.FirstName @userInfo.LastName,</h3><br />

    នៅទីនេះគឺជាលេខកូដផ្ទៀងផ្ទាត់ដែលអ្នកត្រូវចូលទៅគណនី @userInfo.UserName:<br />

    <h3>@Model.Code</h3><br />

    អ៊ីមែល​នេះ​ត្រូវ​បាន​បង្កើត​ឡើង​ដោយ​សារ​តែ​ការ​ចុចចូល​​បរាជ័យ​ជា​ច្រើន​ជាប់ៗ​គ្នា​ពី​គេហទំព័រ ឬ ​ឧបករណ៍​ចល័ត​ដែល​មាន​ទីតាំង​នៅ <a href="@string.Format("https://iplocation.com/?ip={0}", Model.Ip)">@Model.Ip</a><br />
    លេខកូដផ្ទៀងផ្ទាត់ត្រូវបានទាមទារដើម្បីបញ្ចប់ការចុចចូល។ លេខកូដនឹងផុតកំណត់បន្ទាប់ពី 15 នាទី។<br />
    ប្រសិនបើអ្នកមិនព្យាយាមចុចចូលទេ សូមប្តូរលេខសម្ងាត់ ហើយពិចារណាផ្លាស់ប្តូរលេខសម្ងាត់អ៊ីមែលរបស់អ្នកផងដែរ ដើម្បីធានាសុវត្ថិភាពគណនីរបស់អ្នក។<br /><br />

    ប្រសិនបើអ្នកមិនអាចចុចចូលប្រើគណនីរបស់អ្នកបានទេ នោះ <a href='@forgotPasswordUrl'>សូមប្រើតំណលីងនេះដែលភ្លេចលេខសម្ងាត់</a> សម្រាប់ជំនួយក្នុងការទទួលបានលេខសម្ងាត់ថ្មី។<br /><br />

    ក្រុមសាខាសម្ព័ន្ធនៅ@Model.SiteFriendlyName<br />

    <a href="@contacUsLink">@contacUsLink</a>
</div>