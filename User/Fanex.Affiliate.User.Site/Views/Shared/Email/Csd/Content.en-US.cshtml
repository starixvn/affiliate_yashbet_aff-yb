@model Fanex.Affiliate.User.Core.MetalModels.Email.NoticeEmailParam
<div>
    Dear CSD, <br /><br />

    There is a new affiliate account awaiting approval. The details are as below: <br /><br />

    ----------------------------------------------------------<br />
    Full name: @Model.FirstName @Model.LastName <br />
    Username: @Model.UserName <br />

    @if (string.IsNullOrEmpty(Model.NoSiteDesc))
    {
        <p>Site URL: @Raw(Model.SiteUrl)</p>

        if (!string.IsNullOrEmpty(Model.MoreSiteUrls))
        {
            <p>More site URLs: @Raw(Model.MoreSiteUrls)</p>
        }
    }
    else
    {
        <p>I do not have a website: @Raw(Model.NoSiteDesc)</p>
    }
    ----------------------------------------------------------<br /><br />

    Please arrange to proceed. <br /><br />

    Sincerely, <br /><br />

    @Model.SiteFriendlyName Affiliates Team<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>
