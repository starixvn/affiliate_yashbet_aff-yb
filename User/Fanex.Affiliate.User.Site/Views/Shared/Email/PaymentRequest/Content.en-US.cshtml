@model Fanex.Affiliate.User.Core.MetalModels.Email.PaymentEmailParam
<div>
    Dear @Model.User.FirstName,<br /><br />

    Thank you for your payment request dated @Model.RequestDate.ToString("MM/dd/yyyy") for the amount of @Model.Amount @Model.DefaultCurrency .<br />
    Your request reference number is @Model.TransId .<br /><br />

    Your payment request will be processed within 15 working days. All requests are reviewed in the order in which they are received, and subject for our Compliance checking.<br /><br />

    This is a system auto generated email, please do not reply to this email directly.<br />
    Do not hesitate to contact us if you have any questions or comments at <a href="mailto:@Model.MailContact">@Model.MailContact</a><br /><br />

    Have a great day!<br /><br />

    Best regards,<br /><br />

    The team at @Model.SiteFriendlyName Affiliates
</div>