@model Fanex.Affiliate.User.Core.MetalModels.Email.PaymentEmailParam
<div>
    Yang terhormat @Model.User.FirstName,<br /><br />

    Terima kasih atas permintaan pembayaran Anda tanggal @Model.RequestDate.ToString("MM/dd/yyyy") untuk jumlah @Model.Amount @Model.DefaultCurrency<br />

    Permintaan Anda nombor referensi adalah  @Model.TransId .<br /><br />

    Permintaan pembayaran Anda akan diproses dalam waktu 15 hari kerja. Semua permintaan akan diperiksa sesuai urutan permintaan diterima, dan bersubjek pada pemeriksaan dari departemen terkait. <br /><br />

    Ini adalah sistem yang dihasilkan otomatis email, harap jangan balas email ini secara langsung. <br />
    Jangan ragu untuk menghubungi kami jika Anda memiliki pertanyaan atau komentar di <a href="mailto:@Model.MailContact">@Model.MailContact</a><br /><br />

    Salam Sejahtera,<br /><br />

    Tim di @Model.SiteFriendlyName Afiliasi<br /><br />
</div>