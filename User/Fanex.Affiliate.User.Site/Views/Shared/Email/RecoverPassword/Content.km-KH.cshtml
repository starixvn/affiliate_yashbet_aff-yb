@model Fanex.Affiliate.User.Core.MetalModels.Email.RecoverPasswordEmailParam
@{
    var userInfo = Model.User;
    var recoverUrl = Model.RootDomain + "Password/RecoverPassword?uid=" + userInfo.AffId + "&vid=" + Model.Code;
}
<div>
    សូមគោរព @userInfo.FirstName,<br /><br />

    អ្នកបានស្នើសុំឱ្យយកឈ្មោះគណនីអ្នកប្រើ ឬ លេខសម្ងាត់របស់អ្នកមកវិញ។ ប្រសិនបើអ្នកមិនបានស្នើសុំទេ សូមអើពើអ៊ីមែលនេះ។<br />
    បើមិនដូច្នេះទេ សូមចូលទៅកាន់តំណលីងខាងក្រោម នោះលេខសម្ងាត់ថ្មីរបស់អ្នកនឹងត្រូវបានផ្ញើមកកាន់អ្នកក្នុងពេលឆាប់ៗ៖<br />
    <a href='@recoverUrl'>@recoverUrl</a><br /><br />

    សូម​ចំណាំ<br />
    * មោះគណនីប្រើប្រាស់របស់អ្នកគឺ៖ @userInfo.UserName <br />
    * ដោយសារហេតុផលសុវត្ថិភាព យើងត្រូវផ្តល់ឱ្យអ្នកនូវលេខយសម្ងាត់ថ្មី (អ្នកអាចផ្លាស់ប្តូរវាបានគ្រប់ពេលឬពេលក្រោយ)។<br />
    * តំណលីងខាងលើនឹងត្រូវផុតកំណត់ ហើយមិនមានប្រយោជន៍ក្នុងរយៈពេល 24 ម៉ោង។<br /><br />

    សូម​ឱ្យជួបតែសំណាងល្អសម្រាប់ថ្ងៃនេះ<br /><br />

    សូមគោរព<br /><br />

    ក្រុមសាខាសម្ព័ន្ធនៅ@Model.SiteFriendlyName<br />

    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>
