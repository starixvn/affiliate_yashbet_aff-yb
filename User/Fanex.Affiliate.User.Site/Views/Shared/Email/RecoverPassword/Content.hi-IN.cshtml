@model Fanex.Affiliate.User.Core.MetalModels.Email.RecoverPasswordEmailParam
@{
    var userInfo = Model.User;
    var recoverUrl = Model.RootDomain + "Password/RecoverPassword?uid=" + userInfo.AffId + "&vid=" + Model.Code;
}
<div>
    प्रिय @userInfo.FirstName,<br /><br />

    आपने अपना उपयोगकर्ता नाम या पासवर्ड पुनर्प्राप्त करने का अनुरोध किया है। यदि आपने इसका अनुरोध नहीं किया है, तो कृपया इस ईमेल पर ध्यान न दें।<br />
    अन्यथा कृपया निम्न लिंक पर जाएं, फिर आपका नया पासवर्ड शीघ्र ही आपको ईमेल कर दिया जाएगा:<br />
    <a href='@recoverUrl'>@recoverUrl</a><br /><br />

    कृपया ध्यान दें<br />
    * आपका यूज़रनेम है: @userInfo.UserName <br />
    * सुरक्षा कारणों से, हमें आपको एक नया पासवर्ड प्रदान करना होगा (आप इसे बाद में कभी भी बदल सकते हैं)।<br />
    * उपर्युक्त लिंक समाप्त हो जाएगा और 24 घंटे के समय में निष्क्रिय हो जाएगा।<br /><br />

    आपका दिन अच्छा रहे!<br /><br />

    सादर,<br /><br />

    @Model.SiteFriendlyName सहयोगी की टीम<br />

    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>
