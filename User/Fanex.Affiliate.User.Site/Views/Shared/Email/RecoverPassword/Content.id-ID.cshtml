@model Fanex.Affiliate.User.Core.MetalModels.Email.RecoverPasswordEmailParam
@{
    var userInfo = Model.User;
    var recoverUrl = Model.RootDomain + "Password/RecoverPassword?uid=" + userInfo.AffId + "&vid=" + Model.Code;
}
<div>
    Yang terhotmat @userInfo.FirstName,<br /><br />

    Anda melakukan permintaan untuk mendapatkan kembali username atau password.<br />
    Jika anda tidak melakukan permintaan ini, tolong hiraukan email ini.<br />
    Sebaliknya silakan klik link berikut ini, maka password baru akan segera diemailkan kepada anda :<br />
    <a href='@recoverUrl'>@recoverUrl</a><br /><br />

    Catatan :<br />
    * Username anda: @userInfo.UserName <br />
    * Untuk alasan keamanan, kami akan memberikan password baru pada anda (anda dapat mengubahnya kapan saja nanti).<br />
    * Link yang diberikan diatas akan kadaluarsa dan menjadi tidak berguna setelah 24 jam.<br /><br />

    Salam Sejahtera, <br /><br />

    Tim di @Model.SiteFriendlyName Afiliasi<br />

    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>
