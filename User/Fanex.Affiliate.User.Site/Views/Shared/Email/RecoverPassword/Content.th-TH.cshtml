@model Fanex.Affiliate.User.Core.MetalModels.Email.RecoverPasswordEmailParam
@{
    var userInfo = Model.User;
    var recoverUrl = Model.RootDomain + "Password/RecoverPassword?uid=" + userInfo.AffId + "&vid=" + Model.Code;
}
<div>
    เรียน คุณ @userInfo.FirstName<br /><br />

    ตามที่คุณได้ทำการขอร้องขอ ชื่อ และ รหัสในการเข้าระบบ หากคุณไม่ได้ร้องขอ กรุณาอย่าใส่ใจกับอีเมลล์นี้  <br />
    หากคุณได้ทำการร้องขอ กรุณาคลิ๊กไปที่ลิ๊งค์นี้ รหัสใหม่จะถูกส่งไปที่อีเมลล์คุณาโดยเร็วทีสุด<br />
    <a href='@recoverUrl'>@recoverUrl</a><br /><br />

    หมายเหตุ<br />
    ชื่อ ยูสเซอร์เนม คือ @userInfo.UserName<br />
    เนื่องจากเหตุผลในเรื่องของความปลอดภัย หลังจากที่เราให้รหัสใหม่กับคุณกรุณาเข้าไปเปลี่ยนรหัสอีกครั้งตามที่คุณต้องการ<br />
    ลิ๊งค์ข้างบนนี้ จะหมดอายุการใช้งาน ภายใน 24 ชั่วโมง<br /><br />

    ขอบคุณที่ใช้บริการ @Model.SiteFriendlyName<br /><br />

    ขอให้คุณโชคดี !<br /><br />

    ขอแสดงความนับถือ<br /><br />

    ทีมงานพันธมิตร @Model.SiteFriendlyName<br />

    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>
