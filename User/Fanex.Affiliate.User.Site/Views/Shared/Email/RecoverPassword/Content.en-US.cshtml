@model Fanex.Affiliate.User.Core.MetalModels.Email.RecoverPasswordEmailParam
@{
    var userInfo = Model.User;
    var recoverUrl = Model.RootDomain + "Password/RecoverPassword?uid=" + userInfo.AffId + "&vid=" + Model.Code;
}
<div>
    Dear @userInfo.FirstName,<br /><br />

    You have requested to recover your username or password. If you did not request it, please ignore this email.<br />
    Otherwise please visit the following link, then your new password will be emailed to you shortly:<br />
    <a href='@recoverUrl'>@recoverUrl</a><br /><br />

    Please note<br />
    * Your username is: @userInfo.UserName <br />
    * Due to security reason, we must provide you a new password (you can change this at anytime later).<br />
    * The above link will be expired and become useless in 24 hours time.<br /><br />

    Have a great day!<br /><br />

    Best regards,<br /><br />

    The team at @Model.SiteFriendlyName Affiliates<br />

    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>
