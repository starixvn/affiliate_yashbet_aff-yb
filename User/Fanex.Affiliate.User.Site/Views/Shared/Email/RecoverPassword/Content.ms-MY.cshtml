@model Fanex.Affiliate.User.Core.MetalModels.Email.RecoverPasswordEmailParam
@{
    var userInfo = Model.User;
    var recoverUrl = Model.RootDomain + "Password/RecoverPassword?uid=" + userInfo.AffId + "&vid=" + Model.Code;
}
<div>
    Yang dikasihi @userInfo.FirstName,<br /><br />

    Anda telah meminta untuk memulihkan nama pengguna atau kata laluan anda. Jika anda tidak memintanya, sila abaikan e-mel ini.<br />
    Jika tidak, sila lawati link berikut, maka kata laluan baharu anda akan dihantar melalui e-mel kepada anda secepatnya:<br />
    <a href='@recoverUrl'>@recoverUrl</a><br /><br />

    Sila ambil perhatian<br />
    * Nama pengguna anda ialah: @userInfo.UserName <br />
    * Atas sebab keselamatan, kami mesti memberikan kata laluan baharu kepada anda (anda boleh menukarnya pada bila-bila masa kemudian).<br />
    * Link di atas akan tamat tempoh dan menjadi tidak berguna dalam masa 24 jam.<br /><br />

    Salam sejahtera!<br /><br />

    Yang Benar,<br /><br />

    Pasukan di @Model.SiteFriendlyName Affiliates<br />

    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>
