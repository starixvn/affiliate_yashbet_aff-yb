@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
}

@using Fanex.Affiliate.User.Core.CoreService

@section afterLogin{after-login}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/main-after-login.css")" rel="stylesheet" />
    @RenderSection("styles", required: false)
}

<div class="main after-login">
    @RazorHelper.RenderHotNews()
    <div class="after-login-container">
        <div class="content-menu">
            <ul class="menu list-unstyled content-menu-pc" id="mainMenu">
                <li><a class="menu-item" id="menuAccountOverview" href="@Url.Content("~/UserPanel/Main/#AccountOverview")">@Lang.AccOverview</a></li>
                <li><a class="menu-item" id="menuStatementHistory" href="@Url.Content("~/UserPanel/Main/#StatementHistory")">@Lang.StatementHistory</a></li>
                <li><a class="menu-item" id="menuMyAccount" href="@Url.Content("~/UserPanel/Main/#MyAccount")">@Lang.MyAccount</a></li>
                <li><a class="menu-item" id="menuPaymentRequest" href="@Url.Content("~/UserPanel/Main/#PaymentRequest")">@Lang.PaymentRequest</a></li>
                @if (!sessionService.UserSession.DisabledTransfer)
                {
                    <li class="parent">
                        <a class="menu-item" href="javascript:;">@Lang.TransferBalanceForPlayer <i class="content-dropdown-icon"></i></a>
                        <ul class="menu submenu-container list-unstyled">
                            <li><a class="menu-item" id="menuPlayerTransferBalance" href="@Url.Content("~/UserPanel/Main/#PlayerTransferBalance")">@Lang.TransferBalanceForPlayer</a></li>

                            <li><a class="menu-item" id="menuPlayerTransferBalanceHistory" href="@Url.Content("~/UserPanel/Main/#PlayerTransferBalanceHistory")">@Lang.TransferBalanceForPlayerHistory</a></li>

                        </ul>
                    </li>
                }
                <li><a class="menu-item" id="menuRevenueReport" href="@Url.Content("~/UserPanel/Main/#RevenueReport")">@Lang.CommissionReport</a></li>
                <li class="parent">
                    <a class="menu-item" href="javascript:;">@Lang.Statistics <i class="content-dropdown-icon"></i></a>
                    <ul class="menu submenu-container list-unstyled">
                        <li><a class="menu-item" id="menuReferrersStatistics" href="@Url.Content("~/UserPanel/Main/#ReferrersStatistics")">@Lang.Referrals</a></li>
                        <li><a class="menu-item" id="menuLandingPageStatistics" href="@Url.Content("~/UserPanel/Main/#LandingPageStatistics")">@Lang.LandingPages</a></li>
                        <li><a class="menu-item" id="menuMarketingLinkStatistics" href="@Url.Content("~/UserPanel/Main/#MarketingLinkStatistics")">@Lang.MarketLinkStatistics</a></li>
                    </ul>
                </li>
            </ul>

            <div class="content-menu-mobile">
                <div class="show-name-menu">
                    @Lang.SelectOne
                </div>
                <ul class="dropdown-content-menu">
                    <li><a href="@Url.Content("~/UserPanel/Main/#AccountOverview")" class="menu-item" id="menuAccountOverviewMobile">@Lang.AccOverview</a></li>
                    <li><a id="menuStatementHistoryMobile" class="menu-item" href="@Url.Content("~/UserPanel/Main/#StatementHistory")">@Lang.StatementHistory</a></li>
                    <li><a id="menuMyAccountMobile" class="menu-item" href="@Url.Content("~/UserPanel/Main/#MyAccount")">@Lang.MyAccount</a></li>
                    <li><a id="menuPaymentRequestMobile" class="menu-item" href="@Url.Content("~/UserPanel/Main/#PaymentRequest")">@Lang.PaymentRequest</a></li>
                    @if (!sessionService.UserSession.DisabledTransfer)
                    {
                        <li class="parent">
                            <a class="parent-item" href="javascript:;">@Lang.TransferBalanceForPlayer <i class="content-dropdown-icon"></i></a>
                            <ul class="list-unstyled sub-menu-content">
                                <li><a id="menuPlayerTransferBalanceMobile" class="menu-item" href="@Url.Content("~/UserPanel/Main/#PlayerTransferBalance")">@Lang.TransferBalanceForPlayer</a></li>

                                <li><a id="menuPlayerTransferBalanceHistoryMobile" class="menu-item" href="@Url.Content("~/UserPanel/Main/#PlayerTransferBalanceHistory")">@Lang.TransferBalanceForPlayerHistory</a></li>

                            </ul>
                        </li>
                    }
                    <li><a id="menuRevenueReportMobile" class="menu-item" href="@Url.Content("~/UserPanel/Main/#RevenueReport")">@Lang.CommissionReport</a></li>
                    <li class="parent">
                        <a class="parent-item" href="javascript:;">@Lang.Statistics <i class="content-dropdown-icon"></i></a>
                        <ul class="list-unstyled sub-menu-content">
                            <li><a id="menuReferrersStatisticsMobile" class="menu-item" href="@Url.Content("~/UserPanel/Main/#ReferrersStatistics")">@Lang.Referrals</a></li>
                            <li><a id="menuLandingPageStatisticsMobile" class="menu-item" href="@Url.Content("~/UserPanel/Main/#LandingPageStatistics")">@Lang.LandingPages</a></li>
                            <li><a id="menuMarketingPageStatisticsMobile" class="menu-item" href="@Url.Content("~/UserPanel/Main/#MarketingLinkStatistics")">@Lang.MarketLinkStatistics</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>

        <div class="main-content">
            @RenderBody()
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.RenderLink("~/www/build/js/layout-after-login.js")"></script>
    @RenderSection("scripts", required: false)
}