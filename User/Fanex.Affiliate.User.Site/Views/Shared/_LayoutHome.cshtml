@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using Fanex.Affiliate.User.Core.Utilities

@{
    var appSetting = AppSetting.Instance;
    var siteName = appSetting.SiteName;
    var gaID = "UA-93927620-4";
}

@section styles{
    @RenderSection("styles", required: false)
}
@section classHeader{page-content}

@section scripts{
    <script src="~/www/build/js/lib/jsencrypt-2.3.1.min.js"></script>
    <script>
        window.JSEncrypt || document.write('\x3Cscript src="https://cdnjs.cloudflare.com/ajax/libs/jsencrypt/2.3.1/jsencrypt.min.js">\x3C/script>')
    </script>

    @if (appSetting.Environment.Equals("UAT", StringComparison.OrdinalIgnoreCase) || appSetting.IsProduction)
    {
        <!-- Google Analytics -->
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=@(gaID)"></script>
        <script type="text/javascript">
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());

            gtag('config', '@(gaID)');
        </script>
        <!-- End Google Analytics -->
    }

    @Html.InlineScripts("~/www/build/js/pagetracking.js")

    <script type="text/javascript">
        var validationMessage = {
            enterUserName: "@Lang.ErrmsgEntryUsername",
            enterPassword: '@Lang.ErrmsgEntryPassword',
            enterValidationCode: '@Lang.ErrmsgEntryValidCode'
        }
    </script>

    @Html.InlineScripts("~/www/build/js/pages/login.js")
    @RenderSection("scripts", required: false)
}

@RazorHelper.RenderHotNews()
<div class="main">
    @RenderBody()
</div>

<div class="modal fade login-dialog" tabindex="-1" role="dialog" id="loginDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-main-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="left-login-side">
                        <img class="modal-logo" src=@(Url.Content($"~/www/build/styles/Images/themes/{siteName}.svg")) alt="logo" />
                        <h2 class="logo-text">@Lang.AffiliateProgram</h2>
                        <h3 class="title-left">@Lang.NotAffiliateMemberYet</h3>
                        <p>@string.Format(Lang.SignUpToAffiliateProgram, appSetting.MaxCommission)</p>
                        <a href="@Url.Content("~/Signup/Index")" role="button" class="btn btn-signup btn-block text-uppercase">@Lang.JoinNow!</a>
                    </div>

                    <div class="login-side" id="dialogUserInput">
                        <h2 class="modal-title">@Lang.AffiliateLogin</h2>
                        <h3 class="title-right">@Lang.WelcomeBack</h3>
                        <div class="form-group">
                            <label><span class="mdi mdi-account"></span>@Lang.Username</label>
                            <input type="text" id="dialogtxtUsername" class="form-control" placeholder="@Lang.Username" />
                        </div>
                        <div class="form-group">
                            <label><span class="mdi mdi-lock"></span>@Lang.Password</label>
                            <input type="password" id="dialogtxtPassword" class="form-control" placeholder="@Lang.Password" />
                        </div>
                        <div class="form-group">
                            <input type="text" id="dialogtxtValidation" class="form-control captcha-input" placeholder="@Lang.Validation" />
                            <div class="validation-value">
                                <img src="" alt="captcha" id="loginDialogcaptchaImg" />
                            </div>
                        </div>
                        <div class="form-group">
                            <a href="@Url.Content("~/Password/Index")" class="link-login-popup"><span class="mdi mdi-lock-open"></span> @Lang.ForgetPassword</a>
                        </div>
                        <button type="button" id="btnDialogLogin" class="btn btn-login-mobile btn-block text-uppercase">@Lang.Login</button>
                    </div>
                </div>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->