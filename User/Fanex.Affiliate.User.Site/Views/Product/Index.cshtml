@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.ProductPageViewModel
@{
    ViewBag.Title = Lang.Product;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@{
    var siteFriendlyName = Model.SiteFriendlyName;
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/products.css")
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/left-menu-panel-has-sub.js")
    @Html.InlineScripts("~/www/build/js/pages/product.js")
}

@{ Html.RenderPartial("~/Views/Product/_CarouselItems.cshtml", Model.CurrentLanguage); }

<div class="page-container">
    <div class="main-content main-content-left-panel">
        @RazorHelper.RenderParentLeftPanel(Menu.ProductMenuList)

        <div class="content product-page">
            <div class="group-title">
                <h2 class="title-block">
                    <span class="text">@Lang.Product</span>
                </h2>
            </div>
            @Html.RenderPartialByLanguage("~/Views/Product/_Content", Model.CurrentLanguage, siteFriendlyName)


            @RazorHelper.RenderMovingTopButton()
        </div>
    </div>
</div>

<div class="container-table">
    <div class="table-casino">
        @{ Html.RenderPartial("~/Views/Product/_CasinoProductTable.cshtml"); }
    </div>
</div>

<div class="page-container">
    <p class="text-block-bottom">
        @Lang.AllBettingProducts.Replace("{0}", siteFriendlyName)
    </p>
    <div class="signup-block">
        <a href="@Url.Content("~/SignUp")" class="custom-button">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M14 10.1617V14.005C13.9998 14.1805 13.93 14.3487 13.8059 14.4727C13.6818 14.5967 13.5135 14.6663 13.338 14.6663H2.66202C2.57447 14.6657 2.4879 14.6479 2.40725 14.6138C2.3266 14.5797 2.25345 14.5301 2.19197 14.4678C2.1305 14.4054 2.08191 14.3316 2.04897 14.2505C2.01604 14.1694 1.9994 14.0826 2.00002 13.995V5.99967H6.00002C6.17683 5.99967 6.3464 5.92944 6.47142 5.80441C6.59645 5.67939 6.66668 5.50982 6.66668 5.33301V1.33301H13.3347C13.702 1.33301 14 1.63634 14 1.99434V4.50434L8.00068 10.5043L7.99668 13.3297L10.8273 13.3337L14 10.1617ZM14.5187 5.87167L15.4613 6.81434L10.276 11.9997L9.33202 11.9983L9.33335 11.057L14.5187 5.87167V5.87167ZM2.00002 4.66634L5.33335 1.33501V4.66634H2.00002Z" fill="white" />
            </svg>
            @SiteFriendlyNameHelper.ReplaceB2C(Lang.SignUpAffiliateProgramNow)
        </a>
    </div>
</div>