@model string
@{
    var siteFriendlyName = Model;
}

@{ Html.RenderPartial("~/Views/Product/_CarouselItems.cshtml", "bn-BD"); }
<div class="info-group">
    <p class="text-block">
        সর্বোপরি, এই অনলাইন ক্যাসিনোটি নিরাপদ এবং সুরক্ষিত জুয়া খেলার স্থান অফার করার জন্য অত্যন্ত প্রস্তুত। প্রতিটি গেম ইন্টারফেস দৃশ্যত সন্তোষজনক নান্দনিকতা এবং অনন্য ডিজাইনের উপাদান সরবরাহ করে যা খেলোয়াড়দের মধ্যে নিমজ্জিত করে বিপ্লবী গেমপ্লে
    </p>
    <p class="text-block">
        @siteFriendlyName অ্যাফিলিয়েট প্রোগ্রামের মাধ্যমে যোগদানের জন্য সবাইকে স্বাগত জানাতে পেরে আমরা অত্যন্ত আনন্দিত। সমস্ত @siteFriendlyName পণ্য থেকে যতটা সম্ভব আয়ের ভাগ উপার্জন করুন
    </p>
</div>
<section class="info-question">
    <p class="text-bold text-uppercase title-block left-menu-title" id="Sportsbook">@Lang.SportbookProducts</p>
    <p>
        সকাল ধরণের ক্রীড়া কার্যক্রমের বিস্তৃত প্রসারণের জন্য @siteFriendlyName সারা বিশ্ব থেকে লক্ষ লক্ষ বেটিং খেলোয়াড়দের দ্বারা পছন্দ হয়েছে৷ অনুমোদিত বিজ্ঞাপনের মাধ্যমে ওয়েবসাইটে সফল নিবন্ধন করার পরে, খেলোয়াড়দের নিম্নলিখিতগুলিতে সম্পূর্ণ অ্যাক্সেস দেওয়া হয় । সকার, টেবিল টেনিস, বাস্কেটবল, গলফ, বক্সিং, ভলিবল, মোটরস্পোর্টস, আইস হকি, বেসবল, হ্যান্ডবল, ওয়াটার পোলো, রাগবি, ডার্টস, সাঁতার, স্নুকার এবং ক্রিকেট। উদাহরণস্বরূপ, বিনোদনের জন্য দুটি স্পোর্টসবুক প্ল্যাটফর্ম রয়েছে। সদস্যদের বাজি আংশিকভাবে অনুমোদিত রাজস্ব ভাগ হিসাবে গণ্য করা হয়
    </p>
    <div class="table table-responsive">
        <table class="game-list">
            <tbody>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name">
                        @Lang.Sportsbook
                    </td>
                    <td>
                        একটি খুব সুপরিচিত স্পোর্টসবুক সেরা বেটিং অডস হল স্পোর্টস বেটিং প্ল্যাটফর্মের মূল যা ইভেন্ট, বাজির ধরন এবং একাধিক অফার এবং কভারেজ এশিয়ান ভাষার পছন্দের বিস্তৃত পরিসর অফার করে। এছাড়াও, আমরা প্রতি মাসে 100টিরও বেশি সকার লিগ, ন্যূনতম 5,000 ইন-প্লে ইভেন্ট এবং 18,000 ইন-প্লে মার্কেট কভার করি। এটি স্বপ্ন দেখার মতো শীর্ষ প্ল্যাটফর্ম।
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name left-menu-title" id="VirtualSports">
                        @Lang.VirtualSports
                    </td>
                    <td>
                        ভার্চুয়াল স্পোর্টস হল সকার, ঘোড়দৌড়, গ্রেহাউন্ড, স্পিডওয়ে, মোটরস্পোর্টস, সাইক্লিং এবং টেনিসের মতো বাস্তব খেলাগুলি দ্বারা অনুপ্রাণিত ই-গেম৷ কিন্তু প্রকৃত গেমের বিপরীতে, ভার্চুয়াল স্পোর্টস শুরু হয় এবং তিন থেকে পাঁচ মিনিটের মধ্যে শেষ হয়, যা খেলোয়াড়দের তাৎক্ষণিক ম্যাচের ফলাফল দেয়
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name left-menu-title" id="NumberGame">
                        @Lang.NumberGame
                    </td>
                    <td>
                        নাম্বার গেম খেলার জন্য খুবই আকর্ষণীয়। এটি বিঙ্গো গেম থেকে অনুপ্রাণিত একটি লটারির মতো যেখানে সমস্ত খেলোয়াড়কে মেশিনে আঁকা নম্বরের উপর তাদের বাজি রাখতে হবে। সবচেয়ে বিখ্যাত জিনিস হল রিয়েল-টাইম লাইভ স্ট্রিমিংয়ে সুন্দরী মেয়েরা বল আঁকার জন্য অপেক্ষা করার সময় খেলোয়াড়দের বিনোদন দেবে।
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name left-menu-title" id="RngKeno">
                        @Lang.RngKeno
                    </td>
                    <td>
                        আরএনজি কেনো খেলা হয় 20টি বল দিয়ে এলোমেলোভাবে আঁকা হয় যার ফলে 80টি সংখ্যাযুক্ত বল (01 থেকে 80)। এই 20টি সংখ্যার সংমিশ্রণকে ভাগ করা হয়েছে এবং জেতার বিভিন্ন উপায় এবং বাজি ধরার বিভিন্ন উপায় রয়েছে যেমন বড়/ছোট, বিজোড়/ইভেন, ড্রাগন/টাইগার এবং আরও অনেক কিছু। খেলার জন্য শুধুমাত্র একটি খেলা নয়, একই সময়ে 10 টিরও বেশি মরসুম/রাজ্য খেলার জন্য। জয়ের জন্য একটি মিনিট হিসাবে সব দ্রুত-পে-আউট খেলা.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</section>
<section class="info-question">
    <p class="text-bold text-uppercase title-block left-menu-title" id="AsiaGaming">@Lang.CasinoProducts</p>
    <p>
        @siteFriendlyName-এ, ক্যাসিনো গেমগুলিকে এর সফ্টওয়্যার অনুসারে গোষ্ঠীভুক্ত করা হচ্ছে এবং সেগুলি যথাক্রমে বিভিন্ন @siteFriendlyName ক্লাবে আবদ্ধ। উদাহরণস্বরূপ, আমরা রত্নপাথর ক্যাসিনো ক্লাবগুলির প্রতিনিধিত্ব করি যেখানে শত শত লাইভ ক্যাসিনো, টেবিল গেমস, আরএনজি গেমস, স্লট গেমস ইত্যাদি। এশিয়ান সেরা ক্যাসিনো হাবগুলির জন্য সহজেই ক্যাসিনো এবং লাইভ ক্যাসিনো পৃষ্ঠাগুলিতে একত্রিত হচ্ছে।
    </p>
    <p class="text-block">আমাদের ক্যাসিনো গেমের ধরন এবং হাই-এন্ড প্ল্যাটফর্ম প্রযুক্তি যা আমরা নীচের মত অফার করি সে সম্পর্কে আরও জানুন</p>
    <div class="table table-responsive">
        <table class="game-list">
            <tbody>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name">
                        @Lang.AsiaGaming
                    </td>
                    <td>
                        এশিয়া গেমিং নিয়ে এসেছে অনেকগুলি গেমিং অভিজ্ঞতা, যেগুলির মধ্যে বিশ্বের প্রথম 'প্রি-ডিলিং 6 কার্ড', 'ভিআইপি প্রাইভেট রুম', 'স্কীজ ব্যাকারেট' এবং 'ইন্টারেক্টিভ বিড ব্যাকারেট' সহ যেগুলি শিল্পে আশ্চর্য নিয়ে আসে। এই কারণে, এশিয়া গেমিং এশিয়ায় এক অবিভ্রান্ত গেমিং সফটওয়্যার ডেভেলপারগুলির মধ্যে একটি অত্যন্ত আবিষ্কারমূলক নাম প্রাপ্ত করে।
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name left-menu-title" id="AdvantPlay">
                        @Lang.AdvantPlay
                    </td>
                    <td>
                        এডভ্যান্টপ্লে একটি নতুন গেমিং সমাধান প্রদানকারী, যার লক্ষ্য হল ক্যাসিনো এবং খেলোয়ারদের উন্নত অভিজ্ঞতা প্রদান করা। ২০২০ সালে প্রতিষ্ঠিত, এডভ্যান্টপ্লে এখানে আসতে পারবে যেই অপরিসীম খেলাধীন গেমের সাথে ইন্ডাস্ট্রি উপর প্রভাব জানাতে। যদিও ব্র্যান্ডটি এখনও তরুণ, আমরা বাজারে অগ্রণী হতে লক্ষ্য করি এবং নিজেদেরকে আরও ভাল গেম তৈরি করতে এবং আমাদের অননুসন্ধানিত শৈলী তৈরি করার মাধ্যমে নিজেদেরকে পরিকল্পনা করতে বিশ্বাস করি।
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name left-menu-title" id="AeSexy">
                        @Lang.AeSexy
                    </td>
                    <td>
                        দক্ষিণ-পূর্ব এশিয়ার নং 1 অনলাইন ক্যাসিনো প্ল্যাটফর্মের সাথে সেক্সি বিকিনি ব্যবসায়ীরা এই প্রবণতাকে এগিয়ে নিয়ে যাচ্ছে। দেরি না করে উচ্চ-মানের ভিডিও প্লেব্যাক এবং পেশাদার প্রশিক্ষণ সহ দেশ-নির্দিষ্ট মডেলগুলি একটি মনোমুগ্ধকর অভিজ্ঞতা তৈরি করে৷ চারপাশের গ্ল্যামার দিয়ে আপনার চোখকে প্রশমিত করুন এবং আপনার বাজি রাখার সময় সর্বশেষ ট্র্যাকগুলিতে যান৷
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name left-menu-title" id="Allbet">
                        @Lang.Allbet
                    </td>
                    <td>
                        অলবেট গেমিং হল এশিয়ার সবচেয়ে উদ্ভাবনী জুয়া এবং বিনোদন কর্পোরেশন। এর মধ্যে রয়েছে অগ্রণী মাল্টি প্লে ফাংশন যেখানে আপনি 12টি পর্যন্ত স্কোর কার্ড নিরীক্ষণ করতে পারেন এবং স্ক্রিনে 4, 8, 16 বা 32টি টেবিল প্রদর্শন করার বিকল্প রয়েছে, প্রথমে 6টি কার্ড বিতরণ করা, VIP টেবিলের একচেটিয়া ব্যবহার, Baccarat-এ স্কুইজ কার্ড এবং আরো অনেক বৈশিষ্ট্য
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name left-menu-title" id="AstroTech">
                        @Lang.AstroTech
                    </td>
                    <td>
                        খেলোয়াড়দের সেরা গেমিং অভিজ্ঞতা প্রদান করুন। সমস্ত গেম HTML 5-এ স্থিরভাবে রিটার্ন টু প্লেয়ার (RTP) সহ এবং ইন্টারন্যাশনাল গেমিং অর্গানাইজেশন (GLI) দ্বারা প্রত্যয়িত করা হয়েছে; AT ইলেকট্রনিক্সের সু-সমন্বিত পরিষেবা খেলোয়াড়দের একটি চমৎকার গেমিং অভিজ্ঞতা প্রদান করবে।
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name left-menu-title" id="Cq9">
                        @Lang.Cq9
                    </td>
                    <td>
                        শিল্পের শীর্ষস্থানীয় ব্র্যান্ড হয়ে ওঠার লক্ষ্য নিয়ে, CQ9 সর্বোচ্চ মানের বিভিন্ন অবসর এবং বিনোদনমূলক গেম তৈরি করে।
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold game-name left-menu-title" id="DreamGaming">
                        @Lang.DreamGaming
                    </td>
                    <td>
                        ডিজি এন্টারটেইনমেন্ট প্ল্যাটফর্মের শত শত প্রশিক্ষিত পেশাদার ডিলার, একটি বাস্তব ক্যাসিনো পরিবেশ, স্থিতিশীল উচ্চ-সম্পদ সরঞ্জাম এবং পেশাদার প্রযুক্তিগত সহায়তা রয়েছে, যা প্ল্যাটফর্মের স্থিতিশীল অপারেশন নিশ্চিত করে এবং খেলোয়াড়দের একটি চমৎকার অভিজ্ঞতা দেয় যেন তারা দৃশ্যে আছে। এবং মাল্টি-প্ল্যাটফর্ম অ্যাক্সেস সমর্থন করে, খেলোয়াড়রা বর্তমানে যেখানেই থাকুক না কেন, তারা যে কোনো সময় গেমের মজা উপভোগ করতে পারে।
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name left-menu-title" id="Ebet">
                        @Lang.Ebet
