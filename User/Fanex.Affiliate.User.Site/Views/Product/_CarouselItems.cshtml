@model string
@{
    var filePath = Url.Content($"~/www/build/styles/Images/products");
    var desktop = $"{filePath}/product.desktop.{Model}.jpg";
    var mobile = $"{filePath}/product.mobile.{Model}.jpg";
}

<picture>
    <source media="(max-width:767px)" srcset="@(mobile + "?v=191310v01")" type="image/jpeg" />
    <source srcset="@(desktop + "?v=191310v01")" type="image/jpeg" />
    <img class="img-item img-responsive" src="@(desktop + "?v=191310v01")" alt="Product Banner" />
</picture>