@model string
@{
    var siteFriendlyName = Model;
}
@*<div class="adv text-center">
        <img src="~/www/build/styles/Images/products/upper-banner.th-TH.jpg?v=158572" alt="upper product banner" />
    </div>*@
@{ Html.RenderPartial("~/Views/Product/_CarouselItems.cshtml", "th-TH"); }
<div class="info-group">
    <p class="text-block">
        สิ่งที่สำคัญที่สุดคาสิโนออนไลน์นี้มุ่งเน้นอย่างมากที่จะเสนอสถานที่เล่นการพนันที่ปลอดภัย เกมส์แต่ละเกมส์ถูกออกแบบให้ความสวยงามเป็นที่น่าพึงพอใจและองค์ประกอบการออกแบบที่ไม่เหมือนใคร เพื่อให้ผู้เล่นได้ดื่มดำไปกับเกมส์
    </p>
    <p class="text-block">
        ายินดีเป็นอย่างยิ่งที่ได้ต้อนรับทุกท่านเข้าร่วมโปรแกรมพันธมิตร @(siteFriendlyName) เพื่อสร้างรายได้คอมมิชชั่นของคุณให้มากที่สุดจากผลิตภัณฑ์ @(siteFriendlyName) ทั้งหมด
    </p>
</div>
<section class="info-group">
    <p class="text-bold text-uppercase title-block left-menu-title" id="Sportsbook">@Lang.SportbookProducts</p>
    <p>
        @siteFriendlyName ได้รับการสนับสนุนจากผู้เล่นการพนันนับล้านจากทั่วทุกมุมโลกเนื่องจากความครอบคลุมที่หลากหลายของกีฬาทุกประเภท เมื่อลงทะเบียนสำเร็จบนเว็บไซต์ผ่านการโฆษณาของพันธมิตร
        ผู้เล่นจะเข้าถึงเข้ากีฬาต่อไปนี้แบบเต็มรูปแบบ: ฟุตบอล, ปิงปอง, บาสเก็ตบอล,กอล์ฟ, มวย, วอลเลย์บอล, มอเตอร์สปอร์ต, ฮ็อกกี้น้ำแข็ง,เบสบอล, แฮนด์บอล, โปโลน้ำ ,รักบี้, กีฬาปาลูกดอก,
        ว่ายน้ำ, สนุ๊กเกอร์และคริกเก็ตเป็นต้น ยอดการวางเดิมพันของสมาชิกในพันธมิตรของคุณคือค่าคอมมิชชั่นรายเดือนที่คุณจะได้รับ
    </p>
    <div class="table table-responsive">
        <table class="game-list">
            <tbody>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name">
                        @Lang.Sportsbook
                    </td>
                    <td>
                        หน้ากีฬา YashBet เป็นแพลตฟอร์มหน้าเดิมพันกีฬาที่เสนอค่าน้ำที่ดีที่สุดในตลาด พร้อมทั้งรูปแบบการเดิมพันที่หลากหลาย ครอบคลุมทุกแมตซ์ ทุกลีกฟุตบอลกว่า 100 ลีก ทุกรายการการแข่งขัน กว่า 5,000 รายการ รองรับทุกภาษาทั่วทั้งเอเชีย จึงถือได้ว่าหน้ากีฬา YashBetนั้นเป็นแพลตฟอร์มการเดิมพันหน้ากีฬาที่ดีที่สุดในเอเชีย
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name left-menu-title" id="VirtualSports">
                        @Lang.VirtualSports
                    </td>
                    <td>
                        เกมกีฬาจำลอง เป็นเกมอิเล็กทรอนิกส์ที่ได้แรงบันดาลใจจากกีฬาจริง เช่น ฟุตบอล, วิ่งแข่งม้า, วิ่งแข่งหมาเกรย์ฮาวด์, กีฬาแข่งรถ, มอเตอร์สปอร์ต, จักรยานทางเร็ว และเทนนิส เป็นต้น แต่เกมนี้มีข้อแตกต่างจากกีฬาที่แข่งจริงๆ ซึ่งจะเริ่มต้นการแข่งและจบลงในอีก 3-5 นาทีพร้อมภาพวีดิโอช่วงสำคัญของแต่ละเกมซึ่งจะทำให้ผู้เล่นสามารถทราบผลการแข่งขันได้ทันที
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name left-menu-title" id="NumberGame">
                        @Lang.NumberGame
                    </td>
                    <td>
                        เกมส์หมายเลข เป็นเกมที่น่าเล่นมากและเป็นที่ดึงดูดผู้เล่น ด้วยสไตล์เกมส์จะเหมือนกับการจับสลากล็อตเตอร์รี่ที่ได้รับแรงบันดาลใจจากเกมบิงโก โดยผู้เล่นทุกคนต้องวางเดิมพันบนหมายเลขซึ่งจะมีลูกบอลที่หมุนอยู่ในเครื่องสุ่มออกรางวัล สิ่งที่สร้างความตื่นเต้นที่สุดในเกมส์นี้คือสาวสวยที่จับฉลากลูกบอลหมายเลขรางวัลในจอถ่ายทอดสดแบบเรียลไทม์จะเต้นโชว์สร้างความเพลิดเพลินให้กับผู้เล่นขณะรอลูกบอลออกรางวัล
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name left-menu-title" id="RngKeno">
                        @Lang.RngKeno
                    </td>
                    <td>
                        RNG Keno เล่นโดยสุ่ม 20 ลูกจาก 80 หมายเลข (01 ถึง 80) โดยเป็นการรวมกันของตัวเลขที่สุ่ม 20 ลูก โดยมีหลายวิธีที่จะชนะและวิธีการเดิมพันหลายประเภทเช่น สามารถแทงสูง -ต่ำ ใหญ่ แทงคี่ - คู่, แทงมังกร-เสือ และอื่น ๆ อีกหลายวิธี อีกทั้งคีโนนี้จะมีหลายโซนฤดูและโซนประเทศให้เลือกเดิมพัน และยังเป็นเกมส์ที่รู้ผลชนะรวดเร็วในช่วงอึดใจเพียงหนึ่งนาทีเท่านั้น
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    @*<div class="adv text-center">
            <img src="~/www/build/styles/Images/products/lower-banner.th-TH.jpg?v=158572" alt="lower product banner" />
        </div>*@
</section>
<section class="info-group">
