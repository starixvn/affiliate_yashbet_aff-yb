@model string
@{
    var siteFriendlyName = Model;
}

<div class="info-group">
    <p class="text-block">
        इन सबसे ऊपर, यह ऑनलाइन कैसीनो सुरक्षित और सुरक्षित जुआ स्थल की पेशकश करने के लिए अत्यधिक तैयार है। प्रत्येक गेम इंटरफ़ेस नेत्रहीन संतोषजनक सौंदर्यशास्त्र और अद्वितीय डिज़ाइन तत्व प्रदान करता है जो खिलाड़ियों को क्रांतिकारी गेमप्ले में डुबो देता है।
    </p>
    <p class="text-block">
        हमें @siteFriendlyName एफिलिएट प्रोग्राम के माध्यम से शामिल होने के लिए सभी का स्वागत करते हुए बहुत खुशी हो रही है। सभी @siteFriendlyName उत्पादों से अधिक से अधिक रेवनू शेयर अर्जित करें।
    </p>
</div>
<section class="info-question">
    <div class="title left-menu-title" id="Sportsbook">
        <span class="text">@Lang.SportbookProducts</span>
        <span class="button-toggle"></span>
    </div>
    <div class="body-result">
        <p>
            @siteFriendlyName को दुनिया भर के लाखों सट्टेबाजी खिलाड़ियों द्वारा पसंद किया जाता है क्योंकि इसकी सभी खेल गतिविधियों के लिए व्यापक विविधता कवरेज है। संबद्ध विज्ञापन के माध्यम से वेबसाइट
            पर सफल पंजीकरण पर, खिलाड़ियों को निम्नलिखित तक पूर्ण पहुंच प्रदान की जाती है: सॉकर, टेबल टेनिस, बास्केटबॉल, गोल्फ, बॉक्सिंग, वॉलीबॉल, मोटरस्पोर्ट्स, आइस हॉकी, बेसबॉल, हैंडबॉल,
            वाटर पोलो, रग्बी, डार्ट्स, तैराकी, स्नूकर और क्रिकेट। उदाहरण के लिए, मनोरंजन को पूरा करने के लिए दो [2] स्पोर्ट्सबुक प्लेटफॉर्म हैं। सदस्यों के दांव को आंशिक रूप से संबद्ध राजस्व
            हिस्सेदारी के रूप में माना जाता है।
        </p>
        <div class="table table-responsive table-game">
            <table class="game-list">
                <tbody>
                    <tr>
                        <td class="text-center text-bold text-uppercase game-name">
                            @Lang.Sportsbook
                        </td>
                        <td>
                            बाजार में एक बहुत ही प्रसिद्ध स्पोर्ट्सबुक बेस्ट बेटिंग ऑड्स स्पोर्ट्स बेटिंग प्लेटफॉर्म का मूल है जो इवेंट्स की एक विस्तृत श्रृंखला, बेट प्रकार, और कई ऑड्स प्रसाद और कवरेज एशियाई भाषाओं की प्राथमिकता प्रदान करता है। इसके अलावा, हम प्रति माह 100 से अधिक सॉकर लीग, न्यूनतम 5,000 इन-प्ले इवेंट और 18,000 इन-प्ले मार्केट को कवर करते हैं। यह शीर्ष मंच है जिसके लिए आपका ग्राहक सपना देख रहा है।
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center text-bold text-uppercase game-name left-menu-title" id="VirtualSports">
                            @Lang.VirtualSports
                        </td>
                        <td>
                            वर्चुअल स्पोर्ट्स फुटबॉल, हॉर्स रेसिंग, ग्रेहाउंड, स्पीडवे, मोटरस्पोर्ट्स, साइकिलिंग और टेनिस जैसे वास्तविक खेलों से प्रेरित ई-गेम हैं। लेकिन वास्तविक खेलों के विपरीत, वर्चुअल स्पोर्ट्स तीन से पांच मिनट में शुरू और समाप्त होता है, जो खिलाड़ियों को तत्काल मैच के परिणाम देता है।
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center text-bold text-uppercase game-name left-menu-title" id="NumberGame">
                            @Lang.NumberGame
                        </td>
                        <td>
                            नंबर गेम खेलने के लिए बहुत ही आकर्षक है। यह बिंगो गेम से प्रेरित लॉटरी की तरह है जहां सभी खिलाड़ियों को मशीन में खींची गई संख्या पर अपना दांव लगाना होता है। सबसे प्रसिद्ध बात यह है कि रीयल-टाइम लाइव स्ट्रीमिंग में सुंदर लड़कियां खिलाड़ियों का मनोरंजन करती हैं, जबकि गेंदें खींची जाती हैं।
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center text-bold text-uppercase game-name left-menu-title" id="RngKeno">
                            @Lang.RngKeno
                        </td>
                        <td>
                            आरएनजी केनो को 20 गेंदों के साथ खेला जाता है, जो 80 नंबर वाली गेंदों (01 से 80) ​​के परिणामस्वरूप यादृच्छिक रूप से खींची जाती हैं। इन 20 नंबरों के संयोजन को विभाजित किया गया है और जीतने के कई तरीके हैं और सट्टेबाजी के कई तरीके हैं जैसे कि बिग/स्मॉल, ऑड/ईवन, ड्रैगन/टाइगर, और बहुत कुछ। खेलने के लिए न केवल एक खेल बल्कि एक ही समय में खेलने के लिए 10 से अधिक सीज़न / राज्य। जीतने के लिए एक मिनट के रूप में सभी फास्ट-पेआउट गेम हैं।
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>
<section class="info-question">
    <div class="title left-menu-title" id="AsiaGaming">
        <span class="text">@Lang.CasinoProducts</span>
        <span class="button-toggle"></span>
    </div>
    <div class="body-result">
        <p>
            @siteFriendlyName पर, कैसीनो गेम्स को इसके सॉफ्टवेयर के अनुसार समूहीकृत किया जा रहा है और वे सभी क्रमशः अलग-अलग @siteFriendlyName Casino. क्लबों में संलग्न हैं। उदाहरण के लिए, हम रत्न कैसीनो क्लबों
            का प्रतिनिधित्व करते हैं जिनमें सैकड़ों लाइव कैसीनो, टेबल गेम, आरएनजी गेम, स्लॉट गेम इत्यादि को एशियाई सर्वश्रेष्ठ कैसीनो केंद्रों के लिए कैसीनो और लाइव कैसीनो पृष्ठों में आसानी से इकट्ठा किया जा रहा है।
        </p>
        <p class="text-block">हमारे कैसीनो गेम प्रकारों और हमारे द्वारा प्रदान की जाने वाली उच्च-स्तरीय प्लेटफ़ॉर्म तकनीक के बारे में अधिक जानें।</p>
        <div class="table table-responsive table-game">
            <table class="game-list">
                <tbody>
                    <tr>
                        <td class="text-center text-bold text-uppercase game-name">
                            @Lang.AsiaGaming
                        </td>
                        <td>
                            एशिया गेमिंग ने दुनिया के पहले 'प्री-डीलिंग 6 कार्ड्स', 'वीआईपी प्राइवेट रूम', 'स्क्वीज़ बैकरेट' और 'इंटरएक्टिव बिड बैकरेट' सहित कई गेमिंग अनुभव बनाए हैं, जो उद्योग के लिए आश्चर्य लाते हैं। इसलिए, एशिया गेमिंग एशिया में सबसे नवीन गेमिंग सॉफ्टवेयर डेवलपर्स में से एक बन गया है।
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center text-bold text-uppercase game-name left-menu-title" id="AdvantPlay">
                            @Lang.AdvantPlay
                        </td>
                        <td>
                            एडवेंटप्ले एक नया गेमिंग समाधान प्रदाता है जिसका लक्ष्य कैसीनो और खिलाड़ियों को प्रीमियम अनुभव देना है। 2020 में स्थापित, AdvantPlay हमारे आगामी खेलों के साथ उद्योग में अपनी छाप छोड़ने के लिए और इंतजार नहीं कर सकता। हालांकि ब्रांड अभी भी युवा है, हमारा लक्ष्य बाजार में अग्रणी बनना है और बेहतर गेम और अपनी अनूठी शैली बनाने के लिए खुद को चुनौती देने में विश्वास करते हैं।
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center text-bold text-uppercase game-name left-menu-title" id="AeSexy">
                            @Lang.AeSexy
                        </td>
                        <td>
                            दक्षिण पूर्व एशिया में नंबर 1 ऑनलाइन कैसीनो प्लेटफॉर्म जिसमें सेक्सी बिकनी डीलरों का चलन है। बिना देर किए उच्च गुणवत्ता वाले वीडियो प्लेबैक और पेशेवर प्रशिक्षण के साथ देश-विशिष्ट मॉडल पेश करना एक आकर्षक अनुभव बनाता है। जब आप अपना दांव लगाते हैं तो अपनी आंखों को चारों ओर के ग्लैमर से शांत करें और नवीनतम ट्रैक पर ध्यान दें।
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center text-bold text-uppercase game-name left-menu-title" id="Allbet">
                            @Lang.Allbet
                        </td>
                        <td>
                            Allbet गेमिंग एशिया का सबसे नवीन जुआ और मनोरंजन निगम है। इनमें अग्रणी मल्टी प्ले फंक्शन शामिल है जहां आप 12 स्कोर कार्ड तक की निगरानी कर सकते हैं और स्क्रीन पर
                            4, 8, 16 या 32 टेबल प्रदर्शित करने का विकल्प है, पहले 6 कार्ड का वितरण, वीआईपी टेबल का विशेष उपयोग, बैकरेट में कार्ड निचोड़ें और भी कई विशेषताएं।
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center text-bold text-uppercase game-name left-menu-title" id="AstroTech">
                            @Lang.AstroTech
                        </td>
                        <td>
                            एक समृद्ध और अभिनव एशियाई शैली के साथ, यह 30 से अधिक क्लासिक स्लॉट मशीन, अप्रत्याशित स्तरों वाली मछली मशीनें और उद्योग का पहला फाइटिंग टॉवर गेम प्रस्तुत करता है, जो निश्चित रूप से आपको हर गेम विवरण में नवाचार और परिवर्तन के लिए एटी इलेक्ट्रॉनिक्स की साहसिक महत्वाकांक्षाओं को देखने देगा। . ; यह सुनिश्चित करने के लिए कि सभी खिलाड़ी सबसे उत्तम खेल अनुभव का आनंद ले सकें, हम सबसे सुरक्षित और निष्पक्ष खेल यांत्रिकी और पेशेवर और उच्च गुणवत्ता वाली सेवा वस्तुएं भी प्रदान करते हैं, ताकि आप बहुत अधिक मारने से न डरें!
