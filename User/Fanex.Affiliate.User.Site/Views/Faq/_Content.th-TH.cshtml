@model string
@{
    var siteFriendlyName = Model;
}

<section class="info-group" id="General">
    <div class="title">
        <span class="text">คำถามเรื่องทั่วไป</span>
    </div>
    <div class="faq-group">
        <p class="question">โปรแกรมพันธมิตร @(siteFriendlyName)คืออะไร ?</p>
        <p class="answer">โปรแกรมพันธมิตร @(siteFriendlyName)คือโปรแกรมการเป็นหุ้นส่วนที่ซึ่งคุณจะได้รับคอมมิชชั่นจากยอดเงินของคนที่คุณแนะนำเข้ามาเป็นสมาชิกและเล่นกับ @(siteFriendlyName) ผ่านทางเว็บไซต์ของคุณหรือทางอื่นอื่น</p>
    </div>
    <div class="faq-group">
        <p class="question">ฉันจะสมัครเข้ามาในโปรแกรมพันธมิตร@(siteFriendlyName)ได้อย่างไร ?</p>
        <p class="answer">
            การเป็นพันธมิตรกับ @(siteFriendlyName) สมัครฟรีไม่เสียค่าใช้จ่าย เพียงแค่คุณกรอกแบบฟอร์มการสมัคร คุณจะได้รับการติดต่อกลับภายในเวลา 3 วันทำการเกี่ยวกับการเป็นสมาชิก ถ้าใบสมัครของคุณได้รับการอนุมัติ คุณจะได้รับอีเมลล์แจ้งระบุ ไอดีในการเป็นพันธมิตร และรหัสในการใช้แบนเนอร์ ลิ้งค์ที่เป็นข้อความและรายละเอียดอื่นในการทำการตลาด เพื่อที่จะนำไปวางในตัวเว็บไซต์ของคุณ
        </p>
    </div>
    <div class="faq-group">
        <p class="question">แล้วถ้าฉันไม่มีเว็บไซต์ ฉันจะสามารถเข้าร่วมโปรแกรมนี้ได้หรือไม่ ?</p>
        <p class="answer">ได้ค่ะ เพียงคุณมั่นใจว่า คุณมีเครือข่ายเพื่อน/คนรู้จักมากมาย เรามีฟังก์ชั่นการสร้างเวบส่วนตัวบริการคุณ คุณเพียงออกไอเดีย เขียนข้อความแนะนำกีฬาและประชาสัมพันธ์เราเท่านั้น แล้วส่งเวบลิ้งค์พันธมิตรนี้ไปให้เพื่อน/เครือข่ายของคุณ เมื่อเค้าเหล่านั้นสมัครผ่านลิ้งพันธมิตรในเวบส่วนตัวคุณและเดิมพันกับเรา คุณก็จะได้รับค่าคอมงามๆจากเรา ! ติดต่อเราที่แผนกลูกค้าสัมพันธ์  เพื่อรับข้อมูลเพิ่มเติมวันนี้สิคะ</p>
    </div>
</section>

<section class="info-group" id="MarketingAndTracking">
    <div class="title">
        <span class="text">การตลาดและการตรวจสอบ</span>
    </div>
    <div class="faq-group">
        <p class="question">ฉันจะได้รับแบนเนอร์และข้อความจากที่ไหน ?</p>
        <p class="answer">เพียงแค่คุณเข้าไปในเมนูสื่อโฆษณาที่เราเก็บแบนเนอร์ไว้คุณก็จะสามารถเลือกแบนเนอร์ที่คุณชอบเช่นเดียวกับลิ้งค์ข้อความเพื่อใช้กับตัวเว็บไซต์ของคุณ</p>
    </div>
    <div class="faq-group">
        <p class="question">ระบบจะสามารถตรวจสอบลูกค้าที่ฉันแนะนำได้อย่างไร ?</p>
        <p class="answer">เราได้ว่าจ้างให้ ระบบ state-of-the-art technology เพื่อใช้ตรวจเช็คข้อมูลและมั่นใจได้ 100% ในการที่คุณแนะนำลูกค้าให้เป็นสมาชิกกับ @(siteFriendlyName) การที่พันธมิตรได้แนะนำลูกค้าให้เราโดยใช้ URL ซึ่งเราได้จัดเตรียมไว้ในเมนูสื่อโฆษณา ผ่านทางการใช้ระบบ คุ๊กกี้ ผู้ที่เข้าชมเว็บไซต์ที่คลิ๊กผ่าน URL พันธมิตร ( แบนเนอร์ ลิ้งค์ข้อความ อีเมลล์ อื่นๆ ) จะได้รับการบันทึกและเครดิตเข้าสู่บัญชีพันธมิตรของท่านโดยอัตโนมัติในทุกคนที่คุณแนะนำ</p>
    </div>
    <div class="faq-group">
        <p class="question">คุณจะสามารถตรวจสอบและให้เครดิตในบัญชีพันธมิตรของฉันได้หรือไม่ถ้าลูกค้าที่คลิ๊กลิ้งค์แล้วไม่สมัครในครั้งแรกแต่ได้กลับมาสมัครสมาชิกหลังจากนั้นกับทาง  @(siteFriendlyName)?</p>
        <p class="answer">ใช่, เราสามารถที่จะตรวจสอบผู้คลิ๊กลิ้งค์พันธมิตรจากเว็บไซต์ของท่านและไม่ได้สมัครสมาชิกในทันทีแต่ได้กลับมาสมัครกับทาง @(siteFriendlyName) หลังจากนั้นระบบเราจะนับให้ภายใน 90 วันหลังจากที่ผู้ที่คลิ๊กลิ้งค์พันธมิตรผ่านทางเว็บไซต์ของท่าน เทคโนโลยีที่ใช้บริหารนี้อ้างอิงจากตัวคุ๊กกี้โปรแกรม</p>
    </div>
    <div class="faq-group">
        <p class="question">คุ๊กกี้คืออะไร ?</p>
        <p class="answer">คุ๊กกี้คือระบบทั่วไปที่ใช้ตรวจสอบการเชื่อมต่อในเรื่องของเซิฟเวอร์ สามารถใช้ในการเก็บข้อมูลและตรวจสอบข้อมูลในเกี่ยวกับการเชื่อมต่อในส่วนของลูกค้า ยิ่งไปกว่านั้นยังมีข้อมูลเล็กเล็กที่ถูกวางไว้ในระบบตัวเก็บข้อมูลจากผู้ที่คลื๊กหรือเยี่ยมชม @(siteFriendlyName) ผ่านทางเว็บไซต์ของท่าน ข้อมูลตัวนี้จะรวบเก็บข้อมูลเกี่ยวกับ @(siteFriendlyName) ที่จะใช้ตรวจสอบและเครดิตในบัญชีพันธมิตรได้อย่างถูกต้องในทุกผู้เข้าชมเว็บไซต์ การตรวจสอบสามารถทำได้โดยคุ๊กกี้ทั้งนี้จะไม่ได้ถูกกำหนดขอบเขต เกี่ยวกับ จำนวนหน้าของผู้เข้าชมเช่นเดียวกับวันที่และเวลาในขณะที่เปิดหน้าเว็บดังกล่าวนั้น        </p>
    </div>
    <div class="faq-group">
        <p class="question">หากมีพันธมิตรสองท่านแนะนำสมาชิกยูสเซอร์เดียวกัน คุณจะตอบแทนรายได้ให้กับพันธมิตรคนแรกหรือคนล่าสุด?</p>
        <p class="answer">คุ๊กกี้ถูกเขียนขึ้นเพื่อให้พันธมิตรได้รับประโยชน์จากผู้ที่เข้าชมและคลิ๊กพันธมิตรครั้งสุดท้ายที่ลูกค้าได้ถูกแนะนำผ่านทางเว็บไซต์ของคุณ</p>
    </div>
    <div class="faq-group">
        <p class="question">ฉันจะสามารถตรวจสอบได้หรือไม่ว่าฉันได้รับรายได้เท่าไหร่ ?</p>
        <p class="answer">คุณสามารถล๊อคอินเข้าในบัญชี @(siteFriendlyName) เพื่อตรวจสอบยอดรายได้คอมมิชชั่นของคุณออนไลน์ได้ทันทีซึ่งสามารถเช็คได้ตลอด24 ชั่วโมงทุกวัน</p>
    </div>
    <div class="faq-group">
        <p class="question">คุณมีนโยบายอย่างไรในการกำจัดการสแปมทางอีเมล์ ?</p>
        <p class="answer">เราจะไม่ยอมรับการแสปมใดๆที่ถูกส่งมาจากบัญชีของพันธมิตร ถ้าหากว่ามีการส่งแสปมมาจากอีเมลล์ของพันธมิตร เราจะมีจดหมายไปเตือนในกรณีที่ไม่ร้ายแรงนัก แต่หากว่ายังไม่หยุดส่งมาอีก เราจะทำการหยุดการใช้งานบัญชีพันธมิตรดังกล่าวโดยทันทีจากโปรแกรมพันธมิตร @(siteFriendlyName)</p>
    </div>
</section>

<section class="info-group" id="RevenueSharePayment">
    <div class="title">
        <span class="text">การได้รับเงิน</span>
    </div>
    <div class="faq-group">
        <p class="question">ฉันจะถอนเงินวิธีไหนได้บ้าง</p>
        <p class="answer">คุณสามารถแจ้งถอนโดย ถอนเงินไปยังบัญชีเล่นของคุณในเว็บไซต์ @(siteFriendlyName). หากคำขอถอนเงินของท่านได้รับการอนุมัติ ยอดเงินจะถูกโอนไปยังบัญชีเดิมพัน @(siteFriendlyName) ของท่านโดยอัตโนมัติ.</p>
        <p class="answer">โปรดทราบ: ชื่อที่ลงทะเบียนบัญชีเดิมพัน @(siteFriendlyName) ของท่านต้องเป็นชื่อลงทะเบียนเดียวกับที่ท่านได้ลงทะเบียนไว้ในบัญชีพันธมิตรของท่านและต้องเป็นชื่อจริงของท่าน.</p>
    </div>
    <div class="faq-group">
        <p class="question">จำนวนเงินต่ำสุดที่ฉันสามารถขอถอนได้คือเท่าไหร่ ?</p>
        <p class="answer">ขั้นต่ำในการแจ้งถอนเงิน คือ USD 100.</p>
    </div>
    <div class="faq-group">
        <p class="question">ยอดติดลบ สามารถยกยอดไปได้ไหม?</p>
        <p class="answer">ได้ค่ะ เรายกยอดติดลบไปยังเดือนถัดไปในทุกสิ้นเดือน จนว่าจะมียอดรายได้ในเดือนใหม่ขึ้นมาหักลบให้ยอดนั้นๆ กลายเป็นยอดบวกให้คุณ</p>
    </div>
    <div class="faq-group">
        <p class="question">ฉันจะขอถอนเงินได้บ่อยแค่ไหน ?</p>
        <p class="answer">แจ้งถอนเงินได้มากสุด 1 ครั้งต่อเดือน หากสมาชิกมีความต้องการถอนครั้งที่สอง คำร้องนั้นจะขึ้นอยู่กับความเห็นชอบของ ผู้จัดการฝ่ายพันธมิตร ขณะเดียวกันการแจ้งถอนกับเราไม่มีค่าบริการใดๆ เว้นเสียแต่ หน่วยงานกลางส่งเงินที่เกี่ยวข้อง หรือตัวแทนบริการด้านส่งเงินออนไลน์จะทำการเรียกเก็บค่าบริการจากคุณเป็นกรณีไป</p>
    </div>
</section>