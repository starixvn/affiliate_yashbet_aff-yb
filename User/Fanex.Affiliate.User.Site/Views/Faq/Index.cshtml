@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.BaseLayoutViewModel

@{
    ViewBag.Title = Lang.Faqs;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@{
    var htmlString = Html.RenderPartialByLanguage("~/Views/Faq/_Content", Model.CurrentLanguage, Model.SiteFriendlyName).ToHtmlString();
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/faq.css")
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/left-menu-panel.js")
}

<div class="main-content main-content-left-panel">
    @RazorHelper.RenderLeftPanel(Menu.FaqMenuList)
    <div class="content">
        <div class="page-title">
            <span class="text">@Lang.Faqs</span>
        </div>

        @Html.Raw(htmlString)

        @RazorHelper.RenderMovingTopButton()
    </div>
</div>