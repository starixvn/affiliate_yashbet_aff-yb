@{
    ViewBag.Title = Lang.ForgetPassword;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@section styles {
    <link rel="stylesheet" href="@Url.RenderLink("~/www/build/styles/css/password.css")" />
}
@section scripts{
    <script src="@Url.RenderLink("~/www/build/js/validation.js")"></script>
    <script src="@Url.RenderLink("~/www/build/js/forgotpassword.js")"></script>
}

<div class="page-container">
    <div class="main-content">
        <div class="group-title">
            <h2 class="title-block">
                <span class="text">@Lang.ForgetPassword</span>
            </h2>
        </div>
        <div class="alert" role="alert" id="messageResult" style="display: none"></div>
        <div id="mainContent">
            <p class="forget-content">@Html.Raw(Lang.TitelForgetPass.Replace("{0}", Url.Content("~/ContactUs")))</p>
            <form id="forgotPasswordForm" class="form-horizontal form-valid form-valid-pasword">
                @Html.AntiForgeryToken()

                <div id="emailInputGroup">
                    <div class="group-form group-input-label">
                        <label for="email">@Lang.YourEmail <span class="red-start">*</span></label>
                        <input class="form-control" name="Email" id="Email" type="text" autocomplete="off" />
                    </div>
                    <p class="validation-input">
                        <span class="help-block hide">@Lang.EmailAddressIsInvalid</span>
                    </p>
                    <div class="group-form group-button">
                        <button id="btnSubmit" class="btn btn-submit" type="submit">@Lang.Submit</button>
                        <button id="btnReset" class="btn btn-reset" type="reset">@Lang.Reset</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
