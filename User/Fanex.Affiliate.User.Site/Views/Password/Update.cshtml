@{
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}
@model Fanex.Affiliate.User.Core.MetalModels.UpdatePasswordParam

@section scripts{
    <script src="~/www/build/js/lib/jsencrypt-2.3.1.min.js"></script>
    <script>
        window.JSEncrypt || document.write('\x3Cscript src="https://cdnjs.cloudflare.com/ajax/libs/jsencrypt/2.3.1/jsencrypt.min.js">\x3C/script>')
    </script>

    <script type="text/javascript">
        var resource = {
            notMatchPassword: '@Lang.ReenterNewPassw'
        }
    </script>

    <script src="@Url.RenderLink("~/www/build/js/validation.js")"></script>
    @Html.InlineScripts("~/www/build/js/pages/changepassword.js")
}
@section styles{
    @Html.InlineStyles("~/www/build/styles/css/update-password.css")
}
<div class="wraper-block" style="max-width: 1200px;">
    <div class="group-title">
        <h2 class="title-block">
            <span class="text">@Lang.ChangePass</span>
        </h2>
    </div>
    <div>
        <p>@Lang.ChangePassText</p>
        <div class="alert" role="alert" id="messageResult" style="display: none"></div>

        <form id="updatePasswordForm" class="form">
            @Html.AntiForgeryToken()
            <div class="form-group form-columns form-columns-2">
                <div class="items validate-group">
                    <label for="OldPassword" class="custom-label require">@Lang.OldPass</label>
                    @Html.PasswordFor(p => p.OldPassword, new { @class = "form-input", @autocomplete = "off" })
                    @Html.ValidationMessageFor(p => p.OldPassword, string.Empty, new { @class = "validate-input hide" })
                </div>
            </div>
            <div class="form-group form-columns form-columns-2">
                <div class="items validate-group">
                    <label for="NewPassword" class="custom-label require">@Lang.NewPass</label>
                    <input autocomplete="off" class="form-input"
                           data-val="true"
                           data-val-regex="@Lang.PassCheck" data-val-regex-pattern="^(?=.*\d+.*\d+)(?=.*[a-zA-Z].*[a-zA-Z]).{6,}$"
                           data-val-required="@Lang.NewPasswordisre" id="NewPassword" name="NewPassword" type="password" />
                    @Html.ValidationMessageFor(p => p.NewPassword, string.Empty, new { @class = "validate-input hide" })
                </div>
            </div>
            <div class="form-group form-columns form-columns-2">
                <div class="items validate-group">
                    <label for="ConfirmNewPassword" class="custom-label require">@Lang.RePass</label>
                    @Html.PasswordFor(p => p.ConfirmNewPassword, new { @class = "form-input", @autocomplete = "off" })
                    @Html.ValidationMessageFor(p => p.ConfirmNewPassword, string.Empty, new { @class = "validate-input hide" })
                </div>
            </div>

            <div class="group-button">
                <button class="custom-button custom-button-cancel" id="btnCancel" type="button">@Lang.Cancel</button>
                <button class="custom-button custom-button-dash" id="btnSubmit" type="submit">@Lang.Submit</button>
            </div>
        </form>

        @if (ViewBag.PublicKey != null)
        {
            @Html.Hidden("PublicKey", ViewBag.PublicKey as string)
        }
    </div>
</div>