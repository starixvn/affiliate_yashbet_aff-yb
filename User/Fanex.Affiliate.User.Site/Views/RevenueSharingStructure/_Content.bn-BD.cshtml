@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

<section class="info-question" id="WhatWeHave">
    <div class="title left-menu-title">
        <span class="text">@Lang.WhatWeHave</span>
        <span class="button-toggle"></span>
    </div>
    <div class="body-result">
        <ul>
            <li class="text">
                শীর্ষস্থানীয় গেমিং এবং অনলাইন বেটিং পণ্য যেমন খেলাধূলা,, লাইভ ক্যাসিনো, ভার্চুয়াল স্পোর্টস, কেনো, স্লট গেমস এবং সকাল ধরনের খেলাধূলা
            </li>
            <li class="text">
                5টির বেশি ভাষা সহ বিখ্যাত ব্র্যান্ড যাতে সদস্যদের আকৃষ্ট করা আপনার পক্ষে সহজ হয়
            </li>
            <li class="text">
                কৌশলগত বিপণন সরঞ্জাম উচ্চ সদস্য রূপান্তর এবং ধরে রাখার হার নিশ্চিত করে
            </li>
        </ul>
    </div>
</section>
<section class="info-question" id="WhatWeOffer">
    <div class="title left-menu-title">
        <span class="text">@Lang.WhatWeOffer</span>
        <span class="button-toggle"></span>
    </div>
    <div class="body-result">
        <ul>
            <li class="text">
                সর্বোচ্চ @Model.MaxCommission রাজস্ব শেয়ার
            </li>
            <li class="text">
                10% আরও যোগ করতে আপনার সাব-অ্যাফিলিয়েট হিসাবে আমাদের অ্যাফিলিয়েট প্রোগ্রামে যোগ দিতে এবং আপনার পুরষ্কার পেতে বন্ধুদের নিয়োগ করুন!
            </li>
            <li class="text">
                আপনার কর্মক্ষমতা ট্র্যাকিং জন্য কার্যকর এবং সহজে ব্যবহার ব্যবস্থাপনা সিস্টেম
            </li>
            <li class="text">
                বন্ধুত্বপূর্ণ এবং পেশাদার এফিলিয়াট্স দল সবসময় আপনাকে সাহায্য করতে প্রস্তুত
            </li>
        </ul>
    </div>
</section>
<section class="info-question" id="OurPlan">
    <div class="title left-menu-title">
        <span class="text">@Lang.OurPlan</span>
        <span class="button-toggle"></span>
    </div>
    <div class="body-result">
        <p class="text">
            আপনার রাজস্ব ভাগ দুটি অংশ নিয়ে গঠিত: (i) আপনার উল্লেখ করা খেলোয়াড়ের বাজির ক্ষতি থেকে এবং (ii) আপনার রেফার করা অ্যাফিলিয়েটের রাজস্ব ভাগ থেকে
        </p>
        <ol type="i">
            <li class="text-block">
                <strong>স্থায়ী রাজস্ব ভাগ:</strong>
                @{ Html.RenderPartial("~/Views/RevenueSharingStructure/_RevenueShareTable.cshtml", Model.MaxCommission); }
                <ul>
                    <li class="text" style="margin-top: 15px;">
                        <strong>কোম্পানির নেট লাভ:</strong> @(Model.SiteFriendlyName)-এ আপনার দ্বারা সুপারিশকৃত সমস্ত খেলোয়াড়ের মাসিক নিট ক্ষতি।
                    </li>
                    <li class="text">
                        <strong>সক্রিয় খেলোয়াড়:</strong> সদস্য যারা মাসে অন্তত একটি (1) বাজি রেখেছেন।
                    </li>
                    <li class="text">
                        যে কোনো মাসের জন্য নেতিবাচক রাজস্ব ভাগ পরবর্তী মাসে এগিয়ে নিয়ে যাওয়া হবে।
                    </li>
                    <li class="text">
                        সমস্ত অনুমোদিত সদস্যদের এফিলিয়েটস সরাসরি ব্যয় করা প্রশাসনিক এবং মার্কেটিং খরচ সাপেক্ষে।
                    </li>
                    <li class="text">
                        মাসিক ভিত্তিতে রাজস্ব থেকে খরচ বাদ দেওয়া হবে । এই খরচ নিম্নলিখিত অন্তর্ভুক্ত হতে পারে:
                        <ul class="dash">
                            <li>
                                <strong>ব্যাঙ্কিং ফি</strong> - সমস্ত অনুমোদিত এফিলিয়াটস গ্রাহকদের জড়িত প্রতিটির জন্য জমা এবং উত্তোলনের চার্জ
                            </li>
                            <li>
                                <strong>রয়্যাল্টি ফি</strong> - সমস্ত সংলগ্ন গ্রাহকদের সাথে সংশ্লিষ্ট সকল পণ্যের রয়্যাল্টি ফি।
                            </li>
                            <li>
                                <strong>প্রচার বোনাস</strong> - এফিলিয়াটস গ্রাহকদেড় আর্থিক বোনাস বা বাট্টা দেয়া হয়
                            </li>
                        </ul>
                    </li>
                </ul>
                <br />
                <p class="text">উদাহরণ</p>
                <p class="text"><i><strong>ইতিবাচক রাজস্ব</strong></i></p>
                <div style="padding-left: 25px;">
                    <p class="text">মোট আয় = USD 18,000</p>
                    <p class="text">বোনাস খরচ = USD 1,000</p>
                    <p class="text">লেনদেন ফি = USD 180</p>
                    <p class="text">রয়্যালটি ফি = USD 1,100</p>
                    <p class="text">কমিশন = </p>
                    <p class="text">(মোট রাজস্ব - বোনাস খরচ - লেনদেন ফি - রয়্যালটি ফি) x রাজস্ব ভাগ %</p>
                    <p class="text">(18,000 - 1,000 - 180 - 1,100) x 45% = USD 7,074</p>
                </div>

                <p class="text"><i><strong>নেতিবাচক রাজস্ব</strong></i></p>
                <div style="padding-left: 25px;">
                    <p class="text">মোট আয় = - USD 8,000</p>
                    <p class="text">সদস্যের বোনাস = USD 698</p>
                    <p class="text">লেনদেন ফি = USD 127</p>
                    <p class="text">কমিশন = </p>
                    <p class="text">(মোট রাজস্ব - বোনাস খরচ - লেনদেন ফি) x রাজস্ব ভাগ %</p>
                    <p class="text">(-8,000 - 698 - 127) x 45% = USD -3,971.25 (পরবর্তী মাসে এগিয়ে যান)</p>
                </div>
            </li>
            <li class="text-block">
                <strong>সাব-অ্যাফিলিয়েট স্ট্রাকচার:</strong> আপনি আপনার রেফার করা অ্যাফিলিয়েটদের রাজস্ব ভাগ থেকে অতিরিক্ত 10% পাওয়ার যোগ্য হবেন, এবং যতক্ষণ না তারা অন্যান্য অ্যাফিলিয়েটদের নিয়ে আসে, আপনি তাদের সাব-অ্যাফিলিয়েটদের রাজস্ব ভাগ থেকেও একটি ভাগ পেতে পারেন
            </li>
        </ol>
    </div>
</section>
<section class="info-question" id="RevenueSharePayoutExample">
    <div class="title left-menu-title">
        <span class="text"><i>@Lang.RevenueSharePayoutExample</i></span>
        <span class="button-toggle"></span>
    </div>
    <div class="body-result">
        <p class="text">
            <i>চিত্র 1:</i> আপনার রেফার করা খেলোয়াড়দের থেকে আপনার উপার্জনের ভাগ কীভাবে গণনা করা হয় তা দেখানোর জন্য একটি উদাহরণ
        </p>
        @{ Html.RenderPartial($"~/Views/RevenueSharingStructure/_ExampleTable.cshtml", Model); }
        <p class="text">
            <i>চিত্র 2:</i> আপনার রেফার করা অ্যাফিলিয়েট (এবং তাদের সাব-অ্যাফিলিয়েট) থেকে আপনার উপার্জনের ভাগ কীভাবে গণনা করা হয় তা দেখানোর জন্য একটি উদাহরণ
        </p>
        <div class="img-support" style="max-width: 431px; margin: 15px auto;">
            <img class="img-responsive" src="~/www/build/styles/Images/revenue-share-structure/revenue_share_hierarchy.@(Model.CurrentLanguage).png?v=174504" alt="hierarchy banner" />
        </div>
        <p class="text">
            রেফারেড আফিয়াটস হইতে রাজস্ব ভাগ অর্জন
        </p>
        <div style="padding-left: 30px;">
            <p class="text">
                = [B1+ ((C1 + C2) * 10%)]*10% + [B2 * 10%]
            </p>
            <p class="text">
                = [0 + (50,000 + 30,000) * 10%)]*10% + [70,000 * 10%]
            </p>
            <p class="text">
                = USD 7,800
            </p>
        </div>
        <p class="text">
            <strong>=></strong> মাসিক আপনার মোট রাজস্ব ভাগ হবে: 58,050 + 7,800 = <strong>USD 65,850</strong>
        </p>
    </div>
</section>
<section class="info-question" id="HowWePay">
    <div class="title left-menu-title">
        <span class="text">@Lang.HowWePay</span>
        <span class="button-toggle"></span>
    </div>
    <div class="body-result">
        <ul>
            <li class="text">
                প্রতি মাসে একবার, আপনার @Model.SiteFriendlyName খেলোয়াড়দের একাউন্ট এর মাধ্যমে (USD, THB, MYR, IDR, INR, CNY, BDT এবং VND-তে) এবং সর্বনিম্ন উত্তোলনের পরিমাণ হল USD 100। অন্যান্য মুদ্রার জন্য আপনাকে @Model.SiteFriendlyName অ্যাফিলিয়েট দলের কাছ থেকে অনুরোধ করতে হবে
            </li>
            <li class="text">
                একই মাসে যেকোনো ২য় প্রত্যাহারের অনুরোধ @Model.SiteFriendlyName অ্যাফিলিয়েটস দলের অনুমোদন সাপেক্ষে হবে
            </li>
        </ul>
    </div>
</section>