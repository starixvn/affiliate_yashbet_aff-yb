@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

<section class="info-group" id="WhatWeHave">
    <div class="title">
        <span class="text">@Lang.WhatWeHave</span>
    </div>
    <ul>
        <li class="text">
            ผลิตภัณฑ์ ที่เกี่ยวกับเกมมิ่งและการเดิมพันออนไลน์ เช่น กีฬา, คาสิโนสด, กีฬาเสมือนจริง, คีโน, เกมสล็อต รวมถึงเกมอื่นๆให้เลือกมากมาย
        </li>
        <li class="text">
            แบรนด์ที่มีชื่อเสียงมีมากกว่า 5 ภาษาเพื่อให้คุณดึงดูดสมาชิกได้ง่ายขึ้น
        </li>
        <li class="text">
            การตลาดเชิงกลยุทธ์เพื่อสร้างความมั่นใจในการแลกเปลี่ยนสมาชิกและการเก็บรักษาสมาชิก
        </li>
    </ul>
</section>
<section class="info-group" id="WhatWeOffer">
    <div class="title">
        <span class="text">@Lang.WhatWeOffer</span>
    </div>
    <ul>
        <li class="text">
            อัตราส่วนแบ่งรายได้สูงถึง @Model.MaxCommission
        </li>
        <li class="text">
            รับเพิ่มอีก 10% เมื่อรับสมัครเพื่อนเพื่อเข้าร่วมโปรแกรมพันธมิตร(Affiliates)ของเราในฐานะพันธมิตรย่อยของคุณ
        </li>
        <li class="text">
            ระบบการจัดการที่มีประสิทธิภาพและใช้งานง่ายสำหรับการติดตามประสิทธิภาพของคุณ
        </li>
        <li class="text">
            ทีมพันธมิตรที่เป็นมิตรและเป็นมืออาชีพที่พร้อมที่จะให้ความช่วยเหลือคุณเสมอ
        </li>
    </ul>
</section>
<section class="info-group" id="OurPlan">
    <div class="title">
        <span class="text">@Lang.OurPlan</span>
    </div>
    <p class="text">
        ส่วนแบ่งรายได้ของคุณประกอบด้วยสองส่วน: (i) ส่วนแรกคือจากการเสียเดิมพันของผู้เล่นที่อ้างอิง และ (ii) ส่วนที่สองจากส่วนแบ่งรายได้ของพันธมิตร(Affiliates) ของคุณ:
    </p>
    <ol type="i">
        <li class="text-block">
            <strong>ส่วนแบ่งรายได้คงที่:</strong>
            @{ Html.RenderPartial("~/Views/RevenueSharingStructure/_RevenueShareTable.cshtml", Model.MaxCommission); }
            <ul>
                <li class="text" style="margin-top: 15px;">
                    <strong>ยอดได้/เสียรวมของสมาชิก:</strong> คำนวณจากยอดเสียสุทธิของสมาชิกที่อยู่ภายใต้พันธมิตรของคุณที่ทำการแนะนำให้ @Model.SiteFriendlyName ในแต่ละเดีอน
                </li>
                <li class="text">
                    <strong>จำนวนผู้เล่นที่ผ่านเกณฑ์:</strong> สมาชิกที่อยู่ภายใต้พันธมิตรนั้นจะต้องมีประวัติการเดิมพันอย่างน้อย 1 ครั้ง ในเดือนนั้นๆ
                </li>
                <li class="text">
                    ยอดบัญชีที่ติดลบของเดือนที่ทำการจ่ายค่าคอมมิชชั่นนั้นจะถูกยกไปรวมในเดือนถัดไป
                </li>
                <li class="text">
                    โบนัสต่างๆ หรือ เงินคืนจากโปรโมชั่นจะถือเป็นค่าใช้จ่ายที่พันธมิตรจะต้องทำการแบกรับ โดยค่าใช้จ่ายนี้จะนำมาหักลบกับรายได้รวม ก่อนที่จะคำนวณเป็นรายได้สุทธิของพันธมิตร
                </li>
                <li class="text">
                    สำหรับในส่วนของค่าใช้จ่ายที่จะนำมาหักลบในส่วนของรายได้สุทธินั้น มีรายละเอียดดังต่อไปนี้:
                    <ul class="dash">
                        <li>
                            <strong>ค่าธรรมเนียมการโอนเงิน</strong> - ค่าธรรมเนียมในการฝากเงิน และ ถอนเงินของสมาชิกภายใต้พันธมิตรของคุณ
                        </li>
                        <li>
                            <strong>ค่าลิขสิทธิ์</strong> - ค่าธรรมเนียมลิขสิทธิ์โปรดักส์ ซึ่งคิดเป็น 10% ของการเล่น GGR จากผู้เล่นที่ทำการสมัครภายใต้ตัวแทนพันธมิตรของคุณ
                        </li>
                        <li>
                            <strong>ค่าโบนัสต่างๆ</strong> - ค่าโบนัสจากโปรโมชั่นต่างๆ เครดิตฟรี หรือ โบนัสคืนเงินให้กับสมาชิกภายใต้พันธมิตรของคุณ
                        </li>
                    </ul>
                </li>
            </ul>
            <br />
            <p class="text">ตัวอย่าง:</p>
            <p class="text"><i><strong>รายได้บวก</strong></i></p>
            <div style="padding-left: 25px;">
                <p class="text">กำไร/ขาดทุนของสมาชิก = USD 18,000</p>
                <p class="text">โบนัสของสมาชิก = USD 1,000</p>
                <p class="text">ค่าธรรมเนียมทางการเงิน = USD 180</p>
                <p class="text">ค่าภาคหลวงค่าธรรมเนียม = USD 1,100</p>
                <p class="text">คอมมิชชั่น = </p>
                <p class="text">(กำไร/ขาดทุนของสมาชิก - โบนัสของสมาชิก - ค่าธรรมเนียมทางการเงิน - ค่าภาคหลวงค่าธรรมเนียม) x อัตราเปอร์เซ็น คอมมิชชั่น %</p>
                <p class="text">(18,000 - 1,000 - 180 - 1,100) x 45% = USD 7,074</p>
            </div>

            <p class="text"><i><strong>รายได้ติดลบ</strong></i></p>
            <div style="padding-left: 25px;">
                <p class="text">กำไร/ขาดทุนของสมาชิก = - USD 8,000</p>
                <p class="text">โบนัสของสมาชิก = USD 698</p>
                <p class="text">ค่าภาคหลวงค่าธรรมเนียม = USD 127</p>
                <p class="text">คอมมิชชั่น = </p>
                <p class="text">(กำไร/ขาดทุนของสมาชิก - โบนัสของสมาชิก - ค่าธรรมเนียมทางการเงิน) x อัตราเปอร์เซ็น คอมมิชชั่น %</p>
                <p class="text">(-8,000 - 698 - 127) x 45% = USD -3,971.25 (ยกยอดไปเดือนหน้า)</p>
            </div>
        </li>
        <li class="text-block">
            <strong>โครงสร้างพันธมิตรย่อย:</strong> คุณจะมีสิทธิ์ได้รับส่วนแบ่งรายได้พิเศษ 10% จากพันธมิตร (Affiliates)ในเครือของคุณและตราบใดที่พวกเขาสามารถนำพันธมิตร
            Affiliates อื่นเข้ามา คุณก็สามารถมีส่วนแบ่งรายได้จากพันธมิตร Affiliates ย่อยของพวกเขาด้วยเช่นกัน!
        </li>
    </ol>
</section>
<section class="info-group" id="RevenueSharePayoutExample">
    <div class="title">
        <span class="text"><i>@Lang.RevenueSharePayoutExample</i></span>
    </div>
    <p class="text">
        <i>รูปที่ 1 :</i> ตัวอย่างเพื่อแสดงให้คุณเห็นว่าการคำนวณส่วนแบ่งรายได้ของคุณจากผู้เล่นที่แนะนำของคุณ
    </p>
    @{ Html.RenderPartial($"~/Views/RevenueSharingStructure/_ExampleTable.cshtml", Model); }
    <p class="text">
        <i>รูปที่ 2:</i> ตัวอย่างเพื่อแสดงให้เห็นว่าการคำนวณส่วนแบ่งรายได้ของคุณจากพันธมิตร Affiliates ของคุณ (และ บริษัท ในเครือย่อย sub-affiliates) คำนวณอย่างไร
    </p>
    <div class="img-support" style="max-width: 600px; margin: 15px auto;">
        <img class="img-responsive" src="~/www/build/styles/Images/revenue-share-structure/revenue_share_hierarchy.@(Model.CurrentLanguage).png?v=174504" alt="hierarchy banner" />
    </div>
    <p class="text">
        ส่วนแบ่งรายได้ของคุณได้รับจากพันธมิตรที่ได้รับการแนะนำ:
    </p>
    <div style="padding-left: 30px;">
        <p class="text">
            = [B1+ ((C1 + C2) * 10%)]*10% + [B2 * 10%]
        </p>
        <p class="text">
            = [0 + (50,000 + 30,000) * 10%)]*10% + [70,000 * 10%]
        </p>
        <p class="text">
            = USD 7,800
        </p>
    </div>
    <p class="text">
        <strong>=></strong> ส่วนแบ่งรายได้รวมของคุณสำหรับเดือนนั้นคือ: 58,050 + 7,800 = <strong>USD 65,850</strong>
    </p>
</section>
<section class="info-group" id="HowWePay">
    <div class="title">
        <span class="text">@Lang.HowWePay</span>
    </div>
    <ul>
        <li class="text">
            @Model.SiteFriendlyName จะทำการจ่ายเงินเดือนละครั้งผ่านบัญชีผู้เล่น @Model.SiteFriendlyName ของคุณ (USD, THB, MYR, IDR, INR, CNY, BDT &amp; VND) และจำนวนการถอนขั้นต่ำคือ USD 100 (หรือในสกุลเงินเทียบเท่า) สำหรับสกุลเงินอื่นต้องทำการติดต่อจากทีมในเครือ @Model.SiteFriendlyName
        </li>
        <li class="text">
            คำขอถอนเงินครั้งที่ 2 ในเดือนเดียวกันจะต้องได้รับการอนุมัติจากทีมในเครือ @Model.SiteFriendlyName
        </li>
    </ul>
</section>