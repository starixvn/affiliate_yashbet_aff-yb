@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

<section class="info-group" id="WhatWeHave">
    <div class="title">
        <span class="text">@Lang.WhatWeHave</span>
    </div>
    <ul>
        <li class="text">
            ហ្គេមកំពូលៗ និងកម្មវិធីភ្នាល់តាមអុីនធឺណិតដូចជា ផ្សាយផ្ទាល់កាស៊ីណូ,Virtual Sports, Keno, ហ្គេម Slot, បូករួមទាំងជម្រើសហ្គេមជាច្រើន
        </li>
        <li class="text">
            មានការគ្រាំទ្រយ៉ាងខ្លាំងដែលមានច្រើនជាង 5 ភាសា ដូច្នេះវាកាន់តែងាយស្រួលសម្រាប់អ្នកក្នុងការទាក់ទាញសមាជិក
        </li>
        <li class="text">
            យុទ្ធសាស្រ្តទីផ្សារធានាការបង្កើនសមាជិក និងអត្រារក្សាសមាជិកបានខ្ពស់
        </li>
    </ul>
</section>
<section class="info-group" id="WhatWeOffer">
    <div class="title">
        <span class="text">@Lang.WhatWeOffer</span>
    </div>
    <ul>
        <li class="text">
            អត្រាចែករំលែកប្រាក់ចំណូលរហូតដល់ @Model.MaxCommission
        </li>
        <li class="text">
            បន្ថែម 10% - ស្វែងរកមិត្តភ័ក្តិឱ្យចូលរួមក្នុងកម្មវិធីសម្ព័ន្ធសាខារបស់យើងជាសាខារងរបស់អ្នក និងទទួលបានរង្វាន់!
        </li>
        <li class="text">
            ប្រព័ន្ធគ្រប់គ្រងដែលមានប្រសិទ្ធភាព និងងាយស្រួលប្រើសម្រាប់ការតាមដានការអនុវត្តរបស់អ្នក
        </li>
        <li class="text">
            ក្រុមការងារដែលរួសរាយរាក់ទាក់ និងប្រកបដោយវិជ្ជាជីវៈ តែងតែត្រៀមខ្លួនជាស្រេចដើម្បីជួយអ្នក
        </li>
    </ul>
</section>
<section class="info-group" id="OurPlan">
    <div class="title">
        <span class="text">@Lang.OurPlan</span>
    </div>
    <p class="text">
        ចំណែកប្រាក់ចំណូលរបស់អ្នកមានពីរផ្នែក៖ (i) ពីការចាញ់ការភ្នាល់របស់អ្នកលេងដែលបានណែនាំ និង (ii) ពីចំណែកចំណូលពីការណែនាំសាខាដោយអ្នក៖
    </p>
    <ol type="i">
        <li class="text-block">
            <strong>ការបែងចែកប្រាក់ចំណូលថេរ៖</strong>
            @{ Html.RenderPartial("~/Views/CommissionStructure/_RevenueShareTable.cshtml", Model.MaxCommission); }
            <ul>
                <li class="text" style="margin-top: 15px;">
                    <strong>ប្រាក់ចំណេញសុទ្ធរបស់ក្រុមហ៊ុន៖</strong> ការបាត់បង់សុទ្ធប្រចាំខែរបស់អ្នកលេងទាំងអស់ដែលបានណែនាំដោយអ្នកទៅកាន់ @Model.SiteFriendlyName ។
                </li>
                <li class="text">
                    <strong>អ្នកលេងមានសកម្មភាព៖</strong> សមាជិកដែលបានភ្នាល់យ៉ាងហោចណាស់មួយ (1) ក្នុងមួយខែ។
                </li>
                <li class="text">
                    ចំណែកប្រាក់ចំណូលអវិជ្ជមានសម្រាប់ខែណាមួយនឹងត្រូវបានអនុវត្តទៅខែបន្ទាប់។
                </li>
                <li class="text">
                    អ្នកតំណាងសមាជិកទាំងអស់ត្រូវទទួលរងការចំណាយផ្នែករដ្ឋបាល និងទីផ្សារដែលកើតឡើងដោយផ្ទាល់ សម្រាប់ការទទួលបានសមាជិក។
                </li>
                <li class="text">
                    ការចំណាយត្រូវបានកាត់ចេញពីប្រាក់ចំណូលប្រចាំខែ ការចំណាយនេះអាចរួមបញ្ចូលដូចខាងក្រោមៈ
                    <ul class="dash">
                        <li>
                            <strong>ថ្លៃសេវាធនាគារ</strong> - ការគិតប្រាក់លើការដាក់ប្រាក់ និងដកប្រាក់សម្រាប់បុគ្គលនីមួយៗដែលពាក់ព័ន្ធនឹងអតិថិជនទាំងអស់របស់អ្នកតំណាងសមាជិក
                        </li>
                        <li>
                            <strong>ថ្លៃសួយសារអាករ</strong> - ថ្លៃសួយសារអាករលើផលិតផលដែលពាក់ព័ន្ធនឹងអតិថិជនគ្រប់សាខាសម្ព័ន្ធ។
                        </li>
                        <li>
                            <strong>ប្រាក់រង្វាន់លើកទឹកចិត្ត</strong> - ប្រាក់រង្វាន់រូបិយវត្ថុ ឬប្រាក់បង្វិលសងដែលបានផ្តល់ឱ្យទៅអតិថិជនសាខាសម្ព័ន្ធ។
                        </li>
                    </ul>
                </li>
            </ul>
            <br />
            <p class="text">ឧទាហរណ៍:</p>
            <p class="text"><i><strong>ប្រាក់ចំណូលវិជ្ជមាន</strong></i></p>
            <div style="padding-left: 25px;">
                <p class="text">ចំណូលទាំងដុលសរុប = USD 18,000</p>
                <p class="text">ការចំណាយប្រាក់រង្វាន់ = USD 1,000</p>
                <p class="text">ថ្លៃប្រតិបត្តិការ = USD 180</p>
                <p class="text">ថ្លៃសួយសារអាករ = USD 1,100</p>
                <p class="text">កំរៃជើងសារ = </p>
                <p class="text">(ចំណូលទាំងដុល - ការចំណាយប្រាក់រង្វាន់ - ថ្លៃប្រតិបត្តិការ - ថ្លៃសួយសារអាករ) x ចំណូល %</p>
                <p class="text">(18,000 - 1,000 - 180 - 1,100) x 45% = USD 7,074</p>
            </div>

            <p class="text"><i><strong>ប្រាក់ចំណូលអវិជ្ជមាន</strong></i></p>
            <div style="padding-left: 25px;">
                <p class="text">ប្រាក់ចំណូលទាំងដុល = - USD 8,000</p>
                <p class="text">ប្រាក់រង្វាន់សមាជិក = USD 698</p>
                <p class="text">ថ្លៃប្រតិបត្តិការ = USD 127</p>
                <p class="text">កំរៃជើងសារ = </p>
                <p class="text">(ចំណូលទាំងដុល - ចំណាយប្រាក់រង្វាន់ - ថ្លៃប្រតិបត្តិការ) x ចំណូល %</p>
                <p class="text">(-8,000 - 698 - 127) x 45% = USD -3,971.25 (អនុវត្តបន្តទៅខែបន្ទាប់)</p>
            </div>
        </li>
        <li class="text-block">
            <strong>រចនាសម្ព័ន្ធសាខារង៖</strong> អ្នកនឹងមានសិទ្ធិទទួលបាន 10% បន្ថែមពីចំណែកប្រាក់ចំណូលរបស់សាខាដែលបានណែនាំរបស់អ្នក ហើយដរាបណាពួកគេនាំយកសាខាផ្សេងទៀតមក អ្នកក៏អាចមានចំណែកពីចំណែកចំណូលរបស់សាខារងរបស់ពួកគេផងដែរ!
        </li>
    </ol>
</section>
<section class="info-group" id="RevenueSharePayoutExample">
    <div class="title">
        <span class="text"><i>@Lang.RevenueSharePayoutExample</i></span>
    </div>
    <p class="text">
        <i>ទី 1៖</i> ឧទាហរណ៍មួយដើម្បីបង្ហាញអ្នកពីរបៀបដែលចំណែកប្រាក់ចំណូលរបស់អ្នកទទួលបានពីអ្នកលេងដែលត្រូវបានណែនាំរបស់អ្នកត្រូវបានគណនា
    </p>
    @{ Html.RenderPartial($"~/Views/CommissionStructure/{Model.SiteName}/_ExampleTable.cshtml", Model); }
    <p class="text">
        <i>ទី 2៖</i> ជាឧទាហរណ៍ដើម្បីបង្ហាញអ្នកពីរបៀបដែលចំណែកប្រាក់ចំណូលរបស់អ្នកទទួលបានពីសាខាដែលបានណែនាំ (និងសាខារងរបស់ពួកគេ) ត្រូវបានគណនា
    </p>
    <div class="img-support" style="max-width: 600px; margin: 15px auto;">
        <img class="img-responsive" src="~/www/build/styles/Images/revenue-share-structure/@(Model.SiteName)/revenue_share_hierarchy.@(Model.CurrentLanguage).png?v=174504" alt="hierarchy banner" />
    </div>
    <p class="text">
        ចំណែកចំណូលរបស់អ្នកទទួលបានពីសាខាដែលបានណែនាំ៖
    </p>
    <div style="padding-left: 30px;">
        <p class="text">
            = [B1+ ((C1 + C2) * 10%)]*10% + [B2 * 10%]
        </p>
        <p class="text">
            = [0 + (50,000 + 30,000) * 10%)]*10% + [70,000 * 10%]
        </p>
        <p class="text">
            = USD 7,800
        </p>
    </div>
    <p class="text">
        <strong>=></strong> ចំណែកប្រាក់ចំណូលសរុបរបស់អ្នកសម្រាប់ខែគឺ៖ 58,050 + 7,800 = <strong>USD 65,850</strong>
    </p>
</section>
<section class="info-group" id="HowWePay">
    <div class="title">
        <span class="text">@Lang.HowWePay</span>
    </div>
    <ul>
        <li class="text">
            ម្តងក្នុងមួយខែ តាមរយៈគណនីអ្នកលេង @Model.SiteFriendlyName របស់អ្នក (គិតជា USD, THB, MYR, IDR, INR, CNY, BDT & VND) ហើយចំនួនទឹកប្រាក់ដកអប្បបរមាគឺ USD 100។ សម្រាប់រូបិយប័ណ្ណផ្សេងទៀត ចាំបាច់ត្រូវស្នើសុំពីក្រុមការងារសាខារបស់ @Model.SiteFriendlyName។
        </li>
        <li class="text">
            រាល់សំណើដកប្រាក់លើកទី 2 ក្នុងខែតែមួយ នឹងត្រូវស្ថិតនៅក្រោមការយល់ព្រមពីក្រុមការងារ @Model.SiteFriendlyName Affiliates ។
        </li>
    </ul>
</section>