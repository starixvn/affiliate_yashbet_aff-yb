@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

@{
    ViewBag.Title = Lang.CommissionStructure;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}
@{
    var htmlString = Html.RenderPartialByLanguage("~/Views/CommissionStructure/_Content", Model.CurrentLanguage, Model).ToHtmlString();
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/left-menu-panel.js")
}

<div class="main-content main-content-left-panel">
    @RazorHelper.RenderLeftPanel(Menu.RevenueSharingMenuList)
    <div class="content">
        <div class="page-title">
            <span class="text">@Lang.CommissionStructure</span>
        </div>

        @Html.Raw(htmlString)

        @RazorHelper.RenderMovingTopButton()
    </div>
</div>