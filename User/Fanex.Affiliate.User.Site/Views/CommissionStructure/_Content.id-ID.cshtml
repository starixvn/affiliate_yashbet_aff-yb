@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

<section class="info-group" id="WhatWeHave">
    <div class="title">
        <span class="text">@Lang.WhatWeHave</span>
    </div>
    <ul>
        <li class="text">
            Permainan teratas dan produk taruhan online seperti Olahraga, Live Casino, Olahraga Maya, Keno, Permainan Slot, ditambah beragam pilihan permainan lainnya.
        </li>
        <li class="text">
            Merek terkenal dengan lebih dari 5 bahasa sehingga lebih mudah bagi Anda untuk menarik anggota.
        </li>
        <li class="text">
            Sarana pemasaran strategis yang memastikan konversi anggota dan tingkat retensi yang tinggi.
        </li>
    </ul>
</section>
<section class="info-group" id="WhatWeOffer">
    <div class="title">
        <span class="text">@Lang.WhatWeOffer</span>
    </div>
    <ul>
        <li class="text">
            Tingkat pembagian penghasilan hingga @Model.MaxCommission
        </li>
        <li class="text">
            Tambahan 10% - merekrut teman untuk bergabung dengan program Afiliasi kami sebagai sub-afiliasi Anda dan dapatkan penghargaan Anda!
        </li>
        <li class="text">
            Sistem manajemen yang efektif dan mudah digunakan untuk pelacakan kinerja Anda.
        </li>
        <li class="text">
            Tim afiliasi yang ramah dan juga profesional selalu siap membantu Anda.
        </li>
    </ul>
</section>
<section class="info-group" id="OurPlan">
    <div class="title">
        <span class="text">@Lang.OurPlan</span>
    </div>
    <p class="text">
        Pembagian hasil Anda terdiri dari dua bagian : (i) dari kerugian taruhan pemain yang Anda referensikan dan (ii) dari pembagian hasil afiliasi yang Anda referensikan:
    </p>
    <ol type="i">
        <li class="text-block">
            <strong>Bagi Hasil Tetap:</strong>
            @{ Html.RenderPartial("~/Views/CommissionStructure/_RevenueShareTable.cshtml", Model.MaxCommission); }
            <ul>
                <li class="text" style="margin-top: 15px;">
                    <strong>Net Win/Loss:</strong> kekalahan bersih bulanan dari semua pemain yang Anda rekomendasikan ke @Model.SiteFriendlyName.
                </li>
                <li class="text">
                    <strong>Pemain Aktif:</strong> member yang telah menempatkan setidaknya satu (1) taruhan di bulan tersebut.
                </li>
                <li class="text">
                    Jumlah dari pembagian hasil adalah minus pada bulan berjalan, akan diteruskan ke bulan berikutnya.
                </li>
                <li class="text">
                    Semua Affiliate dikenakan biaya administrasi dan pemasaran untuk pengakuisisi member.
                </li>
                <li class="text">
                    Biaya yang di kurangi dari kemenangan bersih perusahaan adalah secara bulanan. Biaya ini meliputi:
                    <ul class="dash">
                        <li>
                            <strong>Biaya perbankan</strong> – Biaya Deposit dan Withdrawal untuk setiap transaksi pemain yang dibawa Affiliate.
                        </li>
                        <li>
                            <strong>Biaya Royalti</strong> - Biaya royalti produk, yaitu 10% dari GGR produk yang di mainkan oleh pemain yang di bawa Affiliate.
                        </li>
                        <li>
                            <strong>Bonus Promosi</strong> – Bonus uang asli atau rebate yang diberkan kepada pemain yang dibawa Affiliate.
                        </li>
                    </ul>
                </li>
            </ul>
            <br />
            <p class="text">Contoh:</p>
            <p class="text"><i><strong>Hasil Positif</strong></i></p>
            <div style="padding-left: 25px;">
                <p class="text">Total keuntungan kasar = USD 18,000</p>
                <p class="text">Bonus Member = USD 1,000</p>
                <p class="text">Biaya Transaksi = USD 180</p>
                <p class="text">Biaya Royalti = USD 1,100</p>
                <p class="text">Komisi:</p>
                <p class="text">(Keuntungan Kasar - Bonus Member - Biaya Transaksi - Biaya Royalti) x Komisi %</p>
                <p class="text">(18,000 - 1,000 - 180 - 1,100) x 45% = USD 7,074</p>
            </div>

            <p class="text"><i><strong>Hasil Negatif</strong></i></p>
            <div style="padding-left: 25px;">
                <p class="text">Total keuntungan kasar = - USD 8,000</p>
                <p class="text">Bonus Member = USD 698</p>
                <p class="text">Biaya Royalti = USD 127</p>
                <p class="text">Komisi:</p>
                <p class="text">(Keuntungan Kasar - Bonus Member - Biaya Transaksi) x Komisi %</p>
                <p class="text">(-8,000 - 698 - 127) x 45% = USD -3,971.25 (Lanjutkan ke bulan berikutnya)</p>
            </div>
        </li>
        <li class="text-block">
            <strong>Struktur Sub Afiliasi:</strong> Anda berhak menerima tambahan 10% dari pembagian hasil afiliasi Anda,
            dan selama mereka membawa afiliasi lain, Anda juga dapat mengambil bagian dari pembagian hasil sub-afiliasi mereka juga!
        </li>
    </ol>
</section>
<section class="info-group" id="RevenueSharePayoutExample">
    <div class="title">
        <span class="text"><i>@Lang.RevenueSharePayoutExample</i></span>
    </div>
    <p class="text">
        <i>Gambaran 1:</i> contoh untuk menunjukkan kepada Anda bagaimana perhitungan pembagian hasil Anda dari pemain yang Anda referensikan.
    </p>
    @{ Html.RenderPartial($"~/Views/CommissionStructure/{Model.SiteName}/_ExampleTable.cshtml", Model); }
    <p class="text">
        <i>Gambaran 2:</i> contoh untuk menunjukkan kepada Anda bagaimana perhitungan pembagian penghasilan Anda dari afiliasi yang anda referensikan (dan sub-afiliasi mereka)
    </p>
    <div class="img-support" style="max-width: 600px; margin: 15px auto;">
        <img class="img-responsive" src="~/www/build/styles/Images/revenue-share-structure/@(Model.SiteName)/revenue_share_hierarchy.@(Model.CurrentLanguage).png?v=174504" alt="hierarchy banner" />
    </div>
    <p class="text">
        Pembagian penghasilan Anda diperoleh dari afiliasi yang Anda referensikan:
    </p>
    <div style="padding-left: 30px;">
        <p class="text">
            = [B1+ ((C1 + C2) * 10%)]*10% + [B2 * 10%]
        </p>
        <p class="text">
            = [0 + (50,000 + 30,000) * 10%)]*10% + [70,000 * 10%]
        </p>
        <p class="text">
            = USD 7,800
        </p>
    </div>
    <p class="text">
        <strong>=></strong> Total pembagian hasil Anda untuk bulan ini adalah: 58,050 + 7,800 = <strong>USD 65,850</strong>
    </p>
</section>
<section class="info-group" id="HowWePay">
    <div class="title">
        <span class="text">@Lang.HowWePay</span>
    </div>
    <ul>
        <li class="text">
            Sekali dalam sebulan, melalui akun pemain @Model.SiteFriendlyName Anda (USD, THB, MYR, IDR, INR, CNY, BDT &amp; VND) dan minimum jumlah penarikan adalah 100 USD (atau dalam mata uang yang setara). Untuk mata uang yang lain perlu mengajukan ke tim Afiliasi @Model.SiteFriendlyName.
        </li>
        <li class="text">
            Setiap permintaan penarikan kedua di bulan yang sama harus tunduk pada persetujuan tim Afiliasi @Model.SiteFriendlyName.
        </li>
    </ul>
</section>