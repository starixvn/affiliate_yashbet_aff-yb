@model string

@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = $"YashBet {Lang.AffiliateProgram} | {Lang.ContactUs}";
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/contact-us.css")
}

<div class="page-container">
    <div class="main-content">
        <div class="content">
            <div class="group-title">
                <h2 class="title-block">
                    <span class="text">@Lang.ContactUs</span>
                </h2>
            </div>
            <div class="slogan">
                <p>@Html.Raw(Lang.PleaseDirectAnyComment)</p>
            </div>
            <div class="img-contact">
                <img src="~/www/build/styles/Images/contact-us/vector.svg" alt="Alternate Text" class="img-responsive" />
                <div class="date-time-info">
                    <p class="text-center">@Html.Raw(Lang.SupportTimeYB)</p>
                </div>
            </div>
            <div class="grid-contact-info">
                <div class="contact-items">
                    <div class="icon-social"><img src="~/www/build/styles/Images/contact-us/email.svg" alt="@Lang.EmailContactUs" /></div>
                    <ul class="info-social">
                        <li>
                            <span>@Lang.EmailContactUs</span>
                            <a href=@("mailto:" + Model)>@Model</a>
                        </li>
                    </ul>
                </div>
                <div class="contact-items">
                    <div class="icon-social"><img src="~/www/build/styles/Images/contact-us/telegram.svg" alt="@Lang.Telegram" /></div>
                    <ul class="info-social">
                        <li>
                            <span>@Lang.Telegram</span>
                            <a href="https://t.me/YashBetaffiliate">https://t.me/YashBetaffiliate</a>
                        </li>
                    </ul>
                </div>
                <div class="contact-items">
                    <div class="icon-social"><img src="~/www/build/styles/Images/contact-us/whatsapp.svg" alt="@Lang.Whatsapp" /></div>
                    <ul class="info-social">
                        <li>
                            <span>@Lang.Whatsapp</span>
                            <a href="https://cli.re/YashBetaffiliate">https://cli.re/YashBetaffiliate</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>