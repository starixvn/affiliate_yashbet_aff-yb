@model string

@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = $"YashBet {Lang.AffiliateProgram} | {Lang.ContactUs}";
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/contact-us.css")
}

<div class="main-content">
    <div class="content">
        <div class="page-title">
            <span class="text">@Lang.ContactUs</span>
        </div>
        <div class="slogan">
            <p>@Html.Raw(Lang.PleaseDirectAnyComment)</p>
        </div>
        <div class="grid-contact-info">
            <div class="contact-items">
                <ul class="info-social">
                    <li>
                        <img src="~/www/build/styles/Images/contact-us/email.png" alt="@Lang.EmailContactUs" />
                        <span>@Lang.EmailContactUs</span>
                    </li>
                    <li><a href=@("mailto:" + Model)>@Model</a></li>
                </ul>
            </div>
            <div class="contact-items">
                <ul class="info-social">
                    <li>
                        <img src="~/www/build/styles/Images/contact-us/telegram.png" alt="@Lang.Telegram" />
                        <span>@Lang.Telegram</span>
                    </li>
                    <li><a href="https://t.me/YashBetaffiliate">https://t.me/YashBetaffiliate</a></li>
                </ul>
            </div>
            <div class="contact-items">
                <ul class="info-social">
                    <li>
                        <img src="~/www/build/styles/Images/contact-us/whatsapp.png" alt="@Lang.Whatsapp" />
                        <span>@Lang.Whatsapp</span>
                    </li>
                    <li><a href="https://cli.re/YashBetaffiliate">https://cli.re/YashBetaffiliate</a></li>
                </ul>
            </div>
        </div>

        <div class="date-time-info">
            <p class="text-center">@Html.Raw(Lang.SupportTimeYB)</p>
        </div>
    </div>
</div>