@{
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

@section styles {
    <link rel="stylesheet" href="@Url.RenderLink("~/www/build/styles/css/notify.css")" />
}

<div class="main-content">
    <div class="content">
        <div class="page-notify page-notify-error">
            <img src="~/www/source/styles/Images/notify/Error.png" alt="Error" class="img-responsive" />
            <div class="content-page">
                <h2>Sorry! The System Is Not Available</h2>
                <ul>
                    <li>
                        We are sorry. The system is currently unavailable. Please try again later or contact administrator.
                    </li>
                    <li>
                        Chúng tôi thành thật xin lỗi ,vì hệ thống đang tiến hành bảo trì.
                        Xin vui lòng thử lại trong giây lát sau hoặc liên hệ hỗ trợ trực tuyến
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>