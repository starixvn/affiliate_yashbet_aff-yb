@{
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

@section styles {
    <link rel="stylesheet" href="@Url.RenderLink("~/www/build/styles/css/notify.css")" />
}

<div class="main-content">
    <div class="content">
        <div class="page-notify page-notify-404">
            <img src="~/www/build/styles/Images/notify/404.png" alt="404err" class="img-responsive" />
            <div class="content-page">
                <h2>404: Page Not Found</h2>
                <ul>
                    <li>
                        Sorry, the page you were looking for appears to have been moved, deleted or does not exist.
                    </li>
                    <li>
                        Xin lỗi, trang bạn đang tìm kiếm đã được di chuyển, bị xóa hoặc không tồn tại.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>