@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@section styles {
    <link rel="stylesheet" href="@Url.RenderLink("~/www/build/styles/css/notify.css")" />
}

<div class="page-container">
    <div class="page-notify page-notify-404">
        <div class="img-top-notify">
            <img src="~/www/build/styles/Images/notify/404.svg" alt="404err" class="img-responsive" />
        </div>
        <div class="content-page">
            <h2 class="title-notify">Page not found!!</h2>
            <ul class="cont">
                <li>
                    <span class="img-lang"><img src="~/www/build/styles/Images/icons/flags/England.png" alt="England" /></span>
                    <span class="text-lang">Sorry, the page you were looking for appears to have been moved, deleted or does not exist.</span>
                </li>
                <li>
                    <span class="img-lang"><img src="~/www/build/styles/Images/icons/flags/Hindi.png" alt="Hindi" /></span>
                    <span class="text-lang">क्षमा करें, आप जिस पृष्ठ को खोज रहे थे वह स्थानांतरित हो गया है, हटा दिया गया है या अस्तित्व में नहीं है।</span>
                </li>
                @*<li>
                    <span class="img-lang"><img src="~/www/build/styles/Images/icons/flags/Bangladeshi.png" alt="Bangladeshi" /></span>
                    <span class="text-lang">দুঃখিত, আপনি যে পৃষ্ঠাটি খুঁজছিলেন তা সরানো, মুছে ফেলা হয়েছে বা বিদ্যমান নেই বলে মনে হচ্ছে৷</span>
                </li>*@
            </ul>
        </div>
    </div>
</div>