@model string
@{
    var siteFriendlyName = Model;
}

<div class="info-group">
    <p class="text-block">
        เพื่อที่จะเข้าร่วมโปรแกรมพันธมิตรกับ @siteFriendlyName คุณจะต้องสมัครโปรแกรมพันธมิตรโดยการกรอกใบสมัครผ่านแบบฟอร์มทางอินเตอร์เนต จากนั้นเมื่อการสมัครของคุณได้รับการอนุมัติคุณจะต้องดาวโหลดแบนเนอร์ของเราเพื่อที่จะนำไปวางไว้บนเวบไซค์ของคุณ อีเมลล์ของคุณ หรือในรูปแบบอื่น คุณได้เห็นด้วยทุกประการในกติกาและเงื่อนไขที่ระบุไว้ในเวบไซค์
    </p>
    <p class="text-block">
        ถ้าคุณตัดสินใจว่าจะไม่ยอมรับในกติกาและเงื่อนไขที่ทางเวบไซค์กำหนด กรุณาอย่าได้ดาวโหลดแบนเนอร์ หรือ ลิ้งค์ข้อความแล้วนำไปวางเพื่อทำการตลาดในเวบไซค์ของคุณ ในทุกข้อมูลที่เกี่ยวข้องกับ @(siteFriendlyName).
    </p>
    <p class="text-block">
        เราขอสงวนสิทธิ์ที่จะสิ้นสุดสัญญาฉบับนี้ ถ้าเราไตร่ตรองแล้วว่าเวบไซค์ของคุณไม่เหมาะสม เวบไซค์ที่ไม่เหมาะสม อาจรวมถึงเวบไซค์ที่แสดงเกี่ยวกับเรื่องเพศ ที่มีลูกค้ากลุ่มเป้าหมายคือเด็กและเยาวชน เวบไซค์ที่แสดงถึงความรุนแรง เวบไซค์ที่แบ่งแยกเชื้อชาติ เกี่ยวกับ เพศ ศาสนา หรือ สัญชาติ หรือคนพิการ หรือเวบไซค์ที่ส่งเสริมในเรื่องของกิจกรรมที่ผิดกฏหมาย หรือการละเมิดลิขสิทธิ์ เกี่ยวกับ ไอพี
    </p>
    <p class="text-block">
        นโยบายของ @(siteFriendlyName) เราจะไม่ยอมรับการสมัครออนไลน์ในการเป็นพันธมิตรถ้าคุณได้ทำการโฆษณาผ่านทางคอมพิวเตอร์ที่มีเครื่องไอพีตั้งอยู่หรือดำรงอยู่ในขอบเขตตามกฏหมายของประเทศอังกฤษโดยเด็ดขาด
    </p>
    <p class="text-block">
        รายละเอียดเกี่ยวกับสัญญาฉบับนี้เกี่ยวกับกติกาและเงื่อนไขการเป็นสมาชิกพันธมิตร @(siteFriendlyName) คุณ หมายถึง พันธมิตร อ้างอิงถึง บุคคลใดบุคคลหนึ่ง หรือ กลุ่มบุคคลที่ได้สมัครสมาชิกเข้ามาเป็นพันธมิตรกับเรา ภายใต้สัญญาฉบับนี้ ทั้งนี้จะรวมถึงลูกจ้าง พนักงานบริษัท ผู้อำนวยการ ผู้ถือหุ้น เจ้าของ ทั้งนี้ คำว่า ของท่านได้รวมถึงกลุ่มบุคคลเหล่านี้ด้วยณ" มีความหมายที่สอดคล้องกัน)
    </p>
</div>
<section class="info-group" id="ResponsibilitiesOfTheAffiliate">
    <div class="title">
        <span class="text">1. ความรับผิดชอบที่มีต่อโปรแกรมพันธมิตร</span>
    </div>
    <ol>
        <li class="text-block">เมื่อคุณได้เป็นพันธมิตรกับทางเราแล้วสิ่งที่คุณต้องทำคือการโปรโมตเวบไซค์ @(siteFriendlyName) โดยการนำแบนเนอร์ และ ลิงค์ข้อความของเราไปวางไว้บนเวบไซค์ของคุณ หรือ อีเมลล์ของคุณ หรือวิธีการประชาสัมพันธ์อื่นอื่น</li>
        <li class="text-block">คุณเห็นด้วยที่จะสมัครและให้ข้อมูลที่ถูกต้องและเชื่อถือได้ที่จะใช้ในการติดต่อกับเวบไซค์ @(siteFriendlyName)</li>
        <li class="text-block">คุณจะนำเสนอข้อความหรือหัวข้อที่ได้รับการอนุมัติเป็นลายลักษณ์อักษรจาก @(siteFriendlyName) บนเวบไซค์ของคุณ ข้อความที่ไม่เหมาะสมที่นำไปลงจะถูกพิจารณาจากทางเรา และอาจทำให้บัญชีของคุณสิ้นสุดลงได้ทันที</li>
        <li class="text-block">คุณจะต้องรับผิดชอบทั้งหมด ในเรื่องของการพัฒนาระบบ ของเวบไซค์ การบำรุงรักษาเวบไซค์และสื่งอื่นอื่นที่ปรากฏอยู่บนเวปไซค์ของคุณโดยค่าใช้จ่ายส่วนนี้คุณต้องเป็นคนออกเอง ตัวอย่างเช่น คุณจะต้องรับผิดชอบทั้งหมดเกี่ยวกับเรื่องอุปกรณ์ที่ใช้โพสต์ลงบนเวบไซค์ของคุณ และข้อกำหนดต่างต่างที่เกี่ยวกับการทำผิดกฏหมายหรือการละเมิดลิขสิทธิ์ที่อาจจะเกิดกับบุคคลอื่น เพราะว่าทางเราไม่สามารถเข้าไปควบคุมดูแลเวบไซค์ของคุณได้ เราจึงไม่สามารถรับผิดชอบในส่วนนี้ได้ มากไปกว่านั้นคุณจะต้องรับผิดชอบในส่วนของความเสียหายและค่าใช้จ่ายในเรื่องของค่าธรรมเนียมเกี่ยวกับกฏหมายที่เกี่ยวเนื่องถึงการพัฒนา การปฏิบัติงาน การบำรุงรักษา และ ข้อมูลบนเวบไซค์ของคุณ ข้อกำหนดเกี่ยวกับการชดเชยเหล่านี้ได้แบ่งแยกความรับผิดชอบไว้อย่างชัดเจนที่บังคับใช้ภายใต้กฏหมาย</li>
    </ol>
</section>
<section class="info-group" id="AffiliationGuidelines">
    <div class="title">
        <span class="text">2. การแนะนำเกี่ยวกับพันธมิตร</span>
    </div>

    <ol>
        <li class="text-block">สื่อที่ใช้ในการโปรโมตเวบไซค์ที่ทางเวบไซค์ของเราได้จัดเตรียมให้กับลูกค้าพันธมิตรที่ได้รับสิทธิ์การเป็นพันธมิตรแล้ว จะถูกจัดเตรียมไว้ให้ท่านเรียบร้อยแล้ว อย่างไรก็ตามสื่ออื่นอื่นที่ไม่ได้รับการอนุญาติเป็นลายลักษณ์อักษรจากเวบไซค์ @(siteFriendlyName) ท่านจะไม่สามารถทำได้</li>
        <li class="text-block">คุณไม่สามารถที่จะแก้ไขหรือสิทธิ์ที่ใช้ไอพี แบนเนอร์ หรือการใช้สิ่งเหล่านี้เพื่อวัตถุประสงค์อื่นโดยปราศจากความยินยอมเป็นลายลักษณ์อักษรจาก @(siteFriendlyName) ทุกข้อมูลที่เป็นลิขสิทธิ์ต่างต่างที่ได้รับการอนุมัติโดยเวปไซค์ @(siteFriendlyName) ไม่สามารถที่จะแก้ไขเปลี่ยนแปลงหรือลบออกส่วนหนึ่งส่วนใดได้</li>
        <li class="text-block">โดยการเห็นพ้องต้องกันในการที่จะเข้ามาเป็นส่วนหนึ่งของโปรแกรมพันธมิตร คุณเห็นด้วยที่จะดาวโหลดแบนเนอร์ หรือ ลิ้งค์ข้อความที่จะใช้เป็นเครื่องมือในการทำการตลาดนำไปวางบนเวบไซค์ของคุณ การใช้ประโยชน์จากเครื่องมือเหล่านี้ส่งทางอีเมลล์ การใช้ลิ้งค์ข้อความ ต่างต่าง สิ่งเหล่านี้จะต้องได้รับการอนุมัติจากเวบไซค์เราก่อนเท่านั้น ก่อนใช้งาน</li>
        <li class="text-block">แบนเนอร์และ ลิ๊งค์ข้อความไม่สามารถที่จะนำไปวางและส่งในอีเมลล์แบบแสปม หรือ นำไปโพสต์ลงบนเวบไซค์ที่ไม่ได้รับการอนุญาติ หรือ ห้องสนทนาสดโดยใช้ ระบบคอมพิวเตอร์อัตโนมัติในการแสดงข้อมูล สิ่งเหล่านี้ถ้าถูกทำโดยสมาชิก จะไม่สามารถนำมานับรวม และ จะเป็นเหตุให้บัญชีพันธมิตรของท่านถูกยกเลิก</li>
        <li class="text-block">เราจะยกเลิกสัญญานี้ทันที ถ้ามีการส่งขยะทางอีเมลล์ในนามของคุณเพื่อเป็นการทำลายชื่อเสียงของ เวบไซค์  @(siteFriendlyName) ซึ่งเป็นการทำการตลาดที่ผิดวิธี โดยใช้ข้อความหรือคำพูด</li>
        <li class="text-block">คุณจะไม่สามารถอ้างสิทธิ์ การขอเป็นตัวแทน หรือขอการรับประกัน ในการติดต่อกับเวบไซค์ @(siteFriendlyName) หรือ ไม่มีอำนาจที่จะบังคับ @(siteFriendlyName) ให้รับผิดชอบในเรื่องใดก็ตาม</li>
        <li class="text-block">ถ้าปราศจากการยินยอมเป็นลายลักษณ์อักษรคุณสามารถใช้แบนเนอร์ของเวบไซค์ @(siteFriendlyName) และลิ๊งค์ข้อความเพื่อใช้เครื่องมือในการโปรโมตเวบไซค์ @(siteFriendlyName) เท่านั้น ห้ามใช้เพื่อวัตถุประสงค์อื่น สัญลักษณ์ หรือ ลิ้งค์ข้อความเป็นลิขสิทธิ์ของเวบไซค์เราซึ่งมีไว้ให้สำหรับบุคคลที่ได้รับการอนุญาติจากเวบไซค์เราจึงจะสามารถใช้งานได้</li>
        <li class="text-block">ถ้าเกิดมีกรณีที่การประชาสัมพันธ์ของคุณไม่ได้ถูกดำเนินการในรูปแบบที่เหมาะสมถูกต้องซึ่งอาจทำให้เกิดความเสียหายกับเวบไซค์ @(siteFriendlyName) ไม่ว่าจะเป็นกิจกรรมใดใดก็ตามที่ล่วงละเมิดผ่านทางเวบไซค์ของคุณ ทางบริษัทขอสงวนสิทธิ์ที่จะเรียกเก็บค่าคอมมิชชั่นที่ได้จ่ายให้แล้วคืนมา การพิจารณาของทางเวบไซค์ถือว่าสามารถบังคับใช้ได้สูงสุด เราขอสงวนสิทธิ์ที่เรียกเก็บจำนวนค่าคอมมิชชั่นทั้งหมดที่ได้จ่ายไปในสัญญาฉบับนี้ ถ้ามีเหตุให้เราสามารถเชื่อได้ว่า กิจกรรมที่เกิดขึ้นเกิดจากความตั้งใจของท่านที่จะละเมิดกติกาพันธมิตรที่ทางเวบไซค์กำหนด แม้ว่าบางครั้งคุณอาจจะไม่ได้ตั้งใจ เราขอสงวนสิทธิ์ที่จะระงับการถอนเงินของคุณถ้ามีเหตุให้เชื่อว่ากิจกรรมที่ทำให้เกิดรายได้นั้นนั้นเกิดจากการกระทำของคุณเองหรือกลุ่มคณะบุคคลที่คุณรู้จักโดยตั้งใจ ทางเราขอสงวนสิทธิ์ที่จะระงับการจ่ายค่าคอมมิชชั่นชั่วคราว</li>
        <li class="text-block">พันธมิตรไม่ได้รับอนุญาติให้เล่นในรายการกีฬาที่อยู่ในเวบไซค์ของ @(siteFriendlyName) ผ่านช่องทางการแนะนำของตัวพันธมิตรเองหรือใช้ชื่อบุคคลอื่นในการมีส่วนร่วมรับคอมมิชชั่นในโปรแกรมพันธมิตรนี้ ทั้งนี้รวมถึงบุคคลใดบุคคลหนึ่งหรือคณะบุคคลจากซึ่งได้รับคอมมิชชั่นจากโปรแกรมนี้ ถ้าหากมีการตรวจพบว่ากลุ่มบุคคลดังกล่าวได้ทำการตามที่กล่าวมาข้างต้น ทางเวบไซค์ @(siteFriendlyName) ขอสงวนสิทธิ์ในการยกเลิกที่จะจ่ายค่าคอมมิชชั่นหรือทุกรายการที่เล่นเข้ามา และสิทธิ์ในการเป็นพันธมิตรกับทางเวบไซค์ @(siteFriendlyName) ถือว่าสิ้นสุดลง และกลุ่มบุคคลดังกล่าวจะไม่ได้รับอนุญาติให้ทำการเล่นกับ @(siteFriendlyName) ในอนาคต</li>
        <li class="text-block">คุณไม่ได้รับอนุญาติที่จะเป็นทั้งผู้เล่นหรือผู้ถูกแนะนำและผู้ที่เป็นคนแนะนำในโปรแกรมพันธมิตรในเวลาเดียวกัน ถ้ามีเหตุดังกล่าวเกิดขึ้นหรือมีเหตุที่ทางเราสืบทราบว่ามีเหตุการณ์ดังกล่าวเกิดขึ้นเราขอสงวนสิทธิ์ที่จะสิ้นสุดการเป็นพันธมิตรในทันที ผู้แนะนำในที่นี้มีความหมายเกี่ยวกับความสัมพันธ์ทีเกิดขึ้นระหว่างผู้ที่แนะนำและผู้เล่นหรือผู้ที่ถูกแนะนำ ตามรายการที่ได้แจ้งไว้ในโปรแกรมแนะนำเพื่อนที่ระบุไว้ในเวบไซค์</li>
    </ol>
</section>
<section class="info-group" id="AffiliateTagging">
    <div class="title">
        <span class="text">3. หัวข้อต่างต่างเกี่ยวกับพันธมิตร</span>
    </div>
    <ol>
        <li class="text-block">คุณจะต้องรับผิดชอบสำหรับลูกค้าที่สมัครกับเวบไซค์ @(siteFriendlyName) เท่านั้น</li>
        <li class="text-block">ทรัพย์สินในการใช้โปรโมตเวบไซค์ ที่พันธมิตรได้รับจากเวบไซค์ @(siteFriendlyName) เท่านั้นที่ได้รับอนุญาติ ซึ่งสืออื่นที่ไม่ได้รับจาก เวบไซค์ @(siteFriendlyName) จะไม่ได้รับอนุญาติให้ใช้ เป็นหน้าที่ของสมาชิกพันธมิตรที่จะตรวจสอบว่าลิ๊งค์ที่ใช้โปรโมตเวบไซค์สามารถใช้งานได้อย่างมีประสิทธิภาพ</li>
    </ol>
</section>
<section class="info-group" id="RevenueSharingAndPayment">
    <div class="title">
        <span class="text">4. รายได้ ส่วนแบ่ง และ การจ่าย</span>
    </div>
    <ol>
        <li class="text-block">@(siteFriendlyName) จะจ่ายส่วนแบ่งรายได้ให้กับสมาชิกพันธมิตรแต่ละท่านอ้างอิงจากคอมมิชชั่นที่แต่ละสมาชิกได้รับ ตามโครงสร้างการรับคอมมิชชั่นที่กำหนดไว้ โดยรายการบัญชีพันธมิตรของคุณ ต้องมีผู้เล่นที่แอเข้าเกณฑ์ อย่างน้อย (5) คนในเดือนนั้นๆอย่างไรก็ตาม @(siteFriendlyName) ขอสงวนสิทธิ์ที่จะระงับการจ่ายเงินค่าคอมมิชชั่นพันธมิตรไม่ว่าจะระงับเป็นเฉพาะบางเดือน หรือระงับเป็นบางส่วนหรือเต็มจำนวน โดยไม่คำนึงถึงลูกค้าที่มีบัญชีการเล่นผ่านเกณฑ์ ไม่ต่ำกว่า (5) คนในเดือนนั้น โดยถ้าเห็นว่าสมาชิกพันธมิตรไม่ได้พยายามที่จะส่งเสริม โปรโมท @(siteFriendlyName) อย่างน้อย 2 เดือนขึ้นไป ซึ่งทำให้ไม่มีการนำสมาชิกใหม่เข้ามา, หรือหากเห็นว่าไม่มีการอัพเดตแบนเนอร์ในเวปไซต์ที่ลงทะเบียนไว้ของพันธมิตร และหรือไม่ได้มีกิจกรรมใดๆ ที่เป็นการ ส่งเสริมการกระตุ้นยอดหรือสนับสนุนส่งเสริม @(siteFriendlyName) แต่อย่างใด ค่าคอมมิชชั่นอาจถูกระงับจนกว่าจะมีสมาชิกใหม่เข้ามาเดิมพันในบัญชีของพันธมิตรนั้นๆ ทั้งนี้ @(siteFriendlyName) สามารถพิจารณาที่จะอนุมัติค่าคอมมิชชั่นที่ถูกระงับในเดือนนั้น ๆ ทั้งยอดเต็มหรือบางส่วนก็ตาม และค่าคอมมิชชั่นที่มีการระงับเป็นระยะเวลาเกิน 6 เดือนอาจจะเป็นโมฆะทั้งนี้ขึ้นอยู่กับดุลยพินิจของ @(siteFriendlyName) เป็นที่สุด</li>
        <li class="text-block">
            <p class="text text-block">
                ค่าคอมมิชชั่นที่ได้ จากการคำนวนรายได้ของ @(siteFriendlyName) หักลบค่าธรรมเนียมทางการเงิน, เงินโบนัสพิเศษ, เงินให้เปล่า หรือค่าสมนาคุณต่างๆแก่ผู้เล่น และในเดือนนั้นๆ ต้องมีผู้เล่นที่เข้าเกณฑ์ อย่างน้อย(5) คน
            </p>
            <ol type="a">
                <li>
                    <p class="text text-block">ค่าใช้จ่ายที่ถูกเรียกเก็บภายหลัง ผู้ที่ถือบัตรเครดิต ที่ได้ค้นพบว่ามีการทำรายการที่ไม่ปกติ ที่เกิดจากบัตรเครดิตของท่าน ซึ่งไม่ได้รับการอนุญาติจากเจ้าของบัตร ผู้ที่ถือบัตรเครดิตท่านดังกล่าวได้ทำการร้องขอกับทางธนาคารที่จะขอคืนสิทธิ์ค่าใช้จ่ายที่ถูกจ่ายไปเหล่านี้ ค่าใช้จ่ายที่ถูกเรียกเก็บภายหลังนี้ เชื่อมโยงถึงกรณีที่มีการโกงเกิดขึ้นโดยใช้บัตรเครดิตของผู้ที่มีบัตรโดยไม่ได้รับอนุญาติ</p>
                    <p class="text text-block">"ผลกำไรของ @(siteFriendlyName)" คือ จำนวนเงินทั้งหมดที่วางพนันโดยสมาชิกที่เดิมพันผ่านเกณฑ์อย่างน้อยห้า(5) คน ที่แนะนำภายใต้บัญชีสมาชิกของคุณในเดือนใดๆ โดยหักจำนวนยอดชนะรวมที่เกิดขึ้นจากสมาชิกทุกท่านที่แอคทีฟในเดือนนั้น</p>
                    <p class="text text-block">"เงินที่ถูกปฏิเสธการชำระ" คือ จำนวนเงินที่ถูกหักออกเมื่อลูกค้าผู้ถือบัตรเครดิตพบว่า มีการปฏิเสธการชำระเงินที่ผิดปกติและไม่ได้รับอนุญาตในบัตรเครดิต/เดบิตของลูกค้า และผู้ถือบัตรเครดิตร้องขอให้ธนาคารยกเลิกการการชำระเงินเหล่านี้ เงินที่ถูกปฏิเสธการชำระอาจเกี่่ยวกับแต่ไ่ม่จำกัดเฉพาะการที่บุคคลภายนอกใช้บัตรหรือหมายเลขบัตรของผู้ถือบัตรเครดิตเพื่อการฉ้อฉล</p>
                </li>
                <li>
                    <p class="text text-block">หากผู้เล่นปฎิเสธการชำระเงิน รายได้ที่มีข้อโต้แย้งหรือเป็นจำนวนที่ถูกปฏิเสธการชำระจะถูกริบ และถูกหักออกจากยอดเงินคงเหลือทั้งหมดที่ต้องชำระให้คุณในเดือนปัจจุบัน หากจำนวนที่หักออกจากรายได้สะสมเกินจำนวนที่ต้องชำระในปัจจุบันของคุณ ยอดเงินคงเหลือของคุณจะกลายเป็นยอดเงินติดลบและคุณจะต้องหารายได้เพื่อชดเชยจำนวนที่ถูกหักก่อนที่คุณจะเริ่มหารายได้ใหม่อีกครั้ง</p>
                    <p class="text text-block">จำนวนเงินที่ถูกปฏิเสธการชำระจะค้างชำระจนกว่ารายได้ที่ผู้เล่นอื่นๆ ของคุณได้รับสามารถชดเชยจำนวนที่ค้างชำระดังกล่าวได้ คุณรับทราบว่า  @(siteFriendlyName) สามารถจ่ายคืนเงินเป็นสัดส่วนหนึ่งจากผลกำไรจริงเท่านั้น ซึ่งไม่ใช่รายได้จากการฉ้อฉล</p>
                    <p class="text text-block">โบนัส" รวมถึง เงินสมนาคุณ ข้อเสนอเงินฟรี เครดิต โบนัส โบนัสแรกเข้า เงินโปรโมชั่น และสิ่งจูงใจอื่นๆ ที่เข้าบัญชีของลูกค้า เนื่องจากลูกค้าไม่ได้ซื้อจำนวนเงินเหล่านี้จริงๆ @(siteFriendlyName) ไม่สามารถคำนวณจ่ายค่าคอมมิชชั่นจากโบนัสเหล่านี้ได้</p>
                </li>
            </ol>
        </li>
        <li class="text-block">ถ้าหากว่าคุณไม่สามารถรับค่าคอมมิชชั่นได้โดยสาเหตุตามข้อ 4.1 และ 4.2 ด้านบน เนื่องจากคุณไม่สามารถรักษาลูกค้าที่มีบัญชีการเล่นแอคทีพได้ อย่างน้อย (5) ท่านในเดือนนั้น คุณจะไม่ได้รับค่าคอมมิชชั่นของเดือนนั้นๆ และไม่มีการนำยอดเดิมพันเสีย ของเดือนดังกล่าวไปรวมกับยอดของเดือนถัดไป</li>
        <li class="text-block">รายได้จากค่าคอมมิชชั่นจะอยู่ในเงื่อนไขของการคำนวณในโปรแกรมพันธมิตร @(siteFriendlyName) กรุณาตรวจสอบวิธีการคำนวณที่ระบุไว้ในโปรแกรมพันธมิตรอย่างสม่ำเสมอ</li>
        <li class="text-block">รายได้ติดลบจะถูกยกไปในเดือนถัดไป ถ้ารายได้ของท่านเป็นบวกในเดือนนั้นนั้น ท่านจะได้รับการจ่ายเงินค่าคอมมิชชั่นหากสามารถยอดผู้เล่นถึงตามเกณฑ์ขั้นต่ำที่เรากำหนดไว้</li>
        <li class="text-block">ค่าคอมมิชชั่นคำนวนอ้างอิงตามตารางโครงสร้างการรับคอมมิชชั่น รวมจากทุกรายการเล่นของลูกค้าที่ได้รับการแนะนำภายใต้พันธมิตรคุณ และตราบใดที่พันธมิตรยังคงสถานะพันธมิตรกับโปรแกรมพันธมิตรนี้อยู่</li>
    </ol>
</section>
<section class="info-group" id="PoliciesAndConfidentiality">
    <div class="title">
        <span class="text">5. นโยบาย และ สิ่งที่เป็นความลับ</span>
    </div>
    <ol>
        <li class="text-block">@(siteFriendlyName) ได้ให้สิทธิ์กับสมาชิกพันธมิตรในสัญญาฉบับนี้ คุณในนามของพันธมิตร สามารถทำการประชาสัมพันธ์เวบไซค์ @(siteFriendlyName) อย่างไรก็ตาม เราขอสงวนสิทธิ์ที่จะปฎิเสธลูกค้าหรือปิดบัญชีของลูกค้า ถ้ามีความจำเป็นเมื่อไรก็ได้</li>
        <li class="text-block">โดยการเปิดบัญชีในการเป็นสมาชิก บุคคลท่านนั้นจะได้รับสิทธิ์ในการเป็นลูกค้า สอดคล้องกับ กฏกติกาของการเป็นสมาชิก นโยบาย และ ขั้นตอนและกระบวนการต่างต่างจะถูกนำมาใช้กับบุคคลเหล่านี้</li>
        <li class="text-block">ในสัญญาฉบับนี้ คุณสามารถไว้วางใจได้ว่าข้อมูลที่เกี่ยวกับธุรกิจจะถูกเก็บไว้เป็นความลับ การใช้เทคโนโลยีในการโปรโมตโปรแกรมพันธมิตรของท่าน ( รวมถึงตัวอย่างเช่น ค่าแนะนำที่คุณได้รับจากการแนะนำลูกค้าเข้ามาเป็นสมาชิกภายใต้เครือข่ายของคุณ). คุณเห็นด้วยที่จะไม่เปิดเผยข้อมูลที่เป็นความลับดังกล่าวให้กับบุคคลที่ 3 หรือบุคคลภายนอก นอกเสียจากว่าคุณได้รับความยินยอมเป็นลายลักษณ์อักษรว่าคุณสามารถใช้ข้อมูลที่เป็นความลับเหล่านี้เพื่อวัตถุประสงค์ที่จำเป็นในสัญญาฉบับนี้ คุณมีหน้าที่ที่จะเก็บข้อมูลเหล่านี้ไว้เป็นพันธมิตร เพื่อทำให้สัญญาฉบับนี้ไม่สิ้นสุดลง</li>
    </ol>
</section>
<section class="info-group" id="LimitedLicense">
    <div class="title">
        <span class="text">6. ใบอนุญาต</span>
    </div>
    <ol>
        <li class="text-block">เราขอสงวนสิทธิ์ในการอนุญาติให้คุณใช้ แบนเนอร์ของเราในการประชาสัมพันธ์ ภายใต้เงื่อนไขข้อกำหนดในสัญญาฉบับนี้เท่านั้น ที่คุณจะสามารถนำแบนเนอร์ของเราไปวางบนเวปไซค์คุณเพื่อทำการประชาสัมพันธ์</li>
        <li class="text-block">โดยข้อตกลงเหล่านี้ เราให้สิทธิ์ท่านในการที่จะแนะนำลูกค้าให้มาใช้สินค้าและบริการในเวบไซค์ของเรา สอดคล้องกับกติกาและเงื่อนไขในการเป็นพันธมิตรในสัญญาฉบับนี้ อย่างไรก็ตามสัญญาฉบับนี้ไม่ได้ให้สิทธิ์กับคุณในการให้ความช่วยเหลือกับผู้ที่คุณแนะนำในกรณีอื่นอื่น และทางบริษัทขอสงวนสิทธิ์ในการที่จะรับข้อมูลจากคณะบุคคลอื่นเช่นเดียวกับคุณและบุคคลอื่นไม่สามารถได้รับค่าคอมมิชชั่นหรือเงินชดเชยในการทำธุรกิจในสัญญาฉบับนี้นอกจากตัวคุณเท่านั้น</li>
        <li class="text-block">ใบอนุญาตนี้ ไม่สามารถทำให้เป็นใบอนุญาตเสริมให้กับคุณ อย่างไรก็ตามเป็นสิทธิ์ของท่านที่จะใช้เครื่องหมายการค้าซึ่งกำหนดให้สิทธิ์ท่านที่จะใช้แบนเนอร์ของเราในการโปรโมตเวบไซค์ คุณจะไม่สามารถนำสิ่งที่เราจัดเตรียมให้คุณไปใช้เพือวัตถุประสงค์อื่น เครื่องหมายการค้านี้เป็นลิขสิทธิ์ของเวบไซค์ เท่านั้น</li>
        <li class="text-block">เราขอสงวนสิทธิ์ที่จะยึดใบอนุญาตินี้เมื่อไรก็ตามและมันจะทำให้สัญญาฉบับนี้สิ้นสุดลงไม่ว่าด้วยเหตุผลใดก็ตาม</li>
    </ol>
</section>
<section class="info-group" id="LegalResponsibility">
    <div class="title">
        <span class="text">7. ความรับผิดชอบเกี่ยวกับกฏหมาย</span>
    </div>
    <ol>
        <li class="text-block">ความเป็นเจ้าของข้อความของเวบไซค์นี้ ยังคงเป็นทรัพย์สินของเราและจะไม่สามารถถูกถ่ายโอนไปยังผู้อื่นได้ ทั้งนี้ได้ถูกกำหนดไว้ในสัญญาพันธมิตรฉบับนี้เรียบร้อยแล้ว</li>
        <li class="text-block">ความเป็นเจ้าของ ข้อความ และ หนี้สินของเวบไซค์@(siteFriendlyName) จะถูกกำหนดให้เป็นความรับผิดชอบของโปรแกรมพันธมิตร คุณมีหน้าที่เพียงแค่ ทำการส่งเสริมการตลาดและดูแลเวบไซค์ของคุณให้สามารถใช้งานได้อย่างมีประสิทธิ์ภาพ และค่าใช้จ่ายเหล่านี้คุณเป็นผู้รับผิดชอบเองทั้งหมด</li>
        <li class="text-block">คุณจะต้องชดเชยและรับผิดชอบในความเสียหายถ้าหากมีผู้ร้องขอความรับผิดชอบ ค่าใช้จ่ายในส่วนนี้รวมถึงค่าธรรมเนียมในการจ้างนักกฏหมาย ที่เกี่ยวข้องกับการพัฒนา การปฏิบัติงาน การบำรุงรักษา และ เนื้อหาที่ลงบนเวบไซค์ของคุณ ข้อกำหนดเกี่ยวกับการชดเชยเหล่านี้ได้แบ่งแยกความรับผิดชอบไว้อย่างชัดเจนที่บังคับใช้ภายใต้กฏหมาย</li>
        <li class="text-block">มันเป็นหน้าที่รับผิดชอบของทีมงานพันธมิตรที่จะติดตามและตรวจสอบขั้นตอนต่างต่างเพื่อให้แน่ใจว่าลูกค้าใหม่ได้รับการจ่ายเงินแล้ว</li>
        <li class="text-block">การนำแบนเนอร์ไปวาง หรือ ลิ๊งค์ข้อความการโปรโมตเวบไซค์@(siteFriendlyName)  เป็นหน้าที่รับผิดชอบของทีมงานพันธมิตร สมาชิกพันธมิตรต้องตรวจสอบให้แน่ใจว่า ข้อความที่นำไปวางเพื่อใช้โปรโมตนั้นถูกต้องและสามารถใช้งานได้อย่างมีประสิทธิภาพ</li>
        <li class="text-block">พันธมิตรต้องแน่ใจว่าข้อความที่โพสต์ในเวบไซค์ของท่านถูกกฏหมาย ที่ไม่ได้ละเมิดลิขสิทธิ์ หรือละเมิดสิทธิ์ผู้อื่น</li>
        <li class="text-block">เราอาจจะปรับเปลี่ยนในเรื่องของกติกาและเงื่อนไขซึ่งระบุไว้ในสัญญาฉบับนี้ ได้ทุกเมื่อและเรามีอิสระในการพิจารณา กติกาเงื่อนไขที่ปรับเปลี่ยนนี้จะถูกระบุอยู่ในเวบไซค์ของเรา การปรับเปลี่ยนกติกานี้ จะรวมถึง ตัวอย่างเช่น การเปลี่ยนกติกาในเรื่องขอค่าธรรมเนียมในการแนะนำ ค่าธรรมเนียมอื่นอื่น กำหนดการ การจ่ายเงิน ขั้นตอนการดำเนินการ และกติกาที่ใช้เกี่ยวกับการแนะนำสมาชิก ถ้ามีการปรับเปลี่ยนกติกาข้อใดที่ลูกค้าไม่สามารถยอมรับได้ เป็นหน้าที่ของลูกค้าที่จะต้องติดตามตรวจสอบเพื่อขอยุติสัญญา หากไม่มีการติดตาม ถือว่า ลูกค้ายอมรับในเงื่อนไขที่ได้ปรับเปลี่ยนและยอมรับในกติกาที่เปลี่ยนแปลงนี้ทุกประการ</li>
        <li class="text-block">
            <p>แสปม เราไม่ยอมรับอีเมลล์ขยะ</p>
            <ol type="a">
                <li class="text-block">ในรูปแบบของอีเมลล์ที่เป็นสแปมอีเมลล์ที่ถูกใช้กับบัญชีของคุณ ทุกจำนวนเงินที่ถูกจ่ายออกไปในการสืบสวนเกี่ยวกับบัญชี ค่าใช้จ่ายเหล่านี้ที่ลูกค้าได้จ่ายไปในมูลค่าเท่ากันอาจจะถูกนำมาหักจากบัญชีของคุณ เพื่อความยุติธรรมกับลูกค้าและตัวสมาชิกพันธมิตรเอง ค่าใช้จ่ายเหล่านี้ท่านสมาชิกและลูกค้าได้เห็นด้วยที่จะยอมรับเมื่อท่านเป็นสมาชิกพันธมิตรกับ  @(siteFriendlyName)</li>
                <li class="text-block">ค่าใช้จ่ายเหล่านี้จะไม่ได้รวมจำนวนเงินที่อยู่ในบัญชีของท่าน เราขอสงวนสิทธิ์ที่จะสืบสวนสอบสวน บัญชีพันธมิตรของท่าน ถ้าหากมีข้อสงสัยหรือมีเหตุบางประการ เราของสงวนสิทธิ์ในการพิจารณาการจ่ายค่าคอมมิชชั่นของท่าน จนกว่าทางเราจะสามารถหาข้อยุติได้ หรือในกรณีที่บัญชีพันธมิตรของท่านไม่สามารถแนะนำลูกค้าเพื่อสร้างรายได้ ทางเราจะขอปฏิเสธที่จะจ่ายเงินค่าคอมมิชชั่นดังกล่าวให้กับสมาชิกพันธมิตร</li>
            </ol>
        </li>
        <li class="text-block">คุณและเรามีอิสระในการติดต่อกัน และในสัญญาฉบับนี้จะไม่ได้กล่าวถึงการเป็นหุ้นส่วน การเป็นตัวแทน หรือร่วมหุ้น การขาย หรือสิทธิ์ในการเป็นตัวแทน หรือ ความสัมพันธ์เกี่ยวกับการจ้างงาน คุณไม่มีสิทธิ์ในการแสดงการเป็นตัวแทน คุณไม่สามารถที่จะนำข้อความที่แสดงถึงการเป็นตัวแทนไปวางไว้บนเวบไซค์ของคุณ</li>
    </ol>
</section>
<section class="info-group" id="Miscellaneous">
    <div class="title">
        <span class="text">8. เรื่องอื่นๆ</span>
    </div>
    <ol>
        <li class="text-block">
            <p>มอบหมาย-ความสามารถ</p>
            <p class="text-block">คุณอาจจะไม่ต้องปฏิบัติตามข้อกำหนดในสัญญาฉบับนี้ หากไม่มีการแจ้งการตอบรับการเป็นสมาชิกอย่างเป็นลายลักษณ์อักษรจากทางเรา ข้อกำหนดในสัญญาฉบับนี้จะไม่สามารถบังคับใช้กับคุณและทางเราได้</p>
        </li>
        <li class="text-block">
            <p>ไม่มีเอกสารการสละสิทธิ์</p>
            <p class="text-block">การล้มเหลวของเราที่จะบังคับให้ท่านใช้สิ่งที่เราจัดหามาให้ ในสัญญาฉบับนี้ จะไม่ได้ประกอบไปด้วย การใช้สิ่งที่เราจัดเตรียมให้ท่านนั้น ท่านจะไม่สามารถปรับเปลี่ยน เพิ่มเติม ลบ หรือเปลี่ยนแปลงสิ่งที่มีอยู่ในสัญญาฉบับนี้ สิ่งเหล่านี้ได้ถูกยอมรับและบันทึกโดยทางเราเรียบร้อยแล้ว ลูกจ้าง พนักงานบริษัท หรือตัวแทน ไม่สามารถปรับเปลี่ยนแก้ไขสัญญาฉบับนี้ได้</p>
        </li>
        <li class="text-block">
            <p>การแก้ไข</p>
            <p class="text-block">เป็นสิทธิ์ของเราที่จะบังคับใช้ข้อกำหนดในสัญญาฉบับนี้ ท่านสมาชิกได้รับรู้ และ ยืนยันที่จะยอมรับข้อกำหนดที่ได้ระบุไว้ในสัญญาฉบับนี้ สมาชิกมีหน้าที่ที่จะต้องปฏิบัติตามเงื่อนไข ของสัญญาฉบับนี้ ถ้าหากมีข้อโต้แย้งในเรื่องของสิทธิเกิดขึ้น ไม่ว่าจะด้วยเหตุใดก็ตาม ทางบริษัทขอใช้สัญญาฉบับนี้ บังคับใช้ได้อย่างถูกต้องตามกฏหมาย สมาชิกทุกท่านยินยอม เข้าใจ และยืนยันที่จะปฏิบัติตามข้อตกลงในสัญญาฉบับนี้ทุกประการ และ กฏหมายสามารถบังคับใช้กับท่านได้ ถ้ามีเหตุเกิดขึ้นซึ่งต้องหาผู้รับผิดชอบ ข้อกำหนดของสัญญาฉบับนี้ได้กำหนดบทบาทหน้าที่ที่สมาชิกต้องปฏิบัติตามไว้อย่างชัดเจนแล้ว</p>
        </li>
        <li class="text-block">
            <p>การเป็นโมฆะ / การสละสิทธิ์</p>
            <p class="text-block">เงื่อนไขในแต่ละข้อของสัญญาฉบับนี้ ได้ถูกแปลไว้เป็นภาษาต่างต่างเพื่อที่จะใช้บังคับตามกฏหมาย แต่ถ้ามีเงื่อนไขใดที่ไม่สอดคล้องกับสถานการณ์ปัจจุบันหรือผิดกฏหมาย เงื่อนไขนั้นนั้นจะถือว่ายกเลิกไปโดยปริยายไม่สามารถบังคับใช้ได้ การพิจารณาเงื่อนไขข้อบังคับในสัญญาฉบับนี้มีไว้เพื่อคุ้มครองและปกป้องสิทธิ์ของเวบไซค์เราเท่านั้น ทุกเงื่อนไขได้ถูกกำหนดไว้เป็นลายลักษณ์อักษรและผู้ใช้เวบไซค์ได้ยอมรับและเห็นด้วยในการใช้งานเรียบร้อยแล้ว</p>
        </li>
    </ol>
</section>
<section class="info-group" id="TermAndTermination">
    <div class="title">
        <span class="text">9. กติกา และ การสิ้นสุด</span>
    </div>
    <ol>
        <li class="text-block">กติกาของสัญญาฉบับนี้เริ่มต้นจากคุณได้ดาวโหลดลิ๊งค์แบนเนอร์และลิ้งค์ข้อความของเราแล้วนำไปวางบนเวปไซค์ของคุณ และดำเนินการเป็นพันธมิตรตามสัญญาฉบับนี้ไปจนกว่าจะมีข้อความแจ้งเป็นลายลักษณ์อักษรว่าสัญญาได้สิ้นสุดลงแจ้งไป ซึ่งจะทำให้สัญญาสิ้นสุดลงในทันที ถ้ามีการทำให้สัญญาสิ้นสุดลง คุณจะได้รับอีเมลล์เป็นลายลักษณ์อักษรจากทางเรา</li>
        <li class="text-block">
            <p>ในกรณ๊ที่สัญญาฉบับนี้สิ้นสุดลง :</p>
            <ol type="a">
                <li class="text-block">คุณต้องนำแบนเนอร์ของ @(siteFriendlyName) ออกจากเวบไซค์ของคุณและนำลิ๊งค์ข้อความที่จะเชื่อมโยงมาที่ @(siteFriendlyName) ออก</li>
                <li class="text-block">ทุกลิขสิทธิ์และใบอนุญาติที่ให้ไว้ในสัญญาฉบับนี้ได้ถูกทำให้สิ้นสุดลงโดยทันที</li>
                <li class="text-block">คุณจะได้รับสิทธิ์ที่จะรับเงินค่าแนะนำสมาชิกให้กับเราในเดือนนั้นนั้น หากคุณยังเป็นสมาชิกพันธมิตรกับเราตามปกติและสามารถปฏิบัติตามข้อกำหนดของเราในสัญญาฉบับนี้ตามรายละเอียดข้อ 9.2 ด้านล่าง เราอาจจะระงับการถอนเงินของคุณชั่วคราวของคุณ</li>
                <li class="text-block">ถ้าคุณไม่สามารถในการทำหน้าที่ของคุณในการแนะนำสมาชิกให้กับเรา เราจะไม่จ่ายค่าแนะนำให้คุณหรือสัญญาการเป็นพันธมิตรของคุณจะถูกทำให้สิ้นสุดลง</li>
                <li class="text-block">เราอาจจะเพิกถอนการจ่ายค่าคอมมิชชั่นล่าสุดเพื่อตรวจสอบจำนวนเงินที่จะทำการจ่ายว่าถูกต้องหรือไม่</li>
                <li class="text-block">ถ้าเรายังอนูญาตให้เกิดกิจกรรม ซึ่งก่อให้เกิดรายได้ จากลูกค้าหลังจากสัญญาพันธมิตรได้ถูกทำให้สิ้นสุดแล้ว เรื่องดังกล่าวนี้จะไม่นับรวมถึงการสละสิทิ์หรือการต่อสัญญาฉบับใหม่ หรือ ความเห็นพ้องต้องกันในการเปลี่ยนแปลงขอสัญญาที่สิ้นสุดลง</li>
                <li class="text-block">คุณจะต้องส่งมอบคืนข้อมูลที่เป็นความลับ ทุกประเภทที่คุณได้รับไปจากทางเรา เพื่อหยุดผู้เล่นทุกท่านในเครือข่ายของคุณไม่ว่าจะเป็นชื่อ ลิขสิทธิ์ เครื่องหมายการให้บริการ เครื่องหมายอื่นที่เกี่ยวข้อกับการทำธุรกิจของเรา</li>
                <li class="text-block">คุณและเรา จะถูกทำให้เป็นอิสระในภาระหนี้ความรับผิดชอบเกี่ยวกับหนี้สินหลังจากสิ้นสุดวันเวลาที่กำหนดในสัญญา ยกเว้นภาระหน้าที่เกิดขึ้นตามปกติโดยส่วนตัวซึ่งยังคงต้องรับผิดชอบ ตามที่ได้ระบุไว้ในสัญญาฉบับนี้ การสิ้นสุดของสัญญาฉบับนี้ จะไม่ทำให้คุณหมดความรับผิดชอบในเรื่องของหนี้สินหากคุณมีการทำผิดข้อตกลงในก่อนที่สัญญาจะสิ้นสุดลง</li>
                <li class="text-block">เราอาจจะสิ้นสุดสัญญาฉบับนี้ถ้าเราได้พิจารณณาแล้ว ( ขึ้นอยู่กับการพิจารณาอย่างอิสระของเรา ) ว่าเวบไซค์ของคุณไม่เหมาะสม เวบไซค์ที่ไม่เหมาะสมอาจรวมไปถึงเวบไซค์ที่ไม่เหมาะสมสำหรับเยาวชน เวบไซค์ที่โปรโมตสื่อเกี่ยวกับเรื่องเซกซ์ ส่งเสริมเกี่ยวกับเรื่องความรุนแรง ส่งเสริมเกี่ยวกับเรื่องการแบ่งแยกเชื้อชาติ เพศ ศาสนา สัญชาติ ความพิการ อายุ หรือส่งเสริมกิจกรรมที่ผิดกฏหมาย หรือละเมิดลิขสิทธิ์เกี่ยวกับทรัพย์สินทางปัญญา</li>
            </ol>
        </li>
    </ol>
</section>
<section class="info-group" id="RelationshipOfParties">
    <div class="title">
        <span class="text">10. ความสัมพันธ์</span>
    </div>
    <p class="text text-block">
        คุณและเรามีอิสระในการติดต่อกัน และในสัญญาฉบับนี้จะไม่ได้กล่าวถึงการเป็นหุ้นส่วน การเป็นตัวแทน หรือร่วมหุ้น การขาย หรือสิทธิ์ในการเป็นตัวแทน หรือ ความสัมพันธ์เกี่ยวกับการจ้างงาน คุณไม่มีสิทธิ์ในการแสดงการเป็นตัวแทน คุณไม่สามารถที่จะนำข้อความที่แสดงถึงการเป็นตัวแทนไปวางไว้บนเวบไซค์ของคุณ
    </p>
</section>
<section class="info-group" id="Indemnity">
    <div class="title">
        <span class="text">11. ค่าปรับ</span>
    </div>
    <p class="text text-block">
        คุณได้เห็นด้วยที่จะชดเชยหรือรับผิดชอบในส่วนของความเสียหายที่อาจเกิดขึ้นจากการโปรโมตเวบไซค์ @(siteFriendlyName) ซึ่งคุณได้รับสิทธิ์ที่จะโปรโมตเวบไซค์ @(siteFriendlyName) ในโปรแกรมพันธมิตร ทั้งนี้รวมถึง ผู้อำนวยการ พนักงานออฟฟิต ลูกจ้าง ตัวแทน ผู้ถือหุ้น หุ้นส่วน หรือ เจ้าของอื่น ในการอ้างสิทธิ์ความรับผิดชอบ ในส่วนของการกระทำ หนี้สิน การสูญเสีย ความเสียหาย และค่าใช้จ่ายอื่นอื่น ( รวมถึงค่าธรรมเนียมที่ต้องจ้างนักกฏหมาย ) และต้นทุน ( ในที่นี้รวมถึงทุกเรื่องที่จะทำให้เกิดความสูญเสีย ) ถ้ามีความสูญเสียเกิดขึ้นดังกล่าวตามที่กล่าวข้างต้นเพื่อขอค่าชดเชยที่เกิดจากความเสียหาย เกี่ยวกับการละเมิดลิขสิทธิ์ ทั้งนี้จะอ้างอิง จาก 1.ทุกการอ้างสิทธิ์ของการได้ประโยชน์จากเครื่องหมายการค้าของเรา ชื่อบริษัทของเรา เครื่องหมายการให้บริการของเรา ลิขสิทธิ์ ใบอนุญาติ และทรัพย์สินทางปัญญา หรือ สิทธิ์ประโยชน์อื่นอื่น ทั้งนี้การละเมิดสิทธิ์ในสัญญาฉบับนี้อาจทำให้การเป็นสมาชิกของคุณสิ้นสุดลง และคุณต้องคอยดูแลในส่วนของการพัฒนา การบำรุงรักษา ในส่วนของข้อมูลเกี่ยวกับตัวเวบไซค์ของคุณ และ สินค้าและบริการที่เกิดจากเวบไซค์ของคุณ
    </p>
</section>
<section class="info-group" id="Disclaimers">
    <div class="title">
        <span class="text">12. การปฏิเสธความรับผิดชอบ</span>
    </div>
    <p class="text text-block">
        เราไม่ได้รับประกันในส่วนของการเป้นตัวแทนในโปรแกรมพันธมิตร ที่อ้างอิงถึงลูกค้าที่เข้ามาใช้เวบไซค์ ในส่วนของการจ่ายค่าธรรมเนียม การรับประกันในเรื่องของสัญญาณ หรือการใช้งานของลูกค้าแต่ละคน และ เราไม่ได้รับประกันว่าเวบไซค์ของเราจะไม่มีการขัดข้องหรือถูกรบกวนในเรื่องของการทำงานและผลที่ตามมาอันเกิดจากเวบไซค์ไม่สามารถทำงานได้อย่างมีประสิทธิภาพ
    </p>
</section>
<section class="info-group" id="LimitationOfLiability">
    <div class="title">
        <span class="text">13. ข้อกำหนด ของหนี้สิน</span>
    </div>
    <p class="text text-block">
        เราจะไม่รับผิดชอบในผลของความเสียหายที่อาจจะเกิดขึ้น ที่จะตามมา ในเรื่องของข้อมูลที่เกิดจากความผิดพลาดของการเชื่อมต่อของระบบที่จะเกิดกับลูกค้าที่ได้รับการแนะนำในสัญญาฉบับนี้ ถ้ามีความเสียหายที่เกิดขึ้น ทำให้เป็นที่มาของหนี้สินจะต้องไม่เกินกว่าจำนวนค่าคอมมิชชั่นที่ได้ถูกจ่ายให้ตามสัญญาฉบับนี้ อย่างไรก็ตามสัญญาฉบับนี้ไม่ได้มอบอำนาจ หรือ สิทธิ์ประโยชน์ให้กับบุคคลเป็นการส่วนตัวไม่ว่าจะเป็นผู้อำนวนการหรือ ผู้ถือหุ้น ทุกหนี้สินหรือความเสียหายที่เกิดจากสัญญาฉบับนี้ไม่ว่าจะเป็นค่าธรรมเนียมในการแนะนำได้ถูกกำหนดความเสียหายไว้ในจำนวนที่กำหนดไว้เรียบร้อยแล้ว
    </p>
</section>
<section class="info-group" id="IndependentInvestigation">
    <div class="title">
        <span class="text">14. การสืบสวนสอบสวนโดยอิสระ</span>
    </div>
    <p class="text text-block">
        คุณได้ยอมรับและรับรู้เกี่ยวกับข้อกำหนดต่างต่างในสัญญาฉบับนี้เรียบร้อยแล้ว และคุณเห็นด้วยในกติกาและเงื่อนไขที่ระบุ คุณได้เข้าใจและรับรู้แล้ว ไม่ว่าจะ ทางตรงหรือทางอ้อม กติกาและข้อกำหนดอาจจะแตกต่างจากข้อกำหนดในตัวเวบไซค์ของคุณ คุณได้มีความอิสระที่จะตัดสินใจที่จะเข้าร่วมหรือไม่เข้าร่วมในสัญญาฉบับนี้ ทั้งนี้สัญญาฉบับนี้คุณได้สมัครใจในการเข้าร่วมโปรแกรมพันธมิตรโดยใช้ข้อบังคับตามที่เรากำหนดไว้
    </p>
</section>
<section class="info-group" id="GoverningLawAndArbitration">
    <div class="title">
        <span class="text">15. ข้อกฏหมายที่ออกโดยรัฐบาล</span>
    </div>
    <p class="text text-block">
        ข้อกำหนดในสัญญาฉบับนี้ได้ถูกยอมรับและสร้างขึ้นสอดคล้องกับกฎหมายของประเทศอังกฤษ ถ้ามีข้อโต้แย้งเกิดขึ้น การอ้างสิทธิ์จะได้รับการพิจารณาจากทีมงานกฏหมายของหน่วยงานที่รับผิดชอบ ที่สำหรับการพิจารณาจะอยุ๋ที่ประเทศอังกฤษ และ สถานที่ที่จะใช้ใน การพิจารณาจะอยู่ที่ Arbitration Centre ภาษาที่ใช้ในการพิจารณาคือภาษาอังกฤษ และใช้กฏข้อบังคับของ Arbitration Centre การพิจารณาจะถูกทำอย่างบริสุทธิ์ยุติธรรมและ มีมารยาท การตัดสินการพิจารณาสุดท้ายที่นี่ จะถือว่าสิ้นสุด และสามารถใช้บังคับได้อย่างถูกต้องตามกฏหมาย
    </p>
</section>
<section class="info-group" id="InWitnessWhereOf">
    <div class="title">
        <span class="text">16. ในการเป็นพยาน</span>
    </div>
    <p class="text text-block">
        โดยการอ่านกติกาและเงื่อนไขในสัญญาฉบับนี้ คุณยอมรับว่าลูกค้าที่คุณได้แนะนำผ่านทางเวบไซค์ของคุณได้ยอมรับกติกาและเงื่อนไขที่กำหนดไว้ในเวบไซค์เรียบร้อยแล้ว เวบไซค์ @(siteFriendlyName) ขอสงวนสิทธิ์ที่จะเพิกถอนการจ่ายเงินให้กับบัญชีของคุณ ถ้าหากมีเหตุให้เราทราบว่าคุณได้ทำผิดกติกาและเงื่อนไขที่ระบุไว้ในเวบไซค์นี้
    </p>
</section>