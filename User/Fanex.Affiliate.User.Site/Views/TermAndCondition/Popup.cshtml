@{
    Layout = null;
}
@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.BaseLayoutViewModel
@{
    var htmlString = Html.RenderPartialByLanguage($"~/Views/TermAndCondition/_Content", Model.CurrentLanguage, Model.SiteFriendlyName);
    var siteName = Model.SiteName.ToLower();
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Lang.TermAndCondition</title>
    <link rel="icon" href=@Url.Content("~/favicon-"+ siteName +".ico")>
    <script src="~/www/build/js/lib/jquery-3.3.1.min.js"></script>
    <script>
        window.jQuery || document.write('\x3Cscript src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous">\x3C/script>')
    </script>
    <script src="~/www/build/js/lib/bootstrap.min.js"></script>

    <link href="~/www/build/styles/css/bootstrap-3.3.7.min.css" rel="stylesheet" />

    <link href="~/www/build/styles/fonts/materialdesignicons/font.min.css" rel="stylesheet" type="text/css" />
    <link href="~/www/build/styles/fonts/tahoma/font.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;1,700&display=swap">

    <link href="@Url.RenderLink("~/www/build/styles/css/main.css")" rel="stylesheet" />
    <link href="@Url.RenderLink("~/www/build/styles/css/" + siteName + ".css")" rel="stylesheet" />
</head>
<body>

    <div class="main-container">
        <div class="main">
            <div class="page-container">
                <div class="main-content main-content-left-panel left-panel-popup">
                    @RazorHelper.RenderLeftPanel(Menu.TermAndConditionMenuList)
                    <div class="content">
                        <div class="page-title">
                            <span class="text">@Lang.TermAndCondition</span>
                        </div>

                        @Html.Raw(htmlString)

                        @RazorHelper.RenderMovingTopButton()
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Html.InlineScripts("~/www/build/js/lib/modernizr-webp.js")
    @Html.InlineScripts("~/www/build/js/left-menu-panel.js")
    @Html.InlineScripts("~/www/build/js/pages/term-and-condition.js")

    <script>
        $(window).scroll(function () {
            var topPosition = 111;
            if ($(this).scrollTop() >= topPosition) {
                $(".mobile-left-panel").addClass("fixed");
            }
            else {
                $(".mobile-left-panel").removeClass("fixed");
            }

            if ($(this).scrollTop() > 200) {
                $('#moveToTop').fadeIn(200);
            } else {
                $('#moveToTop').fadeOut(200);
            }
        });
    </script>
</body>
</html>