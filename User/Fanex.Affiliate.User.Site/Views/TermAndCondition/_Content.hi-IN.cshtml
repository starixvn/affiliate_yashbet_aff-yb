@model string
@{
    var siteFriendlyName = Model;
}

<div class="info-group">
    <p class="text-block">
        @(siteFriendlyName) एफिलिएट प्रोग्राम का एफिलिएट बनने के लिए आपको ऑनलाइन फॉर्म भरकर एफिलिएट के रूप में रजिस्टर करना होगा। @(siteFriendlyName) संबद्ध कार्यक्रम के एक सहयोगी के रूप में पंजीकरण करके या बैनर कोड डाउनलोड करके और इसे अपनी वेबसाइट या वेबसाइटों, ईमेल संदेशों या अन्य प्रारूपों पर रखकर, आप इस समझौते में निर्धारित सभी नियमों और शर्तों से बाध्य होने के लिए सहमत हैं।
    </p>
    <p class="text-block">
        यदि आप इस समझौते के सभी नियमों और शर्तों को स्वीकार नहीं करने का निर्णय लेते हैं, तो कृपया बैनर कोड, टेक्स्ट लिंक कोड, प्रचार प्रति या कोई भी डाउनलोड न करें। @(siteFriendlyName) से संबंधित जानकारी।
    </p>
    <p class="text-block">
        यदि हम यह निर्धारित करते हैं कि आपकी साइट अनुपयुक्त है, तो हम इस अनुबंध को समाप्त करने का अधिकार सुरक्षित रखते हैं। अनुपयुक्त साइटों में वे शामिल हो सकते हैं जो: स्पष्ट यौन सामग्री को बढ़ावा देते हैं, बच्चों या नाबालिगों के लिए लक्षित हैं, हिंसा को बढ़ावा देना, जाति, लिंग, धर्म, राष्ट्रीयता, विकलांगता, यौन अभिविन्यास के आधार पर भेदभाव को बढ़ावा देना, अवैध गतिविधियों को बढ़ावा देना, या बौद्धिक संपदा अधिकारों (आईपी अधिकार") का उल्लंघन करना।
    </p>
    <p class="text-block">
        एक नीति के रूप में, @(siteFriendlyName) एक संबद्ध के रूप में पंजीकरण के लिए एक ऑनलाइन आवेदन स्वीकार नहीं करेगा यदि आप इंटरनेट प्रोटोकॉल (आईपी) पतों के साथ विज्ञापन करते हैं या इसके भौगोलिक क्षेत्राधिकार के भीतर से उत्पन्न होते हैं। यूनाइटेड किंगडम।
    </p>
    <p class="text-block">
        यह अनुबंध @(siteFriendlyName) एफिलिएट प्रोग्राम की सदस्यता के सभी नियमों और शर्तों का विवरण देता है। ""आप "", "" संबद्ध "" आपको, सहयोगी के रूप में हमारे साथ पंजीकृत व्यक्ति, समूह या कॉर्पोरेट इकाई को संदर्भित करता है। इस समझौते के तहत, और किसी भी कर्मचारी, अधिकारियों, निदेशकों, शेयरधारकों, मालिकों, नियंत्रण दलों और संबद्ध व्यक्तियों और संस्थाओं को शामिल करने के लिए समझा जाएगा (और "आपके" का एक समान अर्थ है)।
    </p>
</div>
<section class="info-group" id="ResponsibilitiesOfTheAffiliate">
    <div class="title">
        <span class="text">1. संबद्धता की जिम्मेदारियां</span>
    </div>
    <ol>
        <li class="text-block">एक सहयोगी के रूप में आप अपनी वेबसाइटों, ई-मेल या अन्य संचारों पर विज्ञापन, बैनर और ट्रैकिंग URL को लागू करके @(siteFriendlyName) को बढ़ावा देने के लिए जिम्मेदार हैं।</li>
        <li class="text-block">आप @(siteFriendlyName) के साथ सही और सच्ची संपर्क जानकारी को पंजीकृत करने और बनाए रखने के लिए सहमत होंगे।</li>
        <li class="text-block">आप अपनी साइट पर केवल वही सामग्री और विषय प्रस्तुत करेंगे जो @(siteFriendlyName) द्वारा लिखित रूप में पूर्व-अनुमोदित हैं। @(siteFriendlyName) के विवेकाधिकार में अनुपयुक्त मानी जाने वाली सामग्री के परिणामस्वरूप संबद्ध अनुबंध तुरंत समाप्त हो जाएगा।</li>
        <li class="text-block">
            आप अपनी साइट के विकास, संचालन और रखरखाव के लिए और आपकी साइट पर दिखाई देने वाली सभी सामग्रियों के लिए और अपनी लागत पर पूरी तरह जिम्मेदार होंगे। उदाहरण के लिए, आप इसके लिए पूरी तरह जिम्मेदार होंगे यह सुनिश्चित करना कि आपकी साइट पर पोस्ट की गई सामग्री अपमानजनक या अन्यथा अवैध नहीं है या तीसरे पक्ष के आईपी अधिकारों का उल्लंघन करती है। चूंकि आपकी अपनी साइट पर हमारा नियंत्रण नहीं है, इसलिए हम इन मामलों के लिए सभी उत्तरदायित्वों को अस्वीकार करते हैं। क्षतिपूर्ति पर यह प्रावधान बिना किसी पूर्वाग्रह के लागू कानूनों के तहत आपके खिलाफ हम अलग कार्रवाई या दावा कर सकेगे.
        </li>
    </ol>
</section>
<section class="info-group" id="AffiliationGuidelines">
    <div class="title">
        <span class="text">2. संबद्धता दिशानिर्देश</span>
    </div>

    <ol>
        <li class="text-block">केवल स्वीकृत और उचित रूप से टैग की गई रचनात्मक सामग्री, जो समय-समय पर हमारे द्वारा आपूर्ति की जाती है, का उपयोग @(siteFriendlyName) को बढ़ावा देने के लिए किया जा सकता है। विज्ञापन और व्यक्तिगत समर्थन की अनुमति है लेकिन सभी सामग्री द्वारा डिज़ाइन नहीं की गई है @(siteFriendlyName) को लिखित रूप में अनुमोदित करने की आवश्यकता है; ऐसी स्वीकृति को अनुचित रूप से रोका नहीं जाएगा।</li>
        <li class="text-block">आप किसी भी अन्य उद्देश्य के लिए @(siteFriendlyName) की लिखित पूर्व सहमति के बिना हमारे द्वारा आपूर्ति किए गए किसी भी आईपी अधिकार, बैनर या अन्य रचनात्मक सामग्री को संशोधित या उपयोग नहीं कर सकते हैं। किसी भी सामग्री पर सभी कॉपीराइट या आईपी अधिकार नोटिस @(siteFriendlyName) द्वारा आपूर्ति या स्वीकृत बनी रहनी चाहिए और संशोधित या समाप्त नहीं होनी चाहिए।</li>
        <li class="text-block">@(siteFriendlyName) संबद्ध कार्यक्रम में भाग लेने के लिए सहमत होकर, आप बैनर, पाठ या प्रचार सामग्री को डाउनलोड करने और इसे अपनी साइट पर रखने, ई-मेल के भीतर इसका उपयोग करने, अपने सहयोगी का उपयोग करके प्रत्यक्ष विपणन करने के लिए सहमत हो रहे हैं। यूआरएल या प्रिंट। ये विधियाँ ही एकमात्र स्वीकृत विधियाँ हैं जिनके द्वारा आप @(siteFriendlyName) के उत्पादों और सेवाओं का विज्ञापन कर सकते हैं।</li>
        <li class="text-block">बैनर और लिंक अवांछित ई-मेल, अनधिकृत समाचार समूह पोस्टिंग, या चैट रूम या ""बॉट्स" के उपयोग के माध्यम से नहीं रखे जा सकते हैं। अवैध रूप से उत्पन्न ट्रैफ़िक की गणना नहीं की जाएगी और इसका परिणाम हो सकता है हमारे साथ आपके संबद्ध खाते की समाप्ति।</li>
        <li class="text-block">यदि आपकी ओर से किसी भी प्रकार की स्पैमिंग होती है या यदि आप झूठे विज्ञापन, लिखित या बोले गए शब्दों के माध्यम से @(siteFriendlyName) को बदनाम करते हैं, तो हम इस अनुबंध को तुरंत समाप्त कर देंगे।</li>
        <li class="text-block">आप @(siteFriendlyName) के संबंध में कोई दावा, अभ्यावेदन या वारंटी नहीं देंगे और आपके पास किसी भी दायित्व के लिए @(siteFriendlyName) को बाध्य करने का कोई अधिकार नहीं है।</li>
        <li class="text-block">हमारी पूर्व लिखित स्वीकृति के बिना, आप केवल हमारे स्वीकृत बैनर और लिंक का उपयोग करेंगे और उनकी उपस्थिति में बदलाव नहीं करेंगे और न ही किसी भी प्रचार सामग्री में हमें संदर्भित करेंगे। हाइपरटेक्स्ट ट्रांसफर लिंक का स्वरूप और सिंटैक्स हमारे द्वारा डिज़ाइन और नामित किया गया है और इसका एकमात्र गठन है @(siteFriendlyName) का अधिकृत और अनुमत प्रतिनिधित्व।</li>
        <li class="text-block">आप जानबूझकर ज्ञात या संदिग्ध ट्रैफ़िक से लाभान्वित नहीं होंगे जो सद्भाव में उत्पन्न नहीं होता है चाहे वह वास्तव में @(siteFriendlyName) क्षति का कारण बनता है या नहीं। यदि आपके लिंक के माध्यम से किसी भी साइट पर निर्देशित व्यक्ति के माध्यम से धोखाधड़ी की गतिविधि उत्पन्न होती है, तो हम भुगतान किए गए राजस्व हिस्से को वापस लेने का अधिकार रखते हैं। आपको किसी भी समय। इस संबंध में हमारा निर्णय अंतिम होगा और कोई पत्राचार नहीं किया जाएगा। हम इस समझौते के तहत आपके लिए सभी राशियों को रोकने का अधिकार सुरक्षित रखते हैं यदि हमारे पास विश्वास करने का उचित कारण है.</li>
        <li class="text-block">संबद्धों को अपने स्वयं के संबद्ध लिंक के माध्यम से या किसी सहयोगी के संबद्ध लिंक से @(siteFriendlyName) द्वारा प्रचारित किसी भी स्पोर्ट्सबुक में खेलने से प्रतिबंधित किया जाता है जो सहयोगी या तीसरे पक्ष के साथ राजस्व हिस्सेदारी का पूरा या हिस्सा साझा करता है। इसमें कोई भी व्यक्ति शामिल होगा या प्लेइंग ग्रुप जिससे एक एफिलिएट को किसी भी तरह का मुआवजा या पारिश्रमिक मिलता है। इस खंड के उल्लंघन की स्थिति में, @(siteFriendlyName) और संबंधित वेबसाइट जिसके मध्ययाम से खेला गया है, को इस तरह के खेल से लागू होने वाले किसी भी अर्जित राजस्व हिस्सेदारी को समाप्त करने और इस समझौते को समाप्त करने वाले हमारे संबद्ध कार्यक्रम से संबद्धता को समाप्त करने का अधिकार होगा और @(siteFriendlyName) पर भविष्य का कोई भी खेल खेलने से प्रतिबंधित होगा।</li>
        <li class="text-block">आपको @(siteFriendlyName) के साथ संबद्ध और रेफ़रल संबंध दोनों को समवर्ती रूप से बनाए रखने की अनुमति नहीं है। इस प्रावधान का उल्लंघन @(siteFriendlyName) को एकतरफा या दोनों संबद्ध और/या रेफरल संबंधों को समाप्त करने का अधिकार देता है। एक रेफरल संबंध, @(siteFriendlyName) के रेफर-ए-फ्रेंड प्रोग्राम (जैसा कि सेटआउट और वेबसाइट में उपलब्ध है) के अनुसार @(siteFriendlyName) के साथ संबंध को संदर्भित करता है।</li>
    </ol>
</section>
<section class="info-group" id="AffiliateTagging">
    <div class="title">
        <span class="text">3. संबद्ध टैगिंग</span>
    </div>
    <ol>
        <li class="text-block">केवल आप ग्राहकों को @(siteFriendlyName) वेबसाइट पर निर्देशित करने के लिए जिम्मेदार हैं।</li>
        <li class="text-block">केवल ठीक से टैग किए गए ग्राहकों को ही किसी संबद्ध को सौंपा जा सकता है। यदि संबद्ध टैग को अनुचित तरीके से संबद्ध साइट में डाला जाता है या @(siteFriendlyName) वेब सर्वर द्वारा ठीक से प्राप्त नहीं किया जाता है, तो परिणामी ग्राहक पंजीकरण और खरीदारी संबद्ध को नहीं सौंपी जाएगी। इसलिए यह संबद्ध की जिम्मेदारी है कि वह ये सुनिश्चित करे कि सभी लिंक ठीक से टैग किए गए हैं।</li>
    </ol>
</section>
<section class="info-group" id="RevenueSharingAndPayment">
    <div class="title">
        <span class="text">4. रेवेन्यू शेयरिंग एवं पेमेंट</span>
    </div>
    <ol>
        <li class="text-block">@(siteFriendlyName) प्रत्येक ग्राहक को एक समान राजस्व हिस्सेदारी का भुगतान करेगा, जैसा कि @(siteFriendlyName) एफिलिएट प्रोग्राम रेवेन्यू शेयर स्ट्रक्चर द्वारा परिभाषित किया गया है, बशर्ते कि आप अपने खाते में किसी भी कैलेंडर माह में कम से कम पांच (5) सक्रिय खिलाड़ियों को एक सहयोगी के रूप में बनाए रखें। हालांकि, @(siteFriendlyName) किसी भी विशेष महीने में, चाहे आंशिक रूप से या पूर्ण रूप से, 5 सक्रिय सदस्यों की परवाह किए बिना, संबद्ध राजस्व हिस्सेदारी भुगतान को रोकने का अधिकार सुरक्षित रखेगा। यदि संबद्ध पाया जाता है कि वह 2 महीने से अधिक समय तक @(siteFriendlyName) को बढ़ावा देने का प्रयास नहीं करता है, जैसा कि कोई नया दांव लगाने वाले सदस्यों में नहीं लाया गया है; संबद्ध वेबसाइट पर @(siteFriendlyName) बैनरों की कमी; और या किसी अन्य ऑनलाइन और ऑफलाइन प्रचार गतिविधियों की कमी देखी गई। राजस्व हिस्सेदारी तब तक रोक दी जाएगी जब तक कि संबद्ध खाते में नए दांव लगाने वाले सदस्य दिखाई न दें, जहां @(siteFriendlyName) के पास संबद्ध को पूर्ण या आंशिक रूप से रोके गए राजस्व हिस्से को जारी करने का एकमात्र विवेक होगा। कोई भी राजस्व हिस्सेदारी जिसे 6 महीने से अधिक की अवधि के लिए रोक दिया गया है, उसे @(siteFriendlyName) के विवेक पर रद्द किया जा सकता है।</li>
        <li class="text-block">
            <p class="text text-block">
                राजस्व हिस्सेदारी की गणना @(siteFriendlyName) लाभ, कम शुल्क-वापसी, मानार्थ धन, मुफ्त पैसे की पेशकश और ग्राहक को दिए जाने वाले अन्य प्रोत्साहनों के रूप में की जाती है, जो एक कैलेंडर माह में कम से कम पांच (5) सक्रिय खिलाड़ियों से प्राप्त होते हैं।
            </p>
            <ol type="a">
                <li>
                    <p class="text text-block">शुल्क-वापसी: एक क्रेडिट कार्ड धारक को अपने क्रेडिट/डेबिट कार्ड पर किए गए अनियमित लेन-देन का पता चलता है, जो उसके द्वारा अधिकृत नहीं था। क्रेडिट कार्ड धारक तब अपने बैंक से इन शुल्कों को वापस करने का अनुरोध करता है। चार्ज बैक संबंधित है क्रेडिट कार्ड धारक के कार्ड या कार्ड नंबर के तीसरे पक्ष द्वारा कपटपूर्ण उपयोग।</p>
                    <p class="text text-block">"@(siteFriendlyName) ग्रॉस विन एक कैलेंडर माह में आपके संबद्ध खाते के तहत कम से कम पांच (5) सक्रिय खिलाड़ियों द्वारा दांव पर लगाई गई सभी राशियों का योग है, आपके सक्रिय दांव लगाने वाले सदस्यों द्वारा जीती गई या भुगतान की गई सभी राशियों को घटाकर।</p>
                    <p class="text text-block">चार्ज-बैक की कटौती तब की जाती है जब कोई ग्राहक जो क्रेडिट कार्ड धारक है, ग्राहक के क्रेडिट/डेबिट कार्ड पर किए गए अनियमित अनधिकृत चार्ज-बैक का पता लगाता है, और क्रेडिट कार्ड धारक बैंक से इन शुल्कों को वापस करने का अनुरोध करता है। चार्ज-बैक संबंधित हो सकता है , लेकिन क्रेडिट कार्ड धारक के कार्ड या कार्ड नंबर के तीसरे पक्ष द्वारा कपटपूर्ण उपयोग तक सीमित नहीं हैं।</p>
                </li>
                <li>
                    <p class="text text-block">क्या खिलाड़ी को शुल्क वापस संसाधित करना चाहिए, विवादित या चार्ज-बैक राजस्व जब्त कर लिया जाएगा और इसलिए चालू माह के लिए आपके कारण कुल शेष राशि से काट लिया जाएगा। यदि संचित राजस्व की यह कटौती आपकी वर्तमान राशि से अधिक हो जाती है, तो आपकी शेष राशि एक ऋणात्मक शेष राशि हो जाएगी , और इससे पहले कि आप फिर से राजस्व अर्जित करना शुरू कर सकें, आपको शुल्क-वापसी को कवर करने के लिए राजस्व अर्जित करना होगा।</p>
                    <p class="text text-block">चार्ज बैक तब तक देय रहेगा जब तक कि आपके अन्य खिलाड़ियों द्वारा उत्पन्न राजस्व देय राशि को कवर नहीं कर लेता। आप स्वीकार करते हैं कि @(siteFriendlyName) अपने वास्तविक लाभ का केवल एक प्रतिशत भुगतान कर सकता है, धोखाधड़ी से होने वाली आय का नहीं।</p>
                    <p class="text text-block">बोनस में कॉम्प्लिमेंट्री मनी, फ्री मनी ऑफर, क्रेडिट, साइन-अप बोनस, प्रमोशनल अमाउंट और ग्राहकों के खाते में क्रेडिट किए गए अन्य इंसेंटिव शामिल हैं। चूंकि ग्राहकों ने वास्तव में इन राशियों को नहीं खरीदा है, @(siteFriendlyName) उसी पर राजस्व हिस्सेदारी का भुगतान नहीं कर सकता है।</p>
                </li>
            </ol>
        </li>
        <li class="text-block">यदि आप किसी दिए गए महीने में कम से कम पांच (5) सक्रिय खिलाड़ियों को बनाए रखने में विफलता के लिए उपरोक्त खंड 4.1 और 4.2 के अनुसार राजस्व हिस्सेदारी के हकदार होने में विफल रहते हैं, तो आप महीने में कोई राजस्व हिस्सेदारी नहीं उत्पन्न करेंगे और संबंधित सदस्य के खोए हुए को अगले महीनों के लिए आगे नहीं लाया जाएगा।</li>
        <li class="text-block">राजस्व हिस्सेदारी राजस्व हिस्सेदारी के अधीन होगी, जैसा कि समय-समय पर लागू @(siteFriendlyName) संबद्ध कार्यक्रम राजस्व हिस्सेदारी संरचना का उपयोग करके गणना की जाती है।</li>
        <li class="text-block">नकारात्मक आय को अगले महीने के लिए आगे ले जाया जाता है। क्या संबद्ध महीने को सकारात्मक शेष राशि के साथ बंद कर देता है, भुगतान जारी किया जाएगा यदि यह न्यूनतम आवश्यकताओं को पूरा करता है और सकारात्मक शेष पर राजस्व हिस्सेदारी का भुगतान किया जाएगा।</li>
        <li class="text-block">राजस्व हिस्सेदारी संरचना के आधार पर गणना की गई संबद्ध का राजस्व हिस्सा उन सभी लेनदेन पर अर्जित किया जाएगा जो ग्राहक व्यापारी के साथ करता है, जब तक कि सहयोगी इस संबद्ध कार्यक्रम का सदस्य बना रहता है।</li>
    </ol>
</section>
<section class="info-group" id="PoliciesAndConfidentiality">
    <div class="title">
        <span class="text">5. नीतियां और गोपनीयता</span>
    </div>
    <ol>
        <li class="text-block">@(siteFriendlyName) ग्राहक के साथ पहले संपर्क के बिंदु पर ग्राहक का स्वामित्व ग्रहण करता है। आप, सहयोगी के रूप में, @(siteFriendlyName) के लिए एक रेफ़रिंग एजेंट के रूप में कार्य करते हैं। हम किसी भी आवश्यकता का अनुपालन करने के लिए आवश्यक होने पर ग्राहकों को मना करने (या उनके खाते बंद करने) का अधिकार सुरक्षित रखते हैं। हम समय-समय पर स्थापित कर सकते हैं।</li>
        <li class="text-block">किसी ग्राहक के साथ खाता खोलने से, वह व्यक्ति या संस्था हमारे ग्राहक बन जाएंगे और तदनुसार, सभी ग्राहक नियम, नीतियां और संचालन प्रक्रियाएं उन पर भी लागू होंगी।</li>
        <li class="text-block">इस अनुबंध की अवधि के दौरान, आपको हमारे संबद्ध कार्यक्रम के व्यवसाय, संचालन, या अंतर्निहित तकनीक से संबंधित गोपनीय जानकारी सौंपी जा सकती है (उदाहरण के लिए, अर्जित रेफ़रल शुल्क सहित)। आप सहमत हैं कि गोपनीय जानकारी को तीसरे व्यक्ति या बाहरी पक्षों को तब तक प्रकट या उपयोग न करें जब तक कि आपके पास हमारी पूर्व लिखित सहमति न हो और आप गोपनीय जानकारी का उपयोग केवल इस समझौते के उद्देश्यों को आगे बढ़ाने के लिए आवश्यक जरूरतें के लिए करेंगे। गोपनीय जानकारी के संबंध में आपके दायित्व इस अनुबंध की समाप्ति तक बने रहेंगे।</li>
    </ol>
</section>
<section class="info-group" id="LimitedLicense">
    <div class="title">
        <span class="text">6. सीमित लाइसेंस</span>
    </div>
    <ol>
        <li class="text-block">हम इस अनुबंध की अवधि के दौरान आपको एक व्यक्तिगत, गैर-अनन्य, गैर-हस्तांतरणीय सीमित लाइसेंस प्रदान करते हैं, केवल हमारे ट्रेडमार्क का उपयोग करने के लिए (लाइसेंस, बदले में, उनके मालिक से) केवल प्रदर्शन के संबंध में आपकी साइट पर बैनर।</li>
        <li class="text-block">इस अनुबंध के द्वारा, हम आपको इस अनुबंध के नियमों और शर्तों के अनुसार ग्राहकों को हमारी वेबसाइट और सेवाओं पर निर्देशित करने का गैर-अनन्य अधिकार प्रदान करते हैं। यह अनुबंध आपको आपके रेफरल से उत्पन्न होने वाली सेवाओं के प्रावधान में हमारी सहायता करने के लिए एक विशेष अधिकार या विशेषाधिकार प्रदान नहीं करता है और हम किसी भी समय समान या समान सेवाओं को करने के लिए अन्य पार्टियों के साथ अनुबंध करने और सहायता प्राप्त करने का अधिकार सुरक्षित रखते हैं। आपके अलावा अन्य व्यक्तियों या संस्थाओं द्वारा या उनके माध्यम से सुरक्षित व्यापार पर रेफरल शुल्क या अन्य मुआवजे के लिए आपका कोई दावा नहीं होगा।</li>
        <li class="text-block">यह लाइसेंस आपके द्वारा उप-लाइसेंस, असाइन या अन्यथा हस्तांतरित नहीं किया जा सकता है। ट्रेडमार्क का उपयोग करने का आपका अधिकार केवल बैनर का उपयोग करने के लिए इस लाइसेंस तक सीमित है और उत्पन्न होता है। आप अमान्यता, अप्रवर्तनीयता का दावा नहीं करेंगे या अन्य किसी भी प्रकार या प्रकृति की कार्रवाई मे ट्रेडमार्क के स्वामित्व का विरोध नहीं करेंगे और ऐसी कोई कार्रवाई नहीं करेंगे जो ट्रेडमार्क में हमारे या हमारे लाइसेंसकर्ता के अधिकारों पर प्रतिकूल प्रभाव डाले, उसी सामान्य को प्रस्तुत करें या अन्यथा यह उनकी वैधता और उनकी संबद्ध सद्भावना को कमजोर करते हैं।</li>
        <li class="text-block">हम किसी भी समय इस लाइसेंस को रद्द करने का अधिकार सुरक्षित रखते हैं और किसी भी कारण से इस समझौते की समाप्ति पर इसे निरस्त माना जाएगा।</li>
    </ol>
</section>
<section class="info-group" id="LegalResponsibility">
    <div class="title">
        <span class="text">7. कानूनी जिम्मेदारी</span>
    </div>
    <ol>
        <li class="text-block">हमारी साइटों का स्वामित्व और सामग्री हमारी संबंधित संपत्तियां हैं और संबद्धता समझौते के संबंध में किसी भी अधिनियम या चूक के माध्यम से संबद्ध को हस्तांतरित नहीं माना जाएगा।</li>
        <li class="text-block">संबद्ध साइटों के लिए स्वामित्व, सामग्री और दायित्व सहबद्ध की एकमात्र जिम्मेदारी है। आप अपनी साइट के विकास, संचालन और रखरखाव और आपकी साइट पर दिखाई देने वाली सभी सामग्रियों और लागत के लिए आप पूरी तरह से जिम्मेदार होंगे।</li>
        <li class="text-block">आप अपनी साइट के विकास, संचालन, रखरखाव और सामग्री से संबंधित सभी दावों, क्षतियों और खर्चों (जिसमें, बिना किसी सीमा के, वकीलों की फीस सहित) के लिए क्षतिपूर्ति करेंगे और हमें हानिरहित रखेंगे। क्षतिपूर्ति पर यह प्रावधान हमारे पूर्वाग्रह के बिना है लागू कानूनों के तहत आपके खिलाफ अलग कार्रवाई या दावा।</li>
        <li class="text-block">नए ग्राहक ट्रैकिंग और भुगतान को सुनिश्चित करने के लिए सही लिंकिंग और टैगिंग प्रक्रिया का पालन करना सहयोगी कंपनियों की जिम्मेदारी है।</li>
        <li class="text-block">सहबद्ध की साइट पर हमारे बैनर और सामग्री की प्रस्तुति सहबद्ध की जिम्मेदारी है। सहयोगी को यह सुनिश्चित करना चाहिए कि हमारी सामग्री हमारे नुस्खे के अनुसार प्रस्तुत की गई है।</li>
        <li class="text-block">संबद्ध को यह सुनिश्चित करना चाहिए कि उनकी साइट पर पोस्ट की गई कोई भी सामग्री कानूनी है और कॉपीराइट का उल्लंघन नहीं करती है या किसी भी अधिकार का उल्लंघन नहीं करती है।</li>
        <li class="text-block">हम इस समझौते में निहित किसी भी नियम और शर्तों को किसी भी समय और हमारे विवेकाधिकार में, हमारी साइट पर एक परिवर्तन नोटिस या एक नया अनुबंध पोस्ट करके संशोधित कर सकते हैं। संशोधनों में शामिल हो सकते हैं, उदाहरण के लिए, उपलब्ध रेफ़रल शुल्क, शुल्क अनुसूचियों, भुगतान प्रक्रियाओं और रेफ़रल कार्यक्रम नियमों के दायरे में परिवर्तन। यदि कोई संशोधन आपको अस्वीकार्य है, तो आपका एकमात्र सहारा इस अनुबंध को समाप्त करना है। हमारी साइट पर एक परिवर्तन नोटिस या नए समझौते की पोस्टिंग के बाद कार्यक्रम में आपकी निरंतर भागीदारी परिवर्तन की बाध्यकारी स्वीकृति होगी।</li>
        <li class="text-block">
            <p>स्पैम - हम स्पैम की निंदा नहीं करते हैं।</p>
            <ol type="a">
                <li class="text-block">किसी भी प्रकार के स्पैम के परिणामस्वरूप आपके खाते की समीक्षा की जाएगी और आपके खाते की जांच लंबित रहने तक सभी धनराशि रोक दी जाएगी। आपको इस बात से अवगत होना चाहिए कि हमारे ग्राहक स्पैम उत्पन्न मेल से निपटने के लिए खर्च करने के लिए उत्तरदायी हैं और हमारे ग्राहक द्वारा सहारा लेने पर ये वही खर्च आपके खाते से काट लिए जाएंगे। इस उदाहरण में रिश्तेदार ग्राहक द्वारा निर्धारित राशि उचित होगी और सद्भाव के आधार पर अंतिम और स्वीकार्य मानी जाएगी और ऐसी राशि कानून द्वारा संग्रहणीय होगी और इसे आपके द्वारा उचित और उचित के रूप में स्वीकार किया गया माना जाएगा और जैसा कि पंजीकरण द्वारा सहमति व्यक्त की गई है। सहबद्ध @(siteFriendlyName) का।</li>
                <li class="text-block">यदि इन खर्चों को आपके खाते में निधियों द्वारा कवर नहीं किया जाता है, तो हम भुगतान प्राप्त करने के लिए अन्य वैकल्पिक साधनों की जांच करने का अधिकार सुरक्षित रखते हैं, उदाहरण के लिए: यदि आपके खाते में क्रय खाते हैं, तो हम इन खातों के लिए राजस्व हिस्सेदारी का भुगतान तब तक रखेंगे जब तक कि खाते के रूप में नुकसान के लिए मंजूरी दे दी गई है। यदि आपका खाता सक्रिय नहीं है और राजस्व हिस्सेदारी भुगतान के माध्यम से लाभ अर्जित कर रहा है तो हम खाताधारक से भुगतान की मांग करने का अधिकार सुरक्षित रखते हैं।</li>
            </ol>
        </li>
        <li class="text-block">आप और हम स्वतंत्र ठेकेदार हैं, और इस समझौते में कुछ भी पार्टियों के बीच कोई साझेदारी, संयुक्त उद्यम, एजेंसी, मताधिकार, बिक्री प्रतिनिधि, या रोजगार संबंध नहीं बनाएगा। आपके पास कोई भी प्रस्ताव या प्रतिनिधित्व करने या स्वीकार करने का कोई अधिकार नहीं होगा। आप अपनी साइट पर या अन्यथा कोई भी बयान नहीं देंगे, जो इस अनुच्छेद में किसी भी बात का यथोचित खंडन करेगा।</li>
    </ol>
</section>
<section class="info-group" id="Miscellaneous">
    <div class="title">
        <span class="text">8. विविध</span>
    </div>
    <ol>
        <li class="text-block">
            <p>समनुदेशन-क्षमता और कठोरता</p>
            <p class="text-block">आप हमारी पूर्व लिखित सहमति के बिना, कानून के संचालन द्वारा या अन्यथा, इस समझौते को असाइन नहीं कर सकते हैं। उस प्रतिबंध के अधीन, यह समझौता आपके और हमारे और हमारे संबंधित उत्तराधिकारियों के लिए बाध्यकारी, लाभ के लिए और लागू करने योग्य होगा और असाइन करता है।</p>
        </li>
        <li class="text-block">
            <p>गैर छूट</p>
            <p class="text-block">इस समझौते के किसी भी प्रावधान के आपके सख्त प्रदर्शन को लागू करने में हमारी विफलता इस तरह के प्रावधान या इस समझौते के किसी अन्य प्रावधान को बाद में लागू करने के हमारे अधिकार की छूट का गठन नहीं करेगी। इस समझौते के किसी भी संशोधन, परिवर्धन, विलोपन या अंतःक्रिया की अनुमति नहीं है या नहीं होगी हमारे द्वारा मान्यता प्राप्त हो। हमारा कोई भी कर्मचारी, अधिकारी या एजेंट इस समझौते के किसी प्रावधान को मौखिक रूप से बदल, संशोधित या माफ नहीं कर सकता है।</p>
        </li>
        <li class="text-block">
            <p>उपचार</p>
            <p class="text-block">इसके तहत हमारे अधिकार और उपचार परस्पर अनन्य नहीं होंगे, अर्थात, इस समझौते के एक या अधिक प्रावधानों का प्रयोग किसी अन्य प्रावधान के प्रयोग को नहीं रोकेगा। आप स्वीकार करते हैं, पुष्टि करते हैं और सहमत होते हैं कि इस समझौते के उल्लंघन या धमकी भरे उल्लंघन के लिए नुकसान अपर्याप्त हो सकता है और इस समझौते के किसी भी प्रावधान के उल्लंघन या धमकी के उल्लंघन की स्थिति में, पार्टियों के संबंधित अधिकार और दायित्व हो सकते हैं विशिष्ट प्रदर्शन, निषेधाज्ञा, या अन्य न्यायसंगत उपाय द्वारा लागू करने योग्य। इस समझौते में निहित कुछ भी कानून में हमारे किसी भी अधिकार को सीमित या प्रभावित नहीं करेगा, या अन्यथा, इस समझौते के किसी भी प्रावधान के उल्लंघन या धमकी के उल्लंघन के लिए, इस प्रावधान का इरादा यह स्पष्ट करना है कि हमारे संबंधित अधिकार और दायित्व होंगे इक्विटी के साथ-साथ कानून या अन्यथा में लागू करने योग्य।</p>
        </li>
        <li class="text-block">
            <p>पृथक्करणीयता / छूट</p>
            <p class="text-block">जब भी संभव हो, इस समझौते के प्रत्येक प्रावधान की व्याख्या इस तरह से की जाएगी कि लागू कानून के तहत प्रभावी और वैध हो, लेकिन अगर इस समझौते के किसी भी प्रावधान को किसी भी तरह से अमान्य, अवैध या अप्रवर्तनीय माना जाता है, तो ऐसा प्रावधान अप्रभावी होगा केवल इस तरह की अमान्यता, या अप्रवर्तनीयता की सीमा तक, इस अनुबंध के शेष भाग या इसके किसी प्रावधान को अमान्य किए बिना। आचरण या किसी भी अधिकार को लागू करने में विफलता से कोई छूट नहीं दी जाएगी और प्रभावी होने के लिए लिखित रूप में होना चाहिए।</p>
        </li>
    </ol>
</section>
<section class="info-group" id="TermAndTermination">
    <div class="title">
        <span class="text">9. टर्म एंड टर्मिनेशन</span>
    </div>
    <ol>
        <li class="text-block">इस अनुबंध की अवधि तब शुरू होगी जब आप लिंकिंग कोड डाउनलोड करेंगे और इसे हमारी साइट से लिंक करेंगे और तब तक जारी रहेंगे जब तक कि कोई भी पक्ष दूसरे पक्ष को लिखित रूप में सूचित नहीं करता कि वह अनुबंध को समाप्त करना चाहता है, इस स्थिति में यह अनुबंध तुरंत समाप्त किया जा सकता है। समाप्ति किसी भी कारण से, किसी भी पक्ष द्वारा इच्छा पर है। समाप्ति की अधिसूचना के प्रयोजनों के लिए, ई-मेल के माध्यम से वितरण को अधिसूचना का एक लिखित और तत्काल रूप माना जाता है।</li>
        <li class="text-block">
            <p>इस समझौते की समाप्ति की स्थिति में:</p>
            <ol type="a">
                <li class="text-block">आपको अपनी साइट से @(siteFriendlyName) के बैनर को हटाना होगा और अपनी साइट से @(siteFriendlyName) के किसी भी लिंक को अक्षम करना होगा।</li>
                <li class="text-block">इस अनुबंध में आपको दिए गए सभी अधिकार और लाइसेंस तुरंत समाप्त हो जाएंगे।</li>
                <li class="text-block">आप केवल उन अवैतनिक रेफरल शुल्क के हकदार होंगे यदि आपके द्वारा समाप्ति की तारीख को या उससे पहले अर्जित किया गया है, जहां समाप्ति इस समझौते की शर्तों के उल्लंघन के परिणामस्वरूप है, जैसा कि नीचे 9.2.d पर विस्तृत है। हम यह सुनिश्चित करने के लिए कि सही राशि का भुगतान किया गया है, आपके अंतिम भुगतान को उचित समय के लिए रोक सकता है।</li>
                <li class="text-block">यदि आप अपने दायित्वों और जिम्मेदारियों को पूरा करने में विफल रहे हैं, तो हम आपको रेफ़रल शुल्क का भुगतान नहीं करेंगे अन्यथा समाप्ति पर आपके कारण।</li>
                <li class="text-block">हम आपके अंतिम भुगतान को उचित समय के लिए रोक सकते हैं ताकि यह सुनिश्चित हो सके कि सही राशि का भुगतान किया गया है।</li>
                <li class="text-block">यदि हम समाप्ति के बाद भी ग्राहकों से गतिविधि (राजस्व उत्पन्न करना) की अनुमति देना जारी रखते हैं, तो यह इस अनुबंध की निरंतरता या नवीनीकरण या समाप्ति की छूट का गठन नहीं करेगा।</li>
                <li class="text-block">आप हमें किसी भी गोपनीय जानकारी और उसकी सभी प्रतियां अपने कब्जे, हिरासत और नियंत्रण में वापस कर देंगे और व्यापारियों के किसी भी व्यापार नाम, ट्रेडमार्क, सेवा चिह्न, लोगो और अन्य पदनामों के सभी उपयोग बंद कर देंगे।</li>
                <li class="text-block">आप और हम इस तरह की समाप्ति की तारीख के बाद होने वाले या उत्पन्न होने वाले सभी दायित्वों और देनदारियों से मुक्त हो जाएंगे, उन दायित्वों के संबंध में जो उनकी प्रकृति द्वारा इस समझौते में निर्धारित समाप्ति से बचने के लिए डिज़ाइन किए गए हैं। समाप्ति होगी इस समझौते के किसी भी उल्लंघन से उत्पन्न होने वाले किसी भी दायित्व से आपको राहत नहीं देता है, जो समाप्ति से पहले हुआ था।</li>
                <li class="text-block">यदि हम यह निर्धारित करते हैं कि आपकी साइट अनुपयुक्त है, तो हम इस समझौते को समाप्त कर सकते हैं। अनुपयुक्त साइटों में वे शामिल हो सकते हैं: बच्चों के लिए लक्षित, स्पष्ट यौन सामग्री को बढ़ावा देना, हिंसा को बढ़ावा देना, जाति, लिंग, धर्म के आधार पर भेदभाव को बढ़ावा देना। , राष्ट्रीयता, विकलांगता, यौन अभिविन्यास, या उम्र, अवैध गतिविधियों को बढ़ावा देना, या बौद्धिक संपदा अधिकारों का उल्लंघन करना।</li>
            </ol>
        </li>
    </ol>
</section>
<section class="info-group" id="RelationshipOfParties">
    <div class="title">
        <span class="text">10. पार्टियों का रिश्ता</span>
    </div>
    <p class="text text-block">
        आप और हम स्वतंत्र ठेकेदार हैं, और इस समझौते में कुछ भी पार्टियों के बीच कोई साझेदारी, संयुक्त उद्यम, एजेंसी, मताधिकार, बिक्री प्रतिनिधि, या रोजगार संबंध नहीं बनाएगा। आपके पास कोई भी प्रस्ताव या प्रतिनिधित्व करने या स्वीकार करने का कोई अधिकार नहीं होगा। की ओर से। आप अपनी साइट पर या अन्यथा कोई बयान नहीं देंगे, या इस अनुच्छेद का खंडन करने के लिए उचित रूप से समझा जाएगा।
    </p>
</section>
<section class="info-group" id="Indemnity">
    <div class="title">
        <span class="text">11. क्षतिपूर्ति</span>
    </div>
    <p class="text text-block">
