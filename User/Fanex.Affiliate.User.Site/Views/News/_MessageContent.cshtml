@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.MessageHistoryViewModel
@{
    var hasData = Model.MessageList != null && Model.MessageList.Any();
}

<div class="table overview-table">
    <table>
        <thead>
            <tr class="overview-table-header">
                <th width="3%"></th>
                <th width="10%">@Lang.ID</th>
                <th width="30%">@Lang.PostDate</th>
                <th width="50%">@Lang.Message</th>
            </tr>
        </thead>
        <tbody>
            @if (hasData)
            {
                var index = (int)ViewBag.StartRowNumber;

                foreach (var item in Model.MessageList)
                {
                    <tr>
                        <td class="text-center">@index</td>
                        <td class="text-center">@item.MsgId</td>
                        <td class="text-center">@item.PostedDate.ToString("MM/dd/yyyy hh:mm:ss")</td>
                        <td class="text-left" @(item.Important ? "style=color:red;" : string.Empty)>@Html.Raw(item.Message)</td>
                    </tr>

                    index++;
                }
            }
            else
            {
                <tr>
                    <td class="text-center no-info" colspan="7">@Lang.NoInfo</td>
                </tr>
            }
        </tbody>
    </table>
    <input id="TotalItem" type="hidden" value="@Model.TotalItems" />
</div>
