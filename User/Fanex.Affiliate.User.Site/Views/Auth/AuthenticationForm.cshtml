@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.AuthenticationFormViewModel

<div id="userLogin">
    @if (!Model.IsAuthenticated)
    {
        <div class="login-before user-login">
            <div class="group">
                <span class="mdi mdi-account"></span>
                <div class="text-field">
                    <input id="txtUsername" type="text" placeholder="@Lang.Username" />
                </div>
            </div>
            <div class="group">
                <span class="mdi mdi-lock"></span>
                <div class="text-field">
                    <input id="txtPassword" type="password" placeholder="@Lang.Password" />
                    <a class="btn-forgot" tabindex="-1" href="@Url.Content("~/Password")">@Lang.Forgot</a>
                </div>
            </div>
            <div class="group">
                <span class="mdi mdi-edit"></span>
                <div class="text-field field-validate">
                    <input class="validation" id="txtValidation" type="text" placeholder="@Lang.Validation" />
                </div>
            </div>
            
            <div class="validation-value"><img src="@Url.Content("~/Auth/CaptchaImage")" alt="captcha" id="captchaImg" /></div>
            @*<a class="btn btn-forgot" href="@Url.Content("~/Password")">
                <span class="mdi mdi-lock-open"></span>
                <span class="title-forgot">@Lang.ForgetPassword</span>
            </a>*@
            @Html.AntiForgeryToken()
            @if (!string.IsNullOrEmpty(Model.PublicKey))
            {
                @Html.Hidden("PublicKey", Model.PublicKey)
            }
        </div>
    }
</div>