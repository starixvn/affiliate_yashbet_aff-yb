@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.AuthenticationFormViewModel

<div id="userLogin">
    @if (!Model.IsAuthenticated)
    {
        <div class="login-before user-login">
            <div class="group">
                <span class="mdi mdi-account"></span>
                <input class="text-field" id="txtUsername" type="text" placeholder="@Lang.Username" />
            </div>
            <div class="group">
                <span class="mdi mdi-lock"></span>
                <input class="text-field" id="txtPassword" type="password" placeholder="@Lang.Password" />
            </div>
            <input class="text-field validation" id="txtValidation" type="text" placeholder="@Lang.Validation" />
            <div class="validation-value"><img src="@Url.Content("~/Auth/CaptchaImage")" alt="captcha" id="captchaImg" /></div>
            <a class="btn btn-forgot" href="@Url.Content("~/Password")">
                <span class="mdi mdi-lock-open"></span>
                <span class="title-forgot">@Lang.ForgetPassword</span>
            </a>
            @Html.AntiForgeryToken()
            @if (!string.IsNullOrEmpty(Model.PublicKey))
            {
                @Html.Hidden("PublicKey", Model.PublicKey)
            }
        </div>
    }
</div>