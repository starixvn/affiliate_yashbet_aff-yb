@model IEnumerable<Fanex.Affiliate.User.Core.DTO.SecurityQuestion>


<label class="custom-label require">@Lang.lblSecureQuestion</label>
<select class="form-input form-select" name="QuestionId" id="QuestionId" data-val="true" data-val-required="@Lang.errSecQuestionEmpty">
    <option value="">@Lang.SelectOne</option>
    @foreach (var item in Model)
    {
        <option value="@item.QuestionId">@item.Question</option>
    }
</select>