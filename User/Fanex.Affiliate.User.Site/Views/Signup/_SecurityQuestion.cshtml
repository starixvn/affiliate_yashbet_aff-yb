@model IEnumerable<Fanex.Affiliate.User.Core.DTO.SecurityQuestion>

<label class="col-sm-3 control-label require">@Lang.lblSecureQuestion</label>
<div class="col-sm-4">
    <select class="form-control" name="QuestionId" id="QuestionId" data-val="true" data-val-required="@Lang.errSecQuestionEmpty">
        <option value="">@Lang.SelectOne</option>
        @foreach (var item in Model)
        {
            <option value="@item.QuestionId">@item.Question</option>
        }
    </select>
</div>