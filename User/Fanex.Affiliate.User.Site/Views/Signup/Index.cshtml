@{
    ViewBag.Title = Lang.Signup;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";

    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var languageService = DependencyResolver.Current.GetService<ILanguageService>();
    var currentLanguage = sessionService.CurrentLanguage;
}

@using Fanex.Affiliate.User.Core.CoreService
@using Fanex.Affiliate.User.Core.BusinessService

@model Fanex.Affiliate.User.Core.MetalModels.UserSignUpParam

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/signup.css")
}

@section scripts{
    <script>
        var resourceLanguage = {
            webSiteUrl: '@Lang.WebsiteURL',
            requiredMoreWebSiteUrl: '@Lang.WebsiteUrli',
            generalError: '@Error.General',
            deleteLabel: '@Lang.Del'
        }
    </script>
    <script src="@Url.RenderLink("~/www/build/js/validation.js")"></script>
    @Html.InlineScripts("~/www/build/js/signup.js")
}

<div class="content sign-up-page">
    @if (Model.IsValidParentCode)
    {
        <div class="page-title">
            <span class="text">@Lang.RegisForm</span>
        </div>

        <div class="alert alert-success" role="alert" id="messageSuccess" style="display: none;">
            <p class="text-center"><b>@Html.Raw(Lang.UnderReview)</b></p>
            @Html.Raw(string.Format(SiteFriendlyNameHelper.ReplaceB2C(Lang.RegisSuccess), Url.Content("~/ContactUs")))
        </div>

        <div class="alert alert-danger" role="alert" id="messageError" style="display: none"></div>

        <div id="mainContent">
            <div>
                <p>@SiteFriendlyNameHelper.ReplaceB2C(Lang.CompleteForm)</p>
                <p>@Html.Raw(Lang.RequireInfo)</p>
            </div>

            @using (Html.BeginForm("Index", "Signup", FormMethod.Post, new { @id = "accountForm", @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                <div class="info-group">
                    <div class="title">
                        <span class="text">@Lang.ContactInfo</span>
                    </div>

                    <div class="form-group half-col half-col-left ">
                        <label class="col-sm-3 control-label require">@Lang.FName</label>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(p => p.FirstName, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(x => x.FirstName, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>

                    <div class="form-group half-col">
                        <label class="col-sm-3 control-label require">@Lang.LName</label>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(p => p.LastName, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(x => x.LastName, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label require">@Lang.Gender</label>
                        <div class="col-sm-4">
                            <label class="radio-inline">
                            <input type="radio" name="Gender" id="male" value="True" checked /> <span>@Lang.Male</span>
                            </label>
                            <label class="radio-inline">
                            <input type="radio" name="Gender" id="female" value="False" /> <span>@Lang.Female</span>
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label require">@Lang.EmailSignup</label>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(p => p.Email, new { @class = "form-control emailInput" })
                        </div>
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(x => x.Email, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label require">@Lang.ReEmail</label>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(p => p.VerifyEmail, new { @class = "form-control emailInput" })
                        </div>
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(x => x.VerifyEmail, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label require">@Lang.ContactNumber</label>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(p => p.Phone, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(x => x.Phone, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>

                    @RazorHelper.RenderAppContact(currentLanguage)
                </div>

                <div class="info-group">
                    <div class="title">
                        <span class="text">@Lang.MailingInfor</span>
                    </div>

                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-3 control-label require">@Lang.Address</label>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(p => p.Address, new { @class = "form-control" })
                            </div>
                            <div class="col-sm-offset-3 col-sm-9">
                                @Html.ValidationMessageFor(x => x.Address, string.Empty, new { @class = "help-block hide" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label require">@Lang.City</label>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(p => p.City, new { @class = "form-control" })
                            </div>
                            <div class="col-sm-offset-3 col-sm-9">
                                @Html.ValidationMessageFor(x => x.City, string.Empty, new { @class = "help-block hide" })
                            </div>
                        </div>

                        @if (currentLanguage.Equals("zh-CN") || currentLanguage.Equals("zh-TW"))
                        {
                            <div class="form-group">
                                <label class="col-sm-3 control-label require">@Lang.State</label>
                                <div class="col-sm-4">
                                    <input class="form-control" name="State" id="State" type="text" data-val="true" data-val-required="@Lang.StateIsRequired" />
                                </div>
                                <div class="col-sm-offset-3 col-sm-9">
                                    <span class="field-validation-valid help-block hide" data-valmsg-for="State" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                        }

                        <div class="form-group">
                            <label class="col-sm-3 control-label require">@Lang.PostCode</label>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(p => p.Postal, new { @class = "form-control" })
                            </div>
                            <div class="col-sm-offset-3 col-sm-9">
                                @Html.ValidationMessageFor(x => x.Postal, string.Empty, new { @class = "help-block hide" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label require">@Lang.Country</label>
                            <div class="col-sm-4">
                                <select class="form-control" name="Country" id="Country" data-val="true" data-val-required="@Lang.CountryErr">
                                    @{ Html.RenderPartial("~/Views/Signup/_CountryOption.cshtml"); }
                                </select>
                            </div>
                            <div class="col-sm-offset-3 col-sm-9">
                                @Html.ValidationMessageFor(x => x.Country, string.Empty, new { @class = "help-block hide" })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="info-group website-info">
                    <div class="title">
                        <span class="text">@Lang.WebsiteInfor</span>
                    </div>

                    <div class="form-horizontal">
                        <div class="form-group">
                            <div class="col-sm-4 full">
                                <label class="radio-inline">
                                    <input type="radio" name="HasWebSite" value="True" checked="checked" id="hasWebSite" /> <span>@Lang.OwnWebsite</span>
                                </label>
                            </div>
                        </div>

                        <div id="websiteInfo">
                            <div class="form-group">
                                <label class="col-sm-3 control-label require">@Lang.WebsiteURL</label>
                                <div class="col-sm-4">
                                    @Html.TextBoxFor(p => p.SiteUrl, new { @class = "form-control" })
                                </div>
                                <div class="col-sm-1">
                                    <button type="button" class="btn btn-submit btn-add-web" id="btnAddUrl" title="@Lang.AddUrl"><span class="glyphicon glyphicon-plus" aria-hidden="true"></span></button>
                                </div>
                                <div class="col-sm-offset-3 col-sm-9">
                                    @Html.ValidationMessageFor(p => p.SiteUrl, string.Empty, new { @class = "help-block hide" })
                                </div>
                            </div>

                            <input type="hidden" name="MoreSiteUrls" id="MoreSiteUrls" />
                        </div>

                        <div class="form-group">
                            <div class="col-sm-4 full">
                                <label class="radio-inline">
                                    <input type="radio" name="HasWebSite" value="False" /> <span>@Lang.NoWebsite</span>
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label require">@SiteFriendlyNameHelper.ReplaceB2C(Lang.DescWebsite)</label>
                            <div class="col-sm-4">
                                @Html.TextAreaFor(p => p.NoSiteDesc, new { @class = "form-control", @rows = 5, @disabled = "disabled" })
                            </div>
                            <div class="col-sm-offset-3 col-sm-9">
                                @Html.ValidationMessageFor(p => p.NoSiteDesc, string.Empty, new { @class = "help-block hide" })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="info-group">
                    <div class="title">
                        <span class="text">@Lang.Preference</span>
                    </div>
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-3 control-label require">@Lang.Language</label>
                            <div class="col-sm-4">
                                <select class="form-control" name="PreferredLanguage" id="PreferredLanguage" data-val="true" data-val-required="@Lang.PreferLangErr">
                                    <option value="">@Lang.SelectOne</option>
                                    @foreach (var item in languageService.GetLanguageList())
                                    {
                                        <option value="@item.Code">@item.NativeName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-offset-3 col-sm-9">
                                @Html.ValidationMessageFor(x => x.PreferredLanguage, string.Empty, new { @class = "help-block hide" })
                            </div>
                        </div>

                        <div class="form-group">
                            @{Html.RenderAction("SecurityQuestion", "Signup");}
                            <div class="col-sm-offset-3 col-sm-9">
                                @Html.ValidationMessageFor(x => x.QuestionId, string.Empty, new { @class = "help-block hide" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label require">@Lang.lblYourAnswer</label>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(p => p.Answer, new { @class = "form-control" })
                            </div>
                            <div class="col-sm-offset-3 col-sm-9">
                                @Html.ValidationMessageFor(x => x.Answer, string.Empty, new { @class = "help-block hide" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label require">@Lang.Validation</label>
                            <div class="col-sm-4 preference-validation">
                                @Html.TextBoxFor(p => p.Captcha, new { @class = "form-control", @autocomplete = "off" })
                                <div class="captcha">
                                    <div class="validation-value"><img id="signupCaptcha" src="" alt="captcha" /></div>
                                </div>
                            </div>
                            <div class="col-sm-offset-3 col-sm-9">
                                @Html.ValidationMessageFor(x => x.Captcha, string.Empty, new { @class = "help-block hide" })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="info-group">
                    <div class="title">
                        <span class="text">@Lang.PaymentInfor</span>
                    </div>
                    <div class="form-horizontal">
                        <div class="form-group payment-method">
                            <label class="col-sm-3 control-label">@Lang.PaymentMethod</label>
                            <div class="col-sm-4">
                                <label class="radio-inline">
                                    <input type="radio" name="Method" checked /> <span>@(SiteFriendlyNameHelper.ReplaceB2C(Lang._B2CPlayerAcc))</span>
                                </label>
                            </div>
                        </div>
                        <div class="form-group payment-username">
                            <label class="col-sm-3 control-label require">@SiteFriendlyNameHelper.ReplaceB2C(Lang.UsernameSignUp)</label>
                            <div class="col-sm-4 preference-validation">
                                @Html.TextBoxFor(p => p.Player_UserName, new { @class = "form-control", @autocomplete = "off" })
                            </div>
                            <div class="col-sm-offset-3 col-sm-9">
                                @Html.ValidationMessageFor(x => x.Player_UserName, string.Empty, new { @class = "help-block hide" })
                            </div>
                        </div>

                        <div class="form-group agree-box">
                            <div class="checkbox chk-agree">
                                <label>
                                    <input type="checkbox" name="Agree" id="chkAgree" />@SiteFriendlyNameHelper.ReplaceB2C(Lang.IagreetotheTerm)
                                </label>
                            </div>
                        </div>

                        <div class="button-block">
                            <button class="btn btn-submit" id="btnSubmit" type="submit" disabled>@Lang.Submit</button>
                            <button class="btn btn-submit" id="btnReset" type="reset">@Lang.Reset</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="page-title">
            <span class="text">@Lang.Error</span>
        </div>
        <div class="container-fluid">
            <div class="row">
                <div class="error-content">
                    <div class="img-support">
                        <img class="img-responsive" src="~/www/build/styles/Images/404-illus.png" alt="404-illus"/>
                    </div>
                    <div class="error-text">
                        <p class="text-center">@Html.Raw($"{Lang.InvalidLink} <a href={Url.Content("~/SignUp/Index")}>{Lang.ClickHere}</a>")</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
