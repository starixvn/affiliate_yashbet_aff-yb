@{
    ViewBag.Title = Lang.Signup;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";

    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var languageService = DependencyResolver.Current.GetService<ILanguageService>();
    var currentLanguage = sessionService.CurrentLanguage;
}

@using Fanex.Affiliate.User.Core.CoreService
@using Fanex.Affiliate.User.Core.BusinessService

@model Fanex.Affiliate.User.Core.MetalModels.UserSignUpParam

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/signup.css")
}

@section scripts{
    <script>
        var resourceLanguage = {
            webSiteUrl: '@Lang.WebsiteURL',
            requiredMoreWebSiteUrl: '@Lang.WebsiteUrli',
            generalError: '@Error.General',
            deleteLabel: '@Lang.Del'
        }
    </script>
    <script src="@Url.RenderLink("~/www/build/js/validation.js")"></script>
    @Html.InlineScripts("~/www/build/js/signup.js")
}


<div class="page-container">
    <div class="main-content">
        <div class="sign-up-page">
            <div class="group-title">
                <h2 class="title-block">
                    <span class="text">@Lang.RegisForm</span>
                </h2>
            </div>

            <div class="top-text">
                Please complete this form to register for your Yashbet affiliate account. <br />
                Fields marked <span class="red-color">*</span> must be completed
            </div>

            <div class="alert alert-success" role="alert" id="messageSuccess" style="display: none;">
                <p class="text-center"><b>@Html.Raw(Lang.UnderReview)</b></p>
                @Html.Raw(string.Format(SiteFriendlyNameHelper.ReplaceB2C(Lang.RegisSuccess), Url.Content("~/ContactUs")))
            </div>

            <form class="form">
                <div class="info-question">
                    <div class="title">
                        <span class="text">@Lang.ContactInfo</span>
                    </div>
                    <div class="body-result">
                        <div class="form-group form-columns form-columns-2">
                            <div class="items validate-group">
                                <label for="FirstName" class="custom-label">@Lang.FName <span class="red-color">*</span></label>
                                @Html.TextBoxFor(p => p.FirstName, new { @class = "form-input" })
                                @Html.ValidationMessageFor(x => x.FirstName, string.Empty, new { @class = "validate-input hide" })
                            </div>
                            <div class="items validate-group">
                                <label for="LastName" class="custom-label">@Lang.LName <span class="red-color">*</span></label>
                                @Html.TextBoxFor(p => p.LastName, new { @class = "form-input" })
                                @Html.ValidationMessageFor(x => x.LastName, string.Empty, new { @class = "validate-input hide" })
                            </div>
                        </div>

                        <div class="form-group form-columns form-columns-2">
                            <div class="items validate-group">
                                <label for="EmailSignup" class="custom-label">@Lang.EmailSignup <span class="red-color">*</span></label>
                                @Html.TextBoxFor(p => p.Email, new { @class = "form-input" })
                                @Html.ValidationMessageFor(x => x.Email, string.Empty, new { @class = "validate-input hide" })
                            </div>

                            <div class="items validate-group">
                                <label for="ReEmail" class="custom-label">@Lang.ReEmail <span class="red-color">*</span></label>
                                @Html.TextBoxFor(p => p.VerifyEmail, new { @class = "form-input" })
                                @Html.ValidationMessageFor(x => x.VerifyEmail, string.Empty, new { @class = "validate-input hide" })
                            </div>
                        </div>

                        <div class="form-group form-columns form-columns-2">
                            <div class="items validate-group">
                                <label for="ContactNumber" class="custom-label">@Lang.ContactNumber <span class="red-color">*</span></label>
                                @Html.TextBoxFor(p => p.Phone, new { @class = "form-input" })
                                @Html.ValidationMessageFor(x => x.Phone, string.Empty, new { @class = "validate-input hide" })
                            </div>

                            <div class="items validate-group">
                                <label for="Skype" class="custom-label">Skype</label>
                                <input type="text" name="name" value="" class="form-input disable" />
                            </div>
                        </div>

                        <div class="form-group form-columns form-columns-2">
                            <div class="items validate-group">
                                <label for="Facebook" class="custom-label">Facebook</label>
                                <input type="text" name="name" value="" class="form-input" />
                            </div>
                            <div class="items validate-group">
                                <label for="Gender" class="custom-label">@Lang.Gender <span class="red-color">*</span></label>
                                <div class="radio-group">
                                    <label class="radio-button">
                                        <input type="radio" name="Gender" id="male" value="True" checked />
                                        <span class="radio-circle"></span>
                                        <span class="radio-label">@Fanex.Affiliate.User.Core.Resources.Lang.Male</span>
                                    </label>
                                    <label class="radio-button">
                                        <input type="radio" name="Gender" id="female" value="False" />
                                        <span class="radio-circle"></span>
                                        <span class="radio-label">@Fanex.Affiliate.User.Core.Resources.Lang.Female</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="info-question">
                    <div class="title">
                        <span class="text">@Lang.MailingInfor</span>
                    </div>
                    <div class="body-result">
                        <div class="form-group form-columns form-columns-2">
                            <div class="items validate-group">
                                <label for="Address" class="custom-label">@Lang.Address <span class="red-color">*</span></label>
                                @Html.TextBoxFor(p => p.Address, new { @class = "form-input" })
                                @Html.ValidationMessageFor(x => x.Address, string.Empty, new { @class = "validate-input hide" })
                            </div>

                            <div class="items validate-group">
                                <label for="City" class="custom-label">@Lang.City <span class="red-color">*</span></label>
                                @Html.TextBoxFor(p => p.City, new { @class = "form-input" })
                                @Html.ValidationMessageFor(x => x.City, string.Empty, new { @class = "validate-input hide" })
                            </div>
                        </div>

                        <div class="form-group form-columns form-columns-2">
                            <div class="items validate-group">
                                <label for="Postal" class="custom-label">@Lang.PostCode <span class="red-color">*</span></label>
                                @Html.TextBoxFor(p => p.Postal, new { @class = "form-input" })
                                @Html.ValidationMessageFor(x => x.Postal, string.Empty, new { @class = "validate-input hide" })
                            </div>

                            <div class="items validate-group">
                                <label for="City" class="custom-label">@Lang.Country <span class="red-color">*</span></label>
                                <select class="form-input form-select" name="Country" id="Country" data-val="true" data-val-required="@Lang.CountryErr">
                                    @{ Html.RenderPartial("~/Views/Signup/_CountryOption.cshtml"); }
                                </select>
                                @Html.ValidationMessageFor(x => x.Country, string.Empty, new { @class = "validate-input hide" })
                            </div>
                        </div>


                    </div>
                </div>
                <div class="info-question">
                    <div class="title">
                        <span class="text">@Lang.WebsiteInfor</span>
                    </div>
                    <div class="body-result">
                        <div class="form-group form-columns form-columns-2">
                            <div class="items validate-group" id="websiteInfo">
                                <div class="radio-group spacing-bt">
                                    <label class="radio-button">
                                        <input type="radio" name="HasWebSite" value="True" checked id="hasWebSite" />
                                        <span class="radio-circle"></span>
                                        <span class="radio-label">@Lang.OwnWebsite <span class="red-color">*</span></span>
                                    </label>
                                </div>
                                <div class="input-url">
                                    <label for="SiteUrl" class="custom-label">@Lang.WebsiteURL <span class="red-warn">*</span></label>
                                    <div class="group-input">
                                        @Html.TextBoxFor(p => p.SiteUrl, new { @class = "form-input" })
                                        <span class="button-toggle button-toggle-open" id="btnAddUrl" title="@Lang.AddUrl"></span>
                                    </div>
                                    @Html.ValidationMessageFor(x => x.SiteUrl, string.Empty, new { @class = "validate-input hide" })
                                </div>

                                <input type="hidden" name="MoreSiteUrls" id="MoreSiteUrls" />
                            </div>
                        </div>
                        <div class="form-group form-columns form-columns-2">
                            <div class="items validate-group">
                                <div class="radio-group spacing-bt">
                                    <label class="radio-button">
                                        <input type="radio" name="HasWebSite" value="False" />
                                        <span class="radio-circle"></span>
                                        <span class="radio-label">@Lang.NoWebsite</span>
                                    </label>
                                </div>
                                @Html.TextAreaFor(p => p.NoSiteDesc, new { @class = "form-area", @rows = 5, @disabled = "disabled", @placeholder = Lang.DescWebsite })
                                @Html.ValidationMessageFor(p => p.NoSiteDesc, string.Empty, new { @class = "validate-input hide" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="info-question">
                    <div class="title">
                        <span class="text">@Lang.Preference</span>
                    </div>
                    <div class="body-result">
                        <div class="form-group form-columns form-columns-2">
                            <div class="items validate-group">
                                <label for="Language" class="custom-label">@Lang.Language <span class="red-color">*</span></label>
                                <select class="form-input form-select" name="PreferredLanguage" id="PreferredLanguage" data-val="true" data-val-required="@Lang.PreferLangErr">
                                    <option value="">@Lang.SelectOne</option>
                                    @foreach (var item in languageService.GetLanguageList())
                                    {
                                        <option value="@item.Code">@item.NativeName</option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(x => x.Language, string.Empty, new { @class = "validate-input hide" })
                            </div>
                            <div class="items validate-group">
                                @{Html.RenderAction("SecurityQuestion", "Signup");}
                                @Html.ValidationMessageFor(x => x.QuestionId, string.Empty, new { @class = "validate-input hide" })
                            </div>
                        </div>
                        <div class="form-group form-columns form-columns-2">
                            <div class="items validate-group">
                                <label for="lblYourAnswer" class="custom-label">@Lang.lblYourAnswer  <span class="red-color">*</span></label>
                                @Html.TextBoxFor(p => p.Answer, new { @class = "form-input" })
                                @Html.ValidationMessageFor(x => x.Answer, string.Empty, new { @class = "validate-input hide" })
                            </div>

                            <div class="items validate-group">
                                <label class="custom-label">@Lang.Validation</label>
                                <div class="items validate-group preference-validation">
                                    @Html.TextBoxFor(p => p.Captcha, new { @class = "form-input", @autocomplete = "off" })
                                    <div class="captcha">
                                        <div class="validation-value"><img id="signupCaptcha" src="" alt="captcha" /></div>
                                    </div>
                                </div>
                                @Html.ValidationMessageFor(x => x.Captcha, string.Empty, new { @class = "validate-input hide" })
                            </div>
                        </div>
                    </div>
                </div>


                <div class="info-question">
                    <div class="title">
                        <span class="text">@Lang.PaymentInfor</span>
                    </div>
                    <div class="body-result">


                        <div class="form-group form-columns group-form group-custom-width">
                            <div class="form-text">
                                @Lang.PaymentMethod
                            </div>
                            <div class="radio-group spacing-bt">
                                <label class="radio-button">
                                    <input type="radio" name="Method" checked />
                                    <span class="radio-circle"></span>
                                    <span class="radio-label">@(SiteFriendlyNameHelper.ReplaceB2C(Lang._B2CPlayerAcc)) </span>
                                </label>
                            </div>
                            <div class="items validate-group">
                                <label for="Player_UserName" class="custom-label">@SiteFriendlyNameHelper.ReplaceB2C(Lang.UsernameSignUp) <span class="red-color">* (non-deposited account only)</span></label>
                                @Html.TextBoxFor(p => p.Player_UserName, new { @class = "form-input", @autocomplete = "off" })
                                @Html.ValidationMessageFor(x => x.Player_UserName, string.Empty, new { @class = "validate-input hide" })
                            </div>
                        </div>
                    </div>
                    <label class="custom-checkbox">
                        <input type="checkbox" id="chkAgree" name="Agree" />
                        <span class="checkmark"></span>
                        <span class="text-checkbox">@Lang.IagreetotheTerm</span>
                    </label>
                    <div class="group-button">
                        <button class="custom-button custom-button-outline" id="btnReset" type="button">@Lang.Reset</button>
                        <button class="custom-button custom-button-dash" disabled id="btnSubmit" type="submit">@Lang.Submit</button>
                    </div>
                </div>
            </form>

            @RazorHelper.RenderMovingTopButton()
        </div>
    </div>
</div>
