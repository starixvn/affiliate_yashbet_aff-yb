@{
    ViewBag.Title = Lang.AffiliateProgram;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}
@using Fanex.Affiliate.User.Core.Utilities;

@model Fanex.Affiliate.User.Core.ViewModels.VerificationAccountViewModel

@{
    var email = Model.Email;
    if (string.IsNullOrEmpty(email))
    {
        <h4 class="text-danger">@Lang.YouDontHaveTheEmail</h4>
    }
    else
    {
        @section styles{
            @Html.InlineStyles("~/www/build/styles/css/verification-account.css")
        }

        @section scripts{
            <script type="text/javascript">
                var resource = {
                    verificationFailed: '@Error.VerificationFailed',
                    general: '@Error.General',
                    invalidEmail: '@Error.InvalidEmail',
                    wait60Seconds: '@Error.Wait60Seconds',
                }
            </script>
            <script src="@Url.RenderLink("~/www/build/js/validation.js")"></script>
            @Html.InlineScripts("~/www/build/js/pages/verification-account.js")
        }
        <div class="main-content">
            <div class="content verification-account">
                <p>@SiteFriendlyNameHelper.ReplaceB2C(Lang.DearCustomer)</p>
                <p>@Lang.DueTo</p>
                <p>@Html.Raw(string.Format(Lang.YourRegisterEmail, email))</p>
                <form id="sendCodeForm">
                    <div class="form-group row" id="emailGroup">
                        <label for="Email" class="control-label require">@Lang.EmailVerification</label>
                        <div class="form-input">
                            <input type="text" class="form-control" autocomplete="off" data-val="true" data-val-required="@Lang.EmailIsRequired" id="Email" name="Email" />
                            <span class="help-block field-validation-error" data-valmsg-for="Email" data-valmsg-replace="true" id="emailValidationMessage"></span>
                        </div>
                        <button type="button" class="btn btn-sendcode" id="btnSendCode">@Lang.SendCode</button>
                    </div>
                </form>
                <div class="hide" id="verificationAccountGroup">
                    <p>@Lang.AVerificationCode</p>
                    <p>@Html.Raw(string.Format(Lang.ForAnyReason, Url.Content("~/ContactUs")))</p>
                    <br />
                    <form id="verificationAccountForm">
                        @Html.AntiForgeryToken()
                        <div class="form-group row">
                            <label for="Usename" class="col-sm-2 control-label require">@Lang.UsernameVerification</label>
                            <div class="col-sm-4 col-lg-3">
                                <input type="text" class="form-control" autocomplete="off" data-val="true" data-val-required="@Lang.UsernameIsRequired" id="Usename" name="Usename" />
                                <span class="field-validation-valid help-block" data-valmsg-for="Usename" data-valmsg-replace="true"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="Password" class="col-sm-2 control-label require">@Lang.PasswordVerification</label>
                            <div class="col-sm-4 col-lg-3">
                                <input type="password" class="form-control" data-val="true" data-val-required="@Lang.PasswordIsRequired" id="Password" name="Password" autocomplete="off" />
                                <span class="field-validation-valid help-block" data-valmsg-for="Password" data-valmsg-replace="true"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="Code" class="col-sm-2 control-label require">@Lang.VerificationCode</label>
                            <div class="col-sm-4 col-lg-3">
                                <input type="text" class="form-control" autocomplete="off" data-val="true" data-val-required="@Lang.VerificationCodeIsRequired" id="Code" name="Code" />
                                <span class="field-validation-valid help-block" data-valmsg-for="Code" data-valmsg-replace="true"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="Captcha" class="col-sm-2 control-label require">@Lang.Captcha</label>
                            <div class="col-sm-4 col-lg-3">
                                <input type="text" class="form-control" autocomplete="off" data-val="true" data-val-required="@Lang.CaptchaIsRequired" id="Captcha" name="Captcha" />
                                <span class="field-validation-valid help-block" data-valmsg-for="Captcha" data-valmsg-replace="true"></span>
                            </div>
                            <div class="validation-value">
                                <img style="cursor:pointer" id="captchaVerificationAccount" src="@Url.Content("~/VerificationAccount/CaptchaImage?_v=" + DateTimeHelper.NowDateTime.ToLongTimeString())" alt="captcha" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-sm-offset-2 col-sm-10">
                                <button type="button" class="btn btn-login" id="btnLoginVerification">@Lang.Login</button>
                            </div>
                        </div>

                        @Html.Hidden("VerificationToken")
                        @Html.Hidden("ActionLink")
                        @Html.Hidden("ActionToken")
                    </form>
                </div>
            </div>
        </div>
    }
}