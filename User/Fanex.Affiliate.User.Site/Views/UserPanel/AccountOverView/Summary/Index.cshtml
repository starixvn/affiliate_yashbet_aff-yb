@using Fanex.Affiliate.User.Core.Constants;
@using Fanex.Affiliate.User.Core.Utilities;
@model bool

@{
    var now = DateTimeOffset.Now.ToOffset(new TimeSpan(GMT.PlusEight, 0, 0));
}

<div class="wrapper-after-login summary" id="summary">
    <div class="form-group">
        <div id="monthPicker" class="form-wrapper">
            <div class="select-date">
                <input readonly id="MonthDate" data-original-date="@now.ToString("MM/dd/yyyy")" class="form-control d-inline-block" type="text" value="@DateTimeHelper.NowDateTime.ToString("MMM-yyyy")" />
                <span class="icon-date">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M5.83301 2.50016H2.49967C2.27866 2.50016 2.0667 2.58796 1.91042 2.74424C1.75414 2.90052 1.66634 3.11248 1.66634 3.3335V16.6668C1.66634 16.8878 1.75414 17.0998 1.91042 17.2561C2.0667 17.4124 2.27866 17.5002 2.49967 17.5002H17.4997C17.7207 17.5002 17.9326 17.4124 18.0889 17.2561C18.2452 17.0998 18.333 16.8878 18.333 16.6668V3.3335C18.333 3.11248 18.2452 2.90052 18.0889 2.74424C17.9326 2.58796 17.7207 2.50016 17.4997 2.50016H14.1663V0.833496H12.4997V2.50016H7.49967V0.833496H5.83301V2.50016ZM16.6663 7.50016V15.8335H3.33301V7.50016H16.6663ZM14.9997 9.16683H13.333V10.8335H14.9997V9.16683ZM14.9997 12.5002H13.333V14.1668H14.9997V12.5002ZM11.6663 9.16683H4.99967V10.8335H11.6663V9.16683ZM11.6663 12.5002H7.49967V14.1668H11.6663V12.5002Z" fill="#967435" />
                    </svg>
                </span>
            </div>
            <button class="custom-button" id="statisticsSubmit" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M1.29755 6.21019C0.949551 6.09419 0.946218 5.90686 1.30422 5.78752L14.0289 1.54619C14.3815 1.42886 14.5835 1.62619 14.4849 1.97152L10.8489 14.6955C10.7489 15.0482 10.5456 15.0602 10.3962 14.7255L8.00022 9.33352L12.0002 4.00019L6.66688 8.00019L1.29755 6.21019Z" fill="white" />
                </svg>
                @Lang.Submit
            </button>
        </div>
    </div>
    <div class="summary-content">
        <div class="dashboard-section" id="dashboard-section"></div>

        <div class="details-section" id="details-section">
            <div class="tab-menu details-section-menu" id="details-section-menu">
                <ul class="menu list-unstyled">
                    <li><a href="javascript:;" data-name="Overview" class="menu-item details-section-menu-item" id="menuOverview">@Lang.Overview</a></li>
                    <li><a href="javascript:;" data-name="PlayersDetails" class="menu-item details-section-menu-item" id="menuPlayersDetails">@Lang.PlayersDetails</a></li>
                    @if (!Model)
                    {
                        <li><a href="javascript:;" data-name="SubAffDetails" class="menu-item details-section-menu-item" id="menuSubAffDetails">@Lang.SubAffDetail</a></li>
                    }
                </ul>
            </div>
            <div class="details-section-content" id="details-section-content"></div>
        </div>
    </div>
</div>

<input type="hidden" id="ToDay" value="@now.ToString("MM/dd/yyyy")" />

<script src="@Url.RenderLink("~/www/build/js/pages/summary.js")"></script>