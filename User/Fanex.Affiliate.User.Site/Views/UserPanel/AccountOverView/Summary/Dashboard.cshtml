@using Fanex.Affiliate.User.Core.Utilities

@model Fanex.Affiliate.User.Core.DTO.UserPanel.OverviewSummary

@{
    var currencySymbol = AppSetting.Instance.CurrencySymbol;
}

<div class="column-account">
    <span class="my-account">@Lang.MyAccount</span>
    <div class="group group-one">
        <div class="img-icon">
            <div class="wrapper-img-icon">
                <img class="img-responsive" src="~/www/build/styles/Images/account-overview/new-sign-up.png" alt="sign up icon" />
            </div>
        </div>
        <div class="group-panel">
            <div class="info-panel">
                <span class="info-panel-title">@Lang.NewSignup / @Lang.Deposit</span>
                <span class="info-panel-content">@($"{Model.Signups}/{Model.DepositedMembers}")</span>
            </div>
            <div class="info-panel">
                <span class="info-panel-title">@Html.Raw(Lang.ActivePlayers)</span>
                <span class="info-panel-content">@($"{Model.ActivePlayers}")</span>
            </div>
        </div>
    </div>
    <div class="group group-two">
        <div class="img-icon">
            <div class="wrapper-img-icon">
                <img class="img-responsive" src="~/www/build/styles/Images/account-overview/commission.png" alt="commission icon" />
            </div>
        </div>
        <div class="group-panel">
            <div class="info-panel">
                <div class="info-panel-title">
                    <span class="">@Lang.Commission</span>
                    <span title="@Lang.P2pIncluded" class="glyphicon glyphicon-info-sign"></span>
                </div>
                <span class="info-panel-content">@Model.Commission.ToStringMoneyWithCurrencySymbol(currencySymbol)</span>
            </div>
            <div class="info-panel">
                <span class="info-panel-title">@Lang.BalForward</span>
                <span class="info-panel-content">@Model.BalanceBroughtForward.ToStringMoneyWithCurrencySymbol(currencySymbol)</span>
            </div>
        </div>
    </div>
    <div class="group group-three">
        <div class="img-icon">
            <div class="wrapper-img-icon">
                <img class="img-responsive" src="~/www/build/styles/Images/account-overview/total-deposit.png" alt="deposit icon" />
            </div>
        </div>
        <div class="group-panel">
            <div class="info-panel">
                <span class="info-panel-title">@Lang.TotalDeposit</span>
                <span class="info-panel-content">@Model.Deposit.ToStringMoneyWithCurrencySymbol(currencySymbol)</span>
            </div>
            <div class="info-panel">
                <span class="info-panel-title">@Lang.TotalTurnover</span>
                <span class="info-panel-content">@Model.Turnover.ToStringMoneyWithCurrencySymbol(currencySymbol)</span>
            </div>
        </div>
    </div>
</div>
@if (!Model.IsMaxSubLevel)
{
    <div class="column-account">
        <span class="my-account">@Lang.SubAffiliate</span>
        <div class="group group-four">
            <div class="img-icon">
                <div class="wrapper-img-icon">
                    <img class="img-responsive" src="~/www/build/styles/Images/account-overview/icon-subaff.png" alt="subaff icon" />
                </div>
            </div>
            <div class="group-panel">
                <div class="info-panel">
                    <span class="info-panel-title">@Lang.SubAffDownline</span>
                    <span class="info-panel-content">@Model.NoOfSubAff</span>
                </div>

                <div class="info-panel">
                    <span class="info-panel-title">@Lang.SubAffEarning </span>
                    <span class="info-panel-content">@Model.SubAffCommission.ToStringMoneyWithCurrencySymbol(currencySymbol)</span>
                </div>
            </div>
        </div>
    </div>
}


