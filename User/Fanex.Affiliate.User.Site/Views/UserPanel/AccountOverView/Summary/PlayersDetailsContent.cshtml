@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.PlayerDetailViewModel

@{
    var hasScroll = Model.PlayerDetailList != null && Model.PlayerDetailList.Count() > 10;
    var totalItem = Model.TotalItem;
    var startRowNumber = Model.StartRowNumber;
    var isDepositFeePercent = Model.IsDepositFeePercent;
    var isWithdrawalFeePercent = Model.IsWithdrawalFeePercent;
    var columnDepositFee = Model.IsDepositFeePercent ? 1 : 0;
    var columnWithdrawalFee = Model.IsWithdrawalFeePercent ? 1 : 0;
}

@{
    if (Model.PlayerDetailList != null && Model.PlayerDetailList.Any())
    {
        foreach (var item in Model.PlayerDetailList)
        {
    <tr>
        <td class="text-center">@startRowNumber</td>
        <td class="text-center break-all">@item.Username</td>
        <td class="text-center">@(item.RegisteredDate?.ToString("MM/dd/yyyy HH:mm:ss") ?? string.Empty)</td>
        <td class="text-center">@(item.FirstDepositDate?.ToString("MM/dd/yyyy HH:mm:ss") ?? string.Empty)</td>
        <td class="text-right">@item.Turnover.FormatDecimal()</td>
        <td class="text-right">@item.GGR.FormatDecimal()</td>
        <td class="text-right">@item.Deposit.FormatDecimal()</td>
        <td class="text-right">@item.Withdrawal.FormatDecimal()</td>
        <td class="text-right">@item.Bonus.FormatDecimal()</td>
        <td class="text-right">@item.Rebate.FormatDecimal()</td>
        @if (isDepositFeePercent)
        {
            <td class="text-right">@item.DepositFee.FormatDecimal()</td>
        }

        @if (isWithdrawalFeePercent)
        {
            <td class="text-right">@item.WithdrawalFee.FormatDecimal()</td>
        }
    </tr>

            startRowNumber++;
        }
    }
    else
    {
        <tr>
            <td class="text-center no-info" colspan=@(10 + columnDepositFee + columnWithdrawalFee)>@Lang.NoInfo</td>
        </tr>
    }
}

<input type="hidden" id="HasScroll" value="@(hasScroll ? "has-scroll" : string.Empty)" />
<input type="hidden" id="TotalItem" value="@totalItem" />