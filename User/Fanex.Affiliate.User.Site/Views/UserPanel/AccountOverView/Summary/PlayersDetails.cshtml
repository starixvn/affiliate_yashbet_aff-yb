@using Fanex.Affiliate.User.Core.Utilities

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.PlayerDetailViewModel

@{
    var currencyLabel = AppSetting.Instance.CurrencyLabel;
}

<div class="table player-detail-table overview-table">
    <table id="player-detail-table">
        <thead>
            <tr class="player-detail-table-header overview-table-header">
                <th width="5%">No.</th>
                <th width="9%" class="th" data-name="Username">
                    <div class="th-wrapper">
                        <span>@Lang.Username</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="RegisteredDate">
                    <div class="th-wrapper">
                        <span>@Lang.RegisteredDate</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="FdmDate">
                    <div class="th-wrapper">
                        <span>@Lang.FdmDate</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="Turnover">
                    <div class="th-wrapper">
                        <span>@Html.Raw(Lang.Turnover + currencyLabel)</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span id="defaultSorting" class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="GGR">
                    <div class="th-wrapper">
                        <span>@Html.Raw(Lang.GGR + currencyLabel)</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="Deposit">
                    <div class="th-wrapper">
                        <span>@Html.Raw(Lang.Deposit + currencyLabel)</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="Withdrawal">
                    <div class="th-wrapper">
                        <span>@Html.Raw(Lang.Withdrawal + currencyLabel)</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="Bonus">
                    <div class="th-wrapper">
                        <span>@Html.Raw(Lang.Bonus + currencyLabel)</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="Rebate">
                    <div class="th-wrapper">
                        <span>@Html.Raw(Lang.Rebate + currencyLabel)</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                @if (Model.IsDepositFeePercent)
                {
                    <th width="9%" class="th" data-name="DepositFee">
                        <div class="th-wrapper">
                            <span>@Html.Raw(Lang.DepositFee + currencyLabel)</span>
                            <div class="icon-container">
                                <span class="caret asc"></span>
                                <span class="caret desc"></span>
                            </div>
                        </div>
                    </th>
                }

                @if (Model.IsWithdrawalFeePercent)
                {
                    <th width="9%" class="th" data-name="WithdrawalFee">
                        <div class="th-wrapper">
                            <span>@Html.Raw(Lang.WithdrawalFee + currencyLabel)</span>
                            <div class="icon-container">
                                <span class="caret asc"></span>
                                <span class="caret desc"></span>
                            </div>
                        </div>
                    </th>
                }
            </tr>
        </thead>
        <tbody id="player-detail-content">
            @{ Html.RenderPartial("~/Views/UserPanel/AccountOverView/Summary/PlayersDetailsContent.cshtml", Model); }
        </tbody>
    </table>
</div>
<div class="player-detail-pager" id="player-detail-pager"></div>

<script src="@Url.RenderLink("~/www/build/js/player-detail.js")"></script>