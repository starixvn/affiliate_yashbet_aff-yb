@using Fanex.Affiliate.User.Core.Utilities

@model IEnumerable<Fanex.Affiliate.User.Core.DTO.UserPanel.OverviewDetail>

@{
    var rowNum = Model.Count();
    var itemTotal = Model.LastOrDefault();
    var hasData = rowNum > 1;
    var hasScroll = rowNum > 11;
    var currencyLabel = AppSetting.Instance.CurrencyLabel;
}

<div class="table overview-table">
    <table class="has-total" id="overview-table">
        <thead>
            <tr class="overview-table-header" id="overview-table-header">
                <th width="10%">@Lang.Date</th>
                <th width="10%">@Lang.NewSignup</th>
                <th width="12%">@Lang.DepositedPlayers</th>
                <th width="12%">@Html.Raw(Lang.ActivePlayers)</th>
                <th width="10%">@Html.Raw(Lang.Deposit + currencyLabel)</th>
                <th width="10%">@Html.Raw(Lang.Turnover + currencyLabel)</th>
                <th width="10%">@Html.Raw(Lang.Withdrawal + currencyLabel)</th>
                <th width="10%">@Html.Raw(Lang.GGR + currencyLabel)</th>
            </tr>
            @{
                if (hasData)
                {
                    <tr class="overview-table-total" id="overview-table-total">
                        <th>@Lang.Total</th>
                        <th class="align-right">@itemTotal.Signups</th>
                        <th class="align-right">@itemTotal.DepositedMembers</th>
                        <th class="align-right">@itemTotal.ActiveMembers</th>
                        <th class="align-right">@itemTotal.Deposit.FormatDecimal()</th>
                        <th class="align-right">@itemTotal.Turnover.FormatDecimal()</th>
                        <th class="align-right">@itemTotal.Withdrawal.FormatDecimal()</th>
                        <th class="align-right">@itemTotal.GGR.FormatDecimal()</th>
                    </tr>
                }
            }
        </thead>
        <tbody class="overview-table-body @(hasScroll ? "has-scroll" : string.Empty)">
            @{
                if (hasData)
                {
                    for (var i = 0; i < rowNum - 1; i++)
                    {
                        var item = Model.ElementAt(i);
                        <tr>
                            <td class="text-center">@item.WinlostDate.ToString("MM/dd/yyyy")</td>
                            <td class="text-right">@item.Signups</td>
                            <td class="text-right">@item.DepositedMembers</td>
                            <td class="text-right">@item.ActiveMembers</td>
                            <td class="text-right">@item.Deposit.FormatDecimal()</td>
                            <td class="text-right">@item.Turnover.FormatDecimal()</td>
                            <td class="text-right">@item.Withdrawal.FormatDecimal()</td>
                            <td class="text-right">@item.GGR.FormatDecimal()</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center no-info" colspan="9">@Lang.NoInfo</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script src="@Url.RenderLink("~/www/build/js/overview.js")"></script>