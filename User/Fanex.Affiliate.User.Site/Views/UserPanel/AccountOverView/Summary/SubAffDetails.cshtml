@using Fanex.Affiliate.User.Core.Utilities

@model IEnumerable<Fanex.Affiliate.User.Core.DTO.UserPanel.SubAffDetail>

@{
    var hasScroll = Model != null && Model.Count() > 10;
    var currencyLabel = AppSetting.Instance.CurrencyLabel;
}

<div class="table player-detail-table overview-table">
    <table id="sub-aff-detail-table">
        <thead>
            <tr class="player-detail-table-header  overview-table-header">
                <th width="8%">No.</th>
                <th width="16%">@Lang.Username</th>
                <th width="16%">@Lang.FName</th>
                <th width="10%">@Lang.LName</th>
                <th width="10%">@Lang.ApprovalDate</th>
                <th width="10%" hidden>@Lang.SuspensionSatus</th>
                <th width="10%" hidden>@Lang.SuspensionDate</th>
                <th width="10%">@Html.Raw(Lang.TotalTurnover + currencyLabel)</th>
                <th width="10%">@Html.Raw(Lang.TotalGGR + currencyLabel)</th>
                <th width="10%">@Html.Raw(Lang.TotalCommission + currencyLabel)</th>
                <th width="10%">@Lang.NumberOfActivePlayers</th>
                <th width="10%" hidden>@Lang.Remove</th>
            </tr>
        </thead>
        <tbody id="player-detail-content">
            @{
                if (Model != null && Model.Any())
                {
                    var startRowNumber = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@startRowNumber</td>
                            <td class="text-center break-all">@item.UserName</td>
                            <td class="text-center">@Html.Raw(item.FirstName)</td>
                            <td class="text-center">@Html.Raw(item.LastName)</td>
                            <td class="text-center">@item.ApprovedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="text-right">@item.Turnover.FormatDecimal()</td>
                            <td class="text-right">@item.GGR.FormatDecimal()</td>
                            <td class="text-right">@item.Commission.FormatDecimal()</td>
                            <td class="text-right">@item.ActivePlayer</td>
                        </tr>

                        startRowNumber++;
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center no-info" colspan="9">@Lang.NoInfo</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>


