@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.LinkFormViewModel

@{
    var hasDomainList = Model.DomainList != null && Model.DomainList.Any();
}

<div class="link-container">
    <div class="form-horizontal">
        <div class="form-group flex-sm-boostrap flex-center">
            <label class="col-sm-3 control-label">@Lang.AvailableDomains</label>
            <div class="col-sm-9">
                @if (hasDomainList)
                {
                    <select class="form-control" id="Domain">
                        @foreach (var item in Model.DomainList)
                        {
                            <option value="@item.DomainId">@item.DomainName</option>
                        }
                    </select>
                }
                else
                {
                    <p class="form-control-static">@Lang.NoInfo</p>
                }
            </div>
        </div>

        <div class="form-group flex-sm-boostrap flex-center">
            <label class="col-sm-3 control-label">@Lang.LinkTo</label>
            <div class="col-sm-9">
                <select class="form-control" id="MemberSitePage">
                    @foreach (var item in Model.MemberSitePageList)
                    {
                        <option value="@item.PageCode">@item.PageName</option>
                    }
                </select>
            </div>
        </div>
        @if (hasDomainList)
        {
            <div class="form-group">
                <div class="col-sm-offset-3 col-sm-1">
                    <button type="button" class="btn btn-submit" id="btnGenerateLink">@Lang.GenerateLink</button>
                </div>
            </div>
        }
    </div>
</div>
