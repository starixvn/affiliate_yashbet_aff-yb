@{
    Layout = null;
    var totalItem = ViewBag.TotalItem;

}

@model IEnumerable<Fanex.Affiliate.User.Core.DTO.UserPanel.MarketingItem>

<div class="list-container">
    <ul class="list-unstyled list-content">
        @if (totalItem < 1)
        {
            <li><p class="text-center">@Lang.NoInfo</p></li>
        }
        else
        {
            foreach (var banner in Model)
            {
                var uri = new Uri(banner.RedirectLink);
                var url = banner.RedirectLink;
                if(string.IsNullOrWhiteSpace(uri.Query))
                {
                    url = $"{banner.RedirectLink}?ref=";
                }
                else
                {
                    url = $"{banner.RedirectLink}&ref=";
                }
                <li class="banner-control">
                    <a class="banner-link padding" onclick='window.open("@url" + encodeURIComponent(window.location.href),"_blank"); return false;' href="javascript:;">
                        <img class="banner-link-img"  src="@Server.UrlPathEncode(banner.FileName)" alt="Affiliate @(AppSetting.Instance.SiteFriendlyName) Banner" />
                    </a>
                    <div class="banner-control-button">
                        <div class="banner-code padding">
                            <p>@(Lang.Dimension): <strong class="banner-size">@banner.Size</strong></p>
                            <a href="javascript:;" class="copy-banner-code"
                               data-clipboard-text="<a onclick='window.open(&quot;@(banner.RedirectLink + "?ref=")&quot; + encodeURIComponent(window.location.href),&quot;_blank&quot;); return false;' href='javascript:;' target='_blank'><img src='@banner.FileName' alt='a banner' border='0' width='@banner.Width' height='@banner.Height' /></a>">
                                <img src="~/www/build/styles/Images/account-overview/icon-copy.png" alt="copy icon" /> @Lang.CopyBannerCode
                            </a>
                        </div>
                        <div class="social-media-list padding">
                            <span>@Lang.ShareBanner</span>
                            <div class="social-media-button-group">
                                <a class="img-button" href="@("https://www.facebook.com/sharer/sharer.php?u=" + banner.RedirectLink)" target="_blank">
                                    <img src="~/www/build/styles/Images/account-overview/icon-facebook.png" alt="facebook icon" />
                                </a>
                                <a class="img-button" href="@("https://twitter.com/share?url=" + banner.RedirectLink)" target="_blank">
                                    <img src="~/www/build/styles/Images/account-overview/icon-twitter.png" alt="twitter icon" />
                                </a>
                                <a class="img-button" href="@("https://api.whatsapp.com/send?text=" + banner.RedirectLink)" target="_blank">
                                    <img src="~/www/build/styles/Images/account-overview/icon-whatsapp.png" alt="whatsapp icon" />
                                </a>
                                <a class="img-button" href="@("https://www.shareaholic.com/share/wechat/?link=" + banner.RedirectLink)" target="_blank">
                                    <img src="~/www/build/styles/Images/account-overview/icon-wechat.png" alt="wechat icon" />
                                </a>
                                <a class="img-button" href="@("https://social-plugins.line.me/lineit/share?url=" + banner.RedirectLink)" target="_blank">
                                    <img src="~/www/build/styles/Images/account-overview/icon-line.png" alt="line icon" />
                                </a>
                                <a class="img-button" href="@("http://service.weibo.com/share/share.php?url=" + banner.RedirectLink)" target="_blank">
                                    <img src="~/www/build/styles/Images/account-overview/icon-weiboi.png" alt="weiboi icon" />
                                </a>
                                <a class="img-button" href="@("https://connect.qq.com/widget/shareqq/index.html?url=" + banner.RedirectLink)" target="_blank">
                                    <img src="~/www/build/styles/Images/account-overview/icon-qq.png" alt="qq icon" />
                                </a>
                                <a class="zalo-share-button img-button" data-href="@banner.RedirectLink" data-oaid="579745863508352884" data-layout="3" data-color="blue" data-customize=true>
                                    <img src="~/www/build/styles/Images/account-overview/icon-zalo.png" alt="zalo icon" />
                                </a>
                                <a class="img-button" href="@("https://telegram.me/share/url?url=" + banner.RedirectLink)" target="_blank">
                                    <img src="~/www/build/styles/Images/account-overview/icon-telegram.png" alt="telegram icon" />
                                </a>
                                <a class="img-button" href="@("https://story.kakao.com/s/share?url=" + banner.RedirectLink)" target="_blank">
                                    <img src="~/www/build/styles/Images/account-overview/icon-talk.png" alt="talk icon" />
                                </a>
                            </div>
                        </div>
                    </div>
                </li>
            }
        }
    </ul>

    <input type="hidden" id="TotalItem" value="@ViewBag.TotalItem" />
</div>

<script src="https://sp.zalo.me/plugins/sdk.js"></script>