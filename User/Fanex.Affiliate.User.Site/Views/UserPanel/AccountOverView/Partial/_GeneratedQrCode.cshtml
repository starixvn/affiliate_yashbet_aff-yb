
@{
    Layout = null;
}
@model  IEnumerable<Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.QrCodeLinkViewModel>

@helper RenderQrItem(Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.QrCodeLinkViewModel item)
{
var defaultImg = Url.Content("~/www/build/styles/Images/account-overview/qr-disabled.png");
var disabled = item.IsShow ? "" : "disabled";
var checkStatus = item.IsShow ? "checked" : "";
var downloadName = item.DisplayName + "_qrcode";
var selectedLinkType = (int)ViewBag.SelectedLinkType;
    <div class="qr-item"
         data-image-name="@downloadName"
         data-selected-page="@ViewBag.SelectedPage"
         data-selected-domain-id="@ViewBag.SelectedDomainId"
         data-selected-channel="@ViewBag.SelectedChannel"
         data-selected-link-type="@selectedLinkType"
         data-selected-language="@item.Language.Code"
         data-link="@item.Link"
         >
        <div class="main-panel flex">
            <div class="qr-img @disabled">
                <img class="default" src="@defaultImg" alt="default" />
                <img class="qrcode" src="@item.QrCode" alt="QR code" />
            </div>
            <div class="qr-action">
                <div class="flex space-between">
                    <div><label>@item.Language.NativeName</label></div>
                    <div class="toggle-btn"><input class="toggle-link" type="checkbox" data-toggle="toggle" data-width="27" @checkStatus /></div>
                </div>
                <div class="qr-btn-group">
                    <button @disabled class="btn-copy-qr">@Lang.CopyQRCode</button>
                    <button class="btn-save-img" @disabled>
                        @Lang.SaveQRCode
                    </button>
                </div>
            </div>
        </div>
        <div class="qr-footer">
            <button class="btn-copy-link" @disabled>@Lang.CopyLink</button>
        </div>
    </div>
}

<div class="flex flex-wrap qr-panel">
    @{
        foreach (var model in Model)
        {
            @RenderQrItem(model);
        }
    }

</div>
<script src="@Url.RenderLink("~/www/build/js/lib/bootstrap2-toggle.js")"></script>
<script src="~/www/source/js/components/clipboard.min.js"></script>
<script src="@Url.RenderLink("~/www/build/js/generated-qrcode.js")"></script>
