@{
    Layout = null;
    var totalItem = ViewBag.TotalItem;
}

@model IEnumerable<Fanex.Affiliate.User.Core.DTO.UserPanel.MarketingItem>

<div class="list-container">
    <ul class="list-unstyled list-content">
        @if (totalItem < 1)
        {
            <li><p class="text-center">@Lang.NoInfo</p></li>
        }
        else
        {
            foreach (var text in Model)
            {

                <li>
                    <p class="marketing-text">@Html.Raw(text.Message)</p>
                    <div class="marketing-action flex">
                        <div class="flex-middle">
                            <button class="btn-marketing-copy">@Lang.Copy</button>
                        </div>
                        <div class="flex-0 aff-link">
                            @{
                                var uri = new Uri(text.RedirectLink);
                                var url = text.RedirectLink;
                                if (string.IsNullOrWhiteSpace(uri.Query))
                                {
                                    url = $"{text.RedirectLink}?ref=";
                                }
                                else
                                {
                                    url = $"{text.RedirectLink}&ref=";
                                }
                                var encodedText = Html.Encode($"<a onclick='window.open(\"{url}\" + encodeURIComponent(window.location.href),\"_blank\"); return false;' href='javascript:;' target='_blank' id='_affMediaText'></a>"
                                                    + $"<script src=\"{@text.ScriptSrc}\"></script>");
                                @Html.Raw(encodedText);
                             }
                        </div>
                    </div>
                   
                </li>
            }
        }
    </ul>

    <input type="hidden" id="TotalItem" value="@ViewBag.TotalItem" />
</div>


