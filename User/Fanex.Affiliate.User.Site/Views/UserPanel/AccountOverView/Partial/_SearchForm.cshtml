@{ 
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.SearchFormViewModel

<div class="info-group" id="searchForm">
    <div class="title">
        <span class="text">@Lang.Search</span>
    </div>

    <div class="search-container">
        <form class="form-horizontal">
            @Html.HiddenFor(m => m.TargetId)

            @RazorHelper.RenderDropdownForMarketing("Category", Lang.Category, Model.CategoryList)

            @RazorHelper.RenderDropdownForMarketing("SubCategory", Lang.SubCategory, new List<SelectListItem>(), true, false)

            @RazorHelper.RenderDropdownForMarketing("Language", Lang.Language, Model.LanguageList)

            @RazorHelper.RenderDropdownForMarketing("Currency", Lang.Currency, Model.CurrencyList)

            <div class="form-group flex-sm-boostrap flex-center">
                <label class="col-sm-3 control-label">@Lang.Device</label>
                <div class="col-sm-9">
                    <select class="form-control" id="DeviceType">
                        @foreach (var item in EnumHelper.GetSelectList(typeof(Fanex.Affiliate.User.Core.Enum.DeviceType)))
                        {
                            <option value="@item.Value">@Lang.ResourceManager.GetString(item.Text)</option>
                        }
                    </select>

                </div>
            </div>

            @if (Model.SizeList != null)
            {
                @RazorHelper.RenderDropdownForMarketing("Size", Lang.Size, Model.SizeList)
            }

            <div class="form-group">
                <div class="col-sm-offset-3 col-sm-1">
                    <button type="button" class="btn btn-submit" id="btnMarketingSearch">@Lang.Search</button>
                </div>
            </div>
        </form>
    </div>
</div>