@{
    Layout = null;
}

@model IDictionary<string, Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.QrCodeLinkViewModel>
<div class="flex flex-wrap marketing-qrcode">
    @foreach (var key in Model.Keys)
    {
        <div class="flex flex-0 flex-lg-6">
            <label class="flex-3 control-label">@Model[key].DisplayName</label>
            <div class="flex-9">
                <button class="btn-copy-link" data-clipboard-text="@Model[key].Link">@Lang.CopyLink</button>
                <button class="btn-copy-qr">@Lang.CopyQRCode</button>
                @{
                    var downloadName = Model[key].DisplayName + "_qrcode";
                }
                <button class="btn-save-img"
                        data-image-name="@downloadName"
                        data-selected-page="@ViewBag.SelectedPage"
                        data-selected-domain-id="@ViewBag.SelectedDomainId"
                        data-selected-language="@Model[key].Language.Code">@Lang.SaveQRCode</button>
                <img class="qr-code" src="@Model[key].QrCode" alt="QR code" />
            </div>
        </div>
    }
</div>