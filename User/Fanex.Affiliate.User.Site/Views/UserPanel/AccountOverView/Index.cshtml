@{
    Layout = null;
}
@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.AccountOverviewViewModel

@Html.InlineStyles("~/www/build/styles/css/account-overview.min.css")

<div class="account-overview">
    <div class="tab-menu" id="account-overview-menu">
        <ul class="menu list-unstyled">
            <li><a href="javascript:;" data-name="Summary" class="menu-item account-overview-menu-item" id="menuSummary">@Lang.Summary</a></li>
            <li><a href="javascript:;" data-name="AffiliateLink" class="menu-item account-overview-menu-item" id="menuAffiliateLink">@Lang.AffilateLink</a></li>
            <li><a href="javascript:;" data-name="MediaGallery" class="menu-item account-overview-menu-item" id="menuMediaGallery">@Lang.MediaGallery</a></li>
        </ul>
    </div>
    <div class="bg-orange">
        <span class="text"><strong>@Lang.LastLogin</strong> @(Model.LastLoginInfo.LastLoginDate?.ToString("dd-MMM-yyyy hh:mm tt"))</span>
        <span class="text"><strong>@Lang.LastLoginIpAddress</strong> @(Model.LastLoginInfo.LastLoginIP)</span>
        <span class="text"><strong>@(Lang.AffiliateID):</strong> @(Model.LastLoginInfo.AffCode)</span>
    </div>
    <div id="account-overview-content"></div>
</div>

<script src="@Url.RenderLink("~/www/build/js/account-overview.js")"></script>