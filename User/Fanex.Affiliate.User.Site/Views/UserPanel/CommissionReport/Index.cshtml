@using Fanex.Affiliate.User.Core.Constants;
@{
    Layout = null;
    var currentYear = DateTimeOffset.Now.ToOffset(new TimeSpan(GMT.PlusEight, 0, 0)).Year;
    var baseCurrencies = ViewBag.BaseCurrencies as IEnumerable<Fanex.Affiliate.User.Core.DTO.UserPanel.Currency>;
    var defaultBaseCurrency = Convert.ToInt32(ViewBag.DefaultBaseCurrency);
}

@model bool

@Html.InlineStyles("~/www/build/styles/css/commissionreport.css")
<div class="sub-content">
    <div class="page-title">
        <span class="text">@Lang.CommissionReport</span>
    </div>

    <div class="info-group">
        <div class="group-control-select-table">
            <form class="form-inline">
                <div class="form-group">
                    <label>@Lang.Year:</label>
                    <select class="form-control" id="year">

                        @for (var i = currentYear; i >= 2020; i--)
                        {
                            var temp = i == currentYear ? "selected='selected'" : string.Empty;
                            <option @temp value="@i">@i</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>@Lang.BaseCurrency:</label>
                    <select class="form-control" id="base-currency">
                        @foreach (var currency in baseCurrencies)
                        {
                            var selected = currency.ExchangeId == defaultBaseCurrency ? "selected='selected'" : string.Empty;
                            <option @selected value="@currency.ExchangeId">@currency.Code</option>
                        }
                    </select>
                </div>
                <button type="button" class="btn btn-submit" id="btnSubmit">@Lang.Submit</button>
            </form>
        </div>
        <div class="report-container">
            <div class="commission-report table overview-table">
                <table id="dataTable">
                    <thead>
                        <tr class="overview-table-header">
                            <th width="3%" class="th">#</th>
                            <th width="12%" class="th" data-name="Month">
                                <div class="th-wrapper">
                                    <span>@Lang.Month</span>
                                    <div class="icon-container">
                                        <span class="caret asc"></span>
                                        <span id="defaultSorting" class="caret desc"></span>
                                    </div>
                                </div>
                            </th>
                            <th class="th" data-name="TurnOver">
                                <div class="th-wrapper">
                                    <span>@Lang.Turnover</span>
                                    <div class="icon-container">
                                        <span class="caret asc"></span>
                                        <span class="caret desc"></span>
                                    </div>
                                </div>
                            </th>
                            <th class="th" data-name="GGR">
                                <div class="th-wrapper">
                                    <span>@Lang.GGR</span>
                                    <div class="icon-container">
                                        <span class="caret asc"></span>
                                        <span class="caret desc"></span>
                                    </div>
                                </div>
                            </th>
                            <th class="th" data-name="PlatformFee">
                                <div class="th-wrapper">
                                    <span>@Lang.RoyaltyFee</span>
                                    <div class="icon-container">
                                        <span class="caret asc"></span>
                                        <span class="caret desc"></span>
                                    </div>
                                </div>
                            </th>
                            <th class="th" data-name="DepositFee">
                                <div class="th-wrapper">
                                    <span>@Lang.DepositFee</span>
                                    <div class="icon-container">
                                        <span class="caret asc"></span>
                                        <span class="caret desc"></span>
                                    </div>
                                </div>
                            </th>
                            <th class="th" data-name="WithdrawalFee">
                                <div class="th-wrapper">
                                    <span>@Lang.WithdrawalFee</span>
                                    <div class="icon-container">
                                        <span class="caret asc"></span>
                                        <span class="caret desc"></span>
                                    </div>
                                </div>
                            </th>
                            <th class="th" data-name="Bonus">
                                <div class="th-wrapper">
                                    <span>@Lang.Bonus</span>
                                    <div class="icon-container">
                                        <span class="caret asc"></span>
                                        <span class="caret desc"></span>
                                    </div>
                                </div>
                            </th>
                            <th class="th" data-name="Bonus">
                                <div class="th-wrapper">
                                    <span>@Lang.Rebate</span>
                                    <div class="icon-container">
                                        <span class="caret asc"></span>
                                        <span class="caret desc"></span>
                                    </div>
                                </div>
                            </th>
                            <th class="th" data-name="CommissionRate">
                                <div class="th-wrapper">
                                    <span>@Lang.CommRate</span>
                                    <div class="icon-container">
                                        <span class="caret asc"></span>
                                        <span class="caret desc"></span>
                                    </div>
                                </div>
                            </th>
                            <th class="th" data-name="Commission">
                                <div class="th-wrapper col-comm">
                                    <span>@(Lang.Commission)</span>
                                    <div class="icon-container">
                                        <span class="caret asc"></span>
                                        <span class="caret desc"></span>
                                    </div>
                                </div>
                            </th>
                            <th class="th" data-name="P2pRevenueShare">
                                <div class="th-wrapper">
                                    <span>@Lang.P2pRevenueShare</span>
                                    <div class="icon-container">
                                        <span class="caret asc"></span>
                                        <span class="caret desc"></span>
                                    </div>
                                </div>
                            </th>
                            @if (!Model)
                            {
                                <th class="th" data-name="SubCommRate">
                                    <div class="th-wrapper col-comm">
                                        <span>@(Lang.SubAffCommRate)</span>
                                        <div class="icon-container">
                                            <span class="caret asc"></span>
                                            <span class="caret desc"></span>
                                        </div>
                                    </div>
                                </th>
                                <th class="th" data-name="SubAffCommission">
                                    <div class="th-wrapper col-comm">
                                        <span>@(Lang.SubAffEarning)</span>
                                        <div class="icon-container">
                                            <span class="caret asc"></span>
                                            <span class="caret desc"></span>
                                        </div>
                                    </div>
                                </th>
                            }
                            <th class="th" data-name="TotalCommission">
                                <div class="th-wrapper col-comm">
                                    <span>@(Lang.TotalCommission)</span>
                                    <div class="icon-container">
                                        <span class="caret asc"></span>
                                        <span class="caret desc"></span>
                                    </div>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="reportData"></tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        var langResource = {
            noInfo: '@Lang.NoInfo',
            total: '@Lang.Total',
            theHighestShare: '@Lang.TheHighestShare',
            isMaxLevel: '@Model'.toLowerCase() === 'true'
        }
    </script>

    <script src="@Url.RenderLink("~/www/build/js/pages/commission-report.js")"></script>
</div>