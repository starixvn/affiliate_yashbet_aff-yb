@using Fanex.Affiliate.User.Core.Utilities
@using System.Globalization
@model Fanex.Affiliate.User.Core.DTO.UserPanel.PlayerTransferBalance.PlayerTransferBalanceHistoryResult
@{
    var decimalFormat = "#,#0.00";
}

<table>
    <thead>
        <tr class="overview-table-header">
            <th rowspan="2" width="5%">#</th>
            <th rowspan="2" width="15%">@Lang.TransactionID</th>
            <th rowspan="2" width="15%">@Lang.Date</th>
            <th rowspan="2" width="15%">@Lang.Status</th>
            <th rowspan="2" width="15%">@Lang.Player</th>
            <th colspan="3" width="35%">@Lang.Amount</th>
        </tr>
        <tr class="overview-table-header">
            <th colspan="2" width="20%">@Lang.InPlayerCurrency</th>
            <th width="20%">@SiteFriendlyNameHelper.ReplaceTranslateVariable(Lang.InBaseCurrency, "baseCurrency", ViewBag.BaseCurrency)</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model.Items != null && Model.Items.Any())
            {
                int i = ViewBag.StartRowNumber;
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center">
                            @i
                        </td>
                        <td class="text-center">@item.TransId</td>
                        <td class="text-center">@item.TransTime.ToString("MM/dd/yyyy HH:mm:ss")</td>
                        <td class="text-center">@item.Status</td>
                        <td class="text-center">@item.PlayerName</td>
                        <td class="text-center">@item.Currency</td>
                        <td class="text-right">@item.Amount.ToString(decimalFormat, CultureInfo.InvariantCulture)</td>
                        <td class="text-right">@item.AffPlayerAmount.ToString(decimalFormat, CultureInfo.InvariantCulture)</td>
                    </tr>
                    i++;
                }
                {
                    <tr>
                        <td colspan="7" class="text-center bg-highlight text-bold">@Lang.TotalAllPage</td>
                        <td class="text-right bg-highlight text-bold">@Model.TotalBaseAmount.ToString(decimalFormat, CultureInfo.InvariantCulture)</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center no-info" colspan="8">@Lang.NoInfo</td>
                </tr>
            }
        }
    </tbody>
</table>

<input id="TotalItem" type="hidden" value="@Model.TotalRow" />
