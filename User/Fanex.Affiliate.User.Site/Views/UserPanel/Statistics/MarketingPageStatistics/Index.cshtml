@{
    Layout = null;
}

@Html.InlineStyles("~/www/build/styles/css/statistics.css")

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Statistics.MarketingPageStatisticsViewModel
<div class="sub-content">
    <div class="page-title">
        <span class="text">@Lang.MarketLinkStatistics</span>
    </div>
    <div class="info-group">
        <div class="group-control-select-table">
            <form class="form-inline form-filter">
                <div class="form-group">
                    <label>@Lang.From:</label>
                    <div id="fromPicker" class="date-wrapper">
                        <input readonly id="FromDate" class="form-control" type="text" value="@Model.FromDate.ToString("MM/dd/yyyy")" />
                        <span class="glyphicon glyphicon-calendar"></span>
                    </div>
                </div>
                <div class="form-group">
                    <label>@Lang.To:</label>
                    <div id="toPicker" class="date-wrapper">
                        <input readonly id="ToDate" class="form-control" type="text" value="@Model.ToDate.ToString("MM/dd/yyyy")" />
                        <span class="glyphicon glyphicon-calendar"></span>
                    </div>
                </div>
                <div class="form-group">
                    <label>@Lang.Language:</label>
                    @Html.DropDownList("language", (IEnumerable<SelectListItem>)ViewBag.Languages, Lang.All, new { @class = "form-control" })
                </div>
                <div class="checkbox form-group">
                    <label class="text-bold">
                        <input id="includeInActive" type="checkbox" />
                        @Lang.IncludeInActiveLink
                    </label>
                </div>
                <button type="button" class="btn btn-submit btn-statistics" id="btnStatisticsSubmit">@Lang.Submit</button>
            </form>
        </div>
        <div class="report-container">
            <div class="table overview-table marketing-statistics" id="statisticsTable">
            </div>

        </div>
    </div>

    <script src="@Url.RenderLink("~/www/build/js/marketing-statistics.js")"></script>
</div>