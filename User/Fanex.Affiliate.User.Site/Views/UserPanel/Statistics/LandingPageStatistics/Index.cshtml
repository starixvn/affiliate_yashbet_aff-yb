@{
    Layout = null;
}

@Html.InlineStyles("~/www/build/styles/css/statistics.css")

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Statistics.LandingPageStatisticsViewModel
<div class="sub-content">
    <div class="page-title">
        <span class="text">@Lang.LandingPages</span>
    </div>
    <div class="info-group">
        <div class="group-control-select-table">
            <form class="form-inline form-filter">
                <div class="form-group">
                    <label>@Lang.Device:</label>
                    <select id="DeviceType" class="form-control">
                        @foreach (var item in EnumHelper.GetSelectList(typeof(Fanex.Affiliate.User.Core.Enum.DeviceType)))
                        {
                            <option value="@item.Value">@Lang.ResourceManager.GetString(item.Text)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>@Lang.Language:</label>
                    <select id="Language" class="form-control">
                        <option value="">@Lang.All</option>
                        @foreach (var language in Model.LanguageList)
                        {
                            <option value="@language.Value">@language.Text</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>@Lang.Page:</label>
                    <select id="SportCode" class="form-control">
                        <option value="">@Lang.All</option>
                        @foreach (var page in Model.MemberSitePageList)
                        {
                            <option value="@page.PageCode">@page.PageName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>@Lang.From:</label>
                    <div id="fromPicker" class="date-wrapper">
                        <input readonly class="form-control" type="text" id="FromDate" value="@Model.FromDate.ToString("MM/dd/yyyy")" />
                        <span class="glyphicon glyphicon-calendar"></span>
                    </div>
                </div>
                <div class="form-group">
                    <label>@Lang.To:</label>
                    <div id="toPicker" class="date-wrapper">
                        <input readonly class="form-control" type="text" id="ToDate" value="@Model.ToDate.ToString("MM/dd/yyyy")" />
                        <span class="glyphicon glyphicon-calendar"></span>
                    </div>
                </div>
                <button type="button" class="btn btn-submit btn-statistics" id="btnStatisticsSubmit">@Lang.Submit</button>
            </form>
        </div>
        <div class="report-container">
            <div class="table overview-table" id="statisticsTable">
                @{ Html.RenderPartial("~/Views/UserPanel/Statistics/StatisticsPartial/_LandingPageStatisticsContent.cshtml", Model); }
            </div>

            <div id="statisticsDetailPager"></div>
            <div class="table detail table-paging overview-table" id="statisticsDetailTable">
            </div>
        </div>
    </div>

    <script src="@Url.RenderLink("~/www/build/js/pages/landingpagestatistics.js")"></script>
</div>