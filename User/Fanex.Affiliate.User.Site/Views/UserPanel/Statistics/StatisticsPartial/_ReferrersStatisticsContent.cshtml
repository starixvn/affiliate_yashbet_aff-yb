@using Fanex.Affiliate.User.Core.Extensions
@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Statistics.ReferrerStatisticsViewModel

<table style="table-layout: fixed; width: 100%">
    <thead>
        <tr class="overview-table-header">
            <th width="40%">@Lang.WebsiteURL</th>
            <th width="15%">@Lang.TotalClick</th>
            <th width="15%">@Lang.UniqueClick</th>
            <th width="15%">@Lang.Signup</th>
            <th width="15%">@Lang.FDM</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model.DataList != null && Model.DataList.Any())
            {
                foreach (var item in Model.DataList)
                {
                    <tr>
                        <td>
                            @if (Model.IsDetail || item.DomainReferrer.MatchWith("none") || item.DomainReferrer.MatchWith("old url"))
                            {
                                @item.DomainReferrer
                            }
                            else
                            {
                                <a href="javascript:;" class="statisticsItem" data-domain="@item.DomainReferrer">@item.DomainReferrer</a>
                            }
                        </td>
                        <td class="text-right">@item.TotalClick</td>
                        <td class="text-right">@item.UniqueClick</td>
                        <td class="text-right">@item.SignUps</td>
                        <td class="text-right">@item.Fdm</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center no-info" colspan="5">@Lang.NoInfo</td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.IsDetail)
{
    <input id="TotalItem" type="hidden" value="@Model.RowNumber" />
}
