@{ 
    Layout = null;
}

@model Fanex.Affiliate.User.Core.DTO.Payment

<div class="info-group">
    <div class="title">
        <span class="text">@Lang.PendingRequest</span>
    </div>

    <form id="cancelPaymentForm">
        @Html.AntiForgeryToken()
        <div class="table payment-history payment-pending overview-table">
            <table>
                <thead>
                    <tr class="overview-table-header">
                        <th width="20%">@Lang.DateRequest</th>
                        <th width="20%">@Lang.RequestAmount</th>
                        <th width="20%">@Lang.Status</th>
                        <th width="20%"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">@Model.TransDate.ToString("MM/dd/yyyy hh:mm:ss tt")</td>
                        <td class="text-right">@Model.Amount.ToStringMoneyWithSymbol()</td>
                        <td class="text-center">@Lang.Proccessing</td>
                        <td class="text-center">
                            <button type="submit" class="btn btn-submit" id="cancelPaymentRequest">@Lang.CancelRequest</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <input type="hidden" name="TransId" id="TransId" value="@Model.TransId" />
        <input type="hidden" name="Amount" id="Amount" value="@Convert.ToDouble(Model.Amount)" />
        <input type="hidden" name="RequestDate" id="RequestDate" value="@Model.TransDate.ToString("MM/dd/yyyy")" />
    </form>
</div>

