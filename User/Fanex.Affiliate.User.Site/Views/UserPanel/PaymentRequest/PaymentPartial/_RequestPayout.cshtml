@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.PaymentViewModel
@{
    var canRequest = Model.IsValidAmount && Model.IsValidDate && Model.PendingPayment == null;

    var messageResult = GetErrorMessage();

    @functions {
        string GetErrorMessage()
        {
            string method = string.IsNullOrEmpty(Model.PreferredPayment) ? string.Empty : Model.PreferredPayment.Replace("Wire", Lang.BankTransfer);
            if (!method.MatchWith("Player"))
            {
                return SiteFriendlyNameHelper.ReplaceB2C(Error.PaymentMethodInvalid).Replace("{0}", method)
                            .Replace("{1}", Url.Content("~/UserPanel/Main/#MyAccount"));
            }

            if (!Model.IsValidAmount)
            {
                return Error.PaymentBalanceInvalid;
            }

            if (!Model.IsValidDate)
            {
                return Error.PaymentPayoutTimeInvalid;
            }

            if (Model.PendingPayment != null)
            {
                return Lang.Err3001;
            }

            return string.Empty;
        }
    }
}

<div class="info-question">
    <div id="resultMessage" style="display: none">
        @if (!string.IsNullOrEmpty(messageResult))
        {
            <p class="alert alert-danger" role="alert">@Html.Raw(messageResult)</p>
        }
    </div>
    <div class="info-question-payment">
        <div class="title">
            <span class="text">@Lang.PaymentInfor</span>
        </div>
        <div class="body-result">
            <form id="requestPayoutForm" class="form">
                @Html.AntiForgeryToken()
                <div class="form-group form-columns form-columns-2">
                    <div class="items validate-group">
                        <label class="custom-label">@Lang.BalForward</label>
                        <input type="text" value="@Model.BalBroughtForward.ToStringMoneyWithSymbol()" class="form-input disable" />
                    </div>
                    <div class="items validate-group">
                        <label class="custom-label">@Lang.RequestAmt</label>
                        <input type="text" class="form-input" name="Amount" id="Amount" @(canRequest ? string.Empty : "disabled") autocomplete="off" />
                    </div>
                </div>
                <div class="form-group form-columns form-columns-2">
                    <div class="items validate-group">
                        <label class="custom-label">@Lang.BalForward</label>
                        <input type="text" value="@Model.BalBroughtForward.ToStringMoneyWithSymbol()" class="form-input disable" />
                    </div>
                    <div class="items validate-group mobile-center-validate">
                        <button href="#" class="custom-button" type="submit">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M11.3333 10.6668H12.6667V2.66683H6V4.00016H11.3333V10.6668ZM11.3333 12.0002V14.0002C11.3333 14.3682 11.0333 14.6668 10.662 14.6668H2.67133C2.58342 14.6674 2.49626 14.6505 2.41488 14.6172C2.3335 14.584 2.25949 14.535 2.19711 14.473C2.13472 14.4111 2.0852 14.3374 2.05137 14.2563C2.01754 14.1751 2.00009 14.0881 2 14.0002L2.002 4.66683C2.002 4.29883 2.302 4.00016 2.67333 4.00016H4.66667V2.00016C4.66667 1.82335 4.7369 1.65378 4.86193 1.52876C4.98695 1.40373 5.15652 1.3335 5.33333 1.3335H13.3333C13.5101 1.3335 13.6797 1.40373 13.8047 1.52876C13.9298 1.65378 14 1.82335 14 2.00016V11.3335C14 11.5103 13.9298 11.6799 13.8047 11.8049C13.6797 11.9299 13.5101 12.0002 13.3333 12.0002H11.3333ZM4.66667 10.6668V12.0002H6V12.6668H7.33333V12.0002H7.66667C8.10869 12.0002 8.53262 11.8246 8.84518 11.512C9.15774 11.1994 9.33333 10.7755 9.33333 10.3335C9.33333 9.89147 9.15774 9.46755 8.84518 9.15498C8.53262 8.84242 8.10869 8.66683 7.66667 8.66683H5.66667C5.57826 8.66683 5.49348 8.63171 5.43096 8.5692C5.36845 8.50669 5.33333 8.4219 5.33333 8.3335C5.33333 8.24509 5.36845 8.16031 5.43096 8.09779C5.49348 8.03528 5.57826 8.00016 5.66667 8.00016H8.66667V6.66683H7.33333V6.00016H6V6.66683H5.66667C5.22464 6.66683 4.80072 6.84242 4.48816 7.15498C4.17559 7.46755 4 7.89147 4 8.3335C4 8.77552 4.17559 9.19945 4.48816 9.51201C4.80072 9.82457 5.22464 10.0002 5.66667 10.0002H7.66667C7.75507 10.0002 7.83986 10.0353 7.90237 10.0978C7.96488 10.1603 8 10.2451 8 10.3335C8 10.4219 7.96488 10.5067 7.90237 10.5692C7.83986 10.6317 7.75507 10.6668 7.66667 10.6668H4.66667Z" fill="white" />
                            </svg>
                            @Lang.RequestPayout
                        </button>
                    </div>
                </div>
                @Html.HiddenFor(p => p.BalBroughtForward)
                @Html.HiddenFor(p => p.MinAmount)
            </form>
        </div>
    </div>
</div>
