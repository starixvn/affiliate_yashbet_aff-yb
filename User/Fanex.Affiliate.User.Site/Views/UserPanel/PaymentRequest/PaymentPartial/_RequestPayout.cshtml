@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.PaymentViewModel
@{
    var canRequest = Model.IsValidAmount && Model.IsValidDate && Model.PendingPayment == null;

    var messageResult = GetErrorMessage();

    @functions {
        string GetErrorMessage()
        {
            string method = string.IsNullOrEmpty(Model.PreferredPayment) ? string.Empty : Model.PreferredPayment.Replace("Wire", Lang.BankTransfer);
            if (!method.MatchWith("Player"))
            {
                return SiteFriendlyNameHelper.ReplaceB2C(Error.PaymentMethodInvalid).Replace("{0}", method)
                            .Replace("{1}", Url.Content("~/UserPanel/Main/#MyAccount"));
            }

            if (!Model.IsValidAmount)
            {
                return Error.PaymentBalanceInvalid;
            }

            if (!Model.IsValidDate)
            {
                return Error.PaymentPayoutTimeInvalid;
            }

            if (Model.PendingPayment != null)
            {
                return Lang.Err3001;
            }

            return string.Empty;
        }
    }
}

<div class="info-group">
    <div id="resultMessage" style="display: none">
        @if (!string.IsNullOrEmpty(messageResult))
        {
            <p class="alert alert-danger" role="alert">@Html.Raw(messageResult)</p>
        }
    </div>
    <div class="title">
        <span class="text">@Lang.PaymentInfor</span>
    </div>
    <div class="payment-info">
        <form id="requestPayoutForm" class="form-horizontal">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="control-label">@Lang.BalForward</label>
                <div class="control-input">
                    <p class="form-control-static">@Model.BalBroughtForward.ToStringMoneyWithSymbol()</p>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label">@Lang.MinWithdraw</label>
                <div class="control-input">
                    <p class="form-control-static">@((Model.MinAmount).ToStringMoneyWithSymbol())</p>
                </div>
            </div>
            <div class="form-group flex-mobile">
                <label class="control-label">@Lang.RequestAmt</label>
                <div class="control-input">
                    <input type="text" class="form-control" name="Amount" id="Amount" @(canRequest ? string.Empty : "disabled") autocomplete="off" />
                </div>
            </div>
            @if (canRequest)
            {
                <button id="btnRequestPayout" type="submit" class="btn btn-submit disabled">@Lang.RequestPayout</button>
            }
            else
            {
                <button type="button" class="btn btn-submit disabled" disabled>@Lang.RequestPayout</button>
            }

            @Html.HiddenFor(p => p.BalBroughtForward)
            @Html.HiddenFor(p => p.MinAmount)
        </form>
    </div>
</div>
