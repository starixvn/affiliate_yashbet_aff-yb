@{
    Layout = null;
}
@using Fanex.Affiliate.User.Core.Constants;
@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.PaymentViewModel

@{
    var paymentList = Model.PaymentList;
    var hasData = paymentList != null && paymentList.Any();
    var preferredPayment = Model.PreferredPayment ?? string.Empty;
    var paymentMethod = preferredPayment.Replace("Wire", Lang.BankTransfer);
}

@functions {
    static string ConvertStatus(string status)
    {
        switch (status.ToLower())
        {
            case PaymentStatus.Processing:
                return Lang.Proccessing;
            case PaymentStatus.Completed:
                return Lang.Approved;
            case PaymentStatus.Cancelled:
                return Lang.Cancelled;
            case PaymentStatus.Approved:
                return Lang.Approved;
            case PaymentStatus.Rejected:
                return Lang.Rejected;
            default:
                return Lang.Unknown;
        }
    }

    static string ConvertPaymentMethod(string paymentMethod)
    {
        switch (paymentMethod)
        {
            case "Player":
                return SiteFriendlyNameHelper.ReplaceB2C(Lang._B2CPlayerAcc);
            default:
                return paymentMethod;
        }
    }
}


<div class="payment-history table overview-table reset-top" id="payment-history">
    <table>
        <thead>
            <tr class="overview-table-header">
                <th width="10%">@Lang.RefNo</th>
                <th width="10%" class="non-transform">@Lang.DateRequest</th>
                <th width="10%">@Lang.RequestAmount</th>
                <th width="10%">@Lang.PaymentMethod</th>
                <th width="10%" class="non-transform">@Lang.CompletedDate</th>
                <th width="10%">@Lang.Status</th>
                <th width="20%">@Lang.Description</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (hasData)
                {
                    foreach (var item in paymentList)
                    {
                        <tr>
                            <td class="text-center">@item.TransId</td>
                            <td class="text-center">@item.TransDate.ToString("MM/dd/yyyy")</td>
                            <td class="text-right">@item.Amount.ToStringMoneyWithSymbol()</td>
                            <td class="text-center">@ConvertPaymentMethod(paymentMethod)</td>
                            <td class="text-center">@item.CompletedDate.ToString("MM/dd/yyyy")</td>
                            <td class="text-center text-bold">@ConvertStatus(item.Status)</td>
                            <td>@Html.Raw(item.AffDesc)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center no-info" colspan="7">@Lang.NoInfo</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>