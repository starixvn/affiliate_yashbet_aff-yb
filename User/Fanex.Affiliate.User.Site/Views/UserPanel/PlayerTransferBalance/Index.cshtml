@{
    Layout = null;
}

@Html.InlineStyles("~/www/build/styles/css/player-transfer-balance.css")

<input hidden readonly id="confirm-transfer-text" value="@Lang.ConfirmTransferBalanceSubmit.ToString()"/>

<div class="page-title">
    <span class="text">@Lang.TransferBalanceForPlayer</span>
</div>

<div class="alert" role="alert" id="messageResult" style="display: none"></div>
<div class="info-group">
    <div class="form-horizontal">
        <div class="form-group flex-mobile">
            <label class="control-label">@Lang.PlayerUserName </label>
            <div class="control-input">
                <input class="form-control" id="playerUserName" />
            </div>
            <div class="control-btn-text">
                <button class="btn btn-submit" id="btn-search">@Lang.Search</button>
            </div>
        </div>
        <div class="transfer-info hidden">
            <div class="form-group">
                <label class="control-label" id="player-currency-label">@Lang.PlayerCurrency</label>
                <div class="control-input padding-mobile">
                    <span class="form-control-static" id="player-currency">USD</span>
                </div>
            </div>
            <div class="form-group flex-start">
                <div class="control-label">
                    <div class="text-bold">@Lang.AvailableBalance</div>
                    <div class="text-bold" id="payment-acc-label">@Lang.InYourPaymentAcc</div>
                </div>

                <div class="control-input padding-mobile">
                    <span class="text-uppercase money-spacing" id="avail-bal">0 USD</span>
                    <span class="text-uppercase money-spacing" id="avail-bal-base-currency">0 USD</span>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label">@Lang.TransferLimit</label>
                <div class="control-input padding-mobile">
                    <span class="text-uppercase money-spacing" id="transfer-limit">0 USD</span>
                    <span class="text-uppercase money-spacing" id="transfer-limit-base-currency">0 USD</span>
                </div>
            </div>
            <div class="form-group flex-mobile flex-start form-full-width">
                <label class="control-label" id="transfer-amount-label">@Lang.TransferAmountTo</label>
                <div class="control-input" id="exchangeRate">
                    <span class="text-uppercase" id="exchange-player-currency">USD</span>
                    <input class="form-control text-right" min="0" step="any" id="amount" type="text" />
                    <div class="control-btn-text" id="exchange-base-currency">~ 0 USD</div>
                </div>
            </div>
            <button class="btn btn-submit disabled" id="btn-submit">@Lang.Submit</button>
        </div>
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/player-transfer-balance.js")"></script>
