@{
    Layout = null;
    var baseCurrencies = ViewBag.BaseCurrencies as IEnumerable<Fanex.Affiliate.User.Core.DTO.UserPanel.Currency>;
    var selectedBaseCurrency = Convert.ToInt32(ViewBag.SelectedBaseCurrency);
}

@Html.InlineStyles("~/www/build/styles/css/statement-history.css")

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.DailyEarningViewModel
<div class="sub-content">
    <div class="page-title">
        <span class="text">@Lang.DailyEarnings</span>
    </div>

    <div>
        <div class="breadcrumb-container">
            <ol class="breadcrumb" id="dailyEarningBreadcrumb">
                <li><a href="@Url.Content($"~/UserPanel/Main/#StatementHistory?baseCurrency={selectedBaseCurrency}")">@Lang.StatementHistory</a></li>
            </ol>
        </div>

        <div class="form-inline form-filter">
            <div class="form-group">
                <label>@Lang.ProductType:</label>
                <select class="form-control" id="ProductId">
                    <option value="0">@Lang.All</option>

                    @if (Model.ProductList != null && Model.ProductList.Any())
                    {
                        foreach (var item in Model.ProductList)
                        {
                            <option value="@item.ProductId" @(item.ProductId == Model.SelectedProduct ? "selected" : string.Empty)>@item.ProductName</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>@Lang.BaseCurrency:</label>
                <select class="form-control" id="base-currency">
                    @foreach (var currency in baseCurrencies)
                    {
                        var selected = currency.ExchangeId == selectedBaseCurrency ? "selected='selected'" : string.Empty;
                        <option @selected value="@currency.ExchangeId">@currency.Code</option>
                    }
                </select>
            </div>
        </div>

        <div class="table overview-table" id="dailyEarningContent">
            @{ Html.RenderPartial("~/Views/UserPanel/StatementHistory/StatementHistoryPartial/_DailyEarningContent.cshtml", Model); }
        </div>
    </div>

    <input id="MonthDate" type="hidden" value="@ViewBag.MonthDate" />

    <script src="@Url.RenderLink("~/www/build/js/daily-earning.js")"></script>
</div>