@{
    Layout = null;
    var baseCurrencies = ViewBag.BaseCurrencies as IEnumerable<Fanex.Affiliate.User.Core.DTO.UserPanel.Currency>;
    var defaultBaseCurrency = ViewBag.DefaultBaseCurrency;
    var isClickBreadcumb = ViewBag.IsClickBreadcumb;
}
@model IEnumerable<Fanex.Affiliate.User.Core.ViewModels.UserPanel.StatementHistoryViewModel>

@Html.InlineStyles("~/www/build/styles/css/statement-history.css")

<div class="sub-content">
    <div class="page-title">
        <span class="text">@Lang.StatementHistory</span>
    </div>

    <div class="form-inline form-filter">
        <div class="form-group">
            <label>@Lang.BaseCurrency:</label>
            <select class="form-control" id="base-currency">
                @foreach (var currency in baseCurrencies)
                {
                    var selected = currency.ExchangeId == defaultBaseCurrency ? "selected='selected'" : string.Empty;
                    <option @selected value="@currency.ExchangeId">@currency.Code</option>
                }
            </select>
        </div>
    </div>

    <div class="info-group">
        <div id="statementPager"></div>
        <div id="statementDataList">
            @{ Html.RenderPartial("~/Views/UserPanel/StatementHistory/StatementHistoryPartial/_StatementHistoryContent.cshtml", Model); }
        </div>
    </div>

    <input type="hidden" id="isClickBreadcumb" value="@isClickBreadcumb" />
    <script src="@Url.RenderLink("~/www/build/js/statement-history.js")"></script>
</div>