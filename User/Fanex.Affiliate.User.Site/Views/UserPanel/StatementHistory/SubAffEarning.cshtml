@{
    Layout = null;
    Fanex.Affiliate.User.Core.ViewModels.UserPanel.BreadcrumbViewModel breadcrumb = ViewBag.Breadcrumb;
    var baseCurrencies = ViewBag.BaseCurrencies as IEnumerable<Fanex.Affiliate.User.Core.DTO.UserPanel.Currency>;
    var selectedBaseCurrency = ViewBag.SelectedBaseCurrency;
}

@Html.InlineStyles("~/www/build/styles/css/statement-history.css")

@model IEnumerable<Fanex.Affiliate.User.Core.ViewModels.UserPanel.SubAffComViewModel>
<div class="sub-content">
    <div class="page-title">
        <span class="text">@Lang.SubAffEarning</span>
    </div>
    <div>
        @{
            if (breadcrumb != null)
            {
                <div class="breadcrumb-container">
                    <ol class="breadcrumb" id="dailyEarningBreadcrumb">
                        <li><a href="@Url.Content(breadcrumb.Url)">@breadcrumb.Name</a></li>
                    </ol>
                </div>
            }
        }
        <div class="form-inline form-filter">
            <input id="MonthDate" type="hidden" value="@ViewBag.MonthDate" />
            <div class="form-group">
                <label>@Lang.BaseCurrency:</label>
                <select class="form-control" id="base-currency">
                    @foreach (var currency in baseCurrencies)
                    {
                        var selected = currency.ExchangeId == selectedBaseCurrency ? "selected='selected'" : string.Empty;
                        <option @selected value="@currency.ExchangeId">@currency.Code</option>
                    }
                </select>
            </div>
        </div>
        <div class="table overview-table" id="subAffEarning">
            @Html.Partial("~/Views/UserPanel/StatementHistory/StatementHistoryPartial/_SubAffEarningContent.cshtml", Model)
        </div>
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/sub-affiliate-earning.js")"></script>