@model IEnumerable<Fanex.Affiliate.User.Core.ViewModels.UserPanel.StatementHistoryViewModel>

@helper RenderItem(Fanex.Affiliate.User.Core.ViewModels.UserPanel.StatementHistoryViewModel item, int id, int? parentId = null, int? index = null)
{
    var isLink = item.TransType != (byte)Fanex.Affiliate.User.Core.Enum.TransType.Payment
    && item.TransType != (byte)Fanex.Affiliate.User.Core.Enum.TransType.Adjustment
    && item.TransType != (byte)Fanex.Affiliate.User.Core.Enum.TransType.MonthlyTotal
    && DateTime.Compare(item.MonthDate, ViewBag.AvailableFromDate) > 0;

    var hasChildren = item.Children == null || item.Children.Count() > 0;
    var displayClass = parentId != null ? "display-none" : "";

    <tr data-id='@id' data-parent='@parentId' class='@displayClass'>
        <td class="text-center">@index</td>
        <td class="text-bold">
            <div class="flex">
                <span class="flex-0">@item.DateString</span>
                @if (hasChildren)
                {
                    <div class="flex-middle">
                        <button class="btn btn-transparent btn-dropdown-table">
                        </button>
                    </div>
                }
            </div>
        </td>
        <td>@item.TransTypeString</td>
        <td class="text-right">
            @if (isLink)
            {
                <a class="amountItem" data-date="@item.MonthDate.ToString("yyyy-MM-dd")" data-transtype="@item.TransType" href="javascript:;">
                    @item.Amount.ToStringMoneyWithSymbol()
                </a>
            }
            else
            {
                @item.Amount.ToStringMoneyWithSymbol()
            }
        </td>
        <td class="text-center">@item.DisplayStatus</td>
        <td>
            @if (item.TransType != (byte)Fanex.Affiliate.User.Core.Enum.TransType.Adjustment)
            {
                @Html.Raw(item.DescriptionDisplay)
            }
        </td>
    </tr>
}

<div class="table overview-table">
    <table>
        <thead>
            <tr class="overview-table-header">
                <th width="5%"></th>
                <th>@Lang.Date</th>
                <th>@Lang.Type</th>
                <th>@Lang.Amount</th>
                <th>@Lang.Status</th>
                <th>@Lang.Description</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null && Model.Any())
                {
                    var index = (int)ViewBag.StartRowNumber;
                    var id = 1;

                    foreach (var item in Model)
                    {
                        @RenderItem(item, id, index: index);
                        if (item.Children != null)
                        {
                            var parentId = id;
                            foreach (var child in item.Children)
                            {
                                id++;
                                @RenderItem(child, id, parentId: parentId)
                            }
                        }

                        index++;
                        id++;
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center no-info" colspan="6">@Lang.NoInfo</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<input type="hidden" id="TotalItem" value="@ViewBag.TotalItem" />

