@{
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
    ViewBag.Title = Lang.Home;
}

@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

@{
    var desktopBannerPath = Url.Content($"~/www/build/styles/Images/home/main-banners/main.desktop.{Model.Language}");
    var mobileBannerPath = Url.Content($"~/www/build/styles/Images/home/main-banners/main.mobile.{Model.Language}");
    var advMobile = Url.Content($"~/www/build/styles/Images/apply/3step.mobile.{Model.Language}");
    var advDesktop = Url.Content($"~/www/build/styles/Images/apply/3step.desktop.{Model.Language}");
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/home.css")" rel="stylesheet" />
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/home.js")
}

<div class="content home-page">

    <div class="swiper top-banner">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <a class="nounderline home-banner-tracking-flat show-pc">
                    <picture>
                        <source srcset="~/www/build/styles/Images/home/main-banners/banner-pc-1.webp" type="image/webp" />
                        <source srcset="~/www/build/styles/Images/home/main-banners/banner-pc-1.jpg" type="image/jpeg" />
                        <img class="img-item img-responsive" src="~/www/build/styles/Images/home/main-banners/banner-pc-1.jpg" alt="Actived Home Banner" />
                    </picture>
                </a>
                <a class="nounderline home-banner-tracking-flat show-mobile">
                    <picture>
                        <source srcset="~/www/build/styles/Images/home/main-banners/banner-mb-1.webp" type="image/webp" />
                        <source srcset="~/www/build/styles/Images/home/main-banners/banner-mb-1.jpg" type="image/jpeg" />
                        <img class="img-item img-responsive" src="~/www/build/styles/Images/home/main-banners/banner-mb-1.jpg" alt="Actived Home Banner" />
                    </picture>
                </a>
            </div>
            <div class="swiper-slide">
                <a class="nounderline home-banner-tracking-flat show-pc">
                    <picture>
                        <source srcset="~/www/build/styles/Images/home/main-banners/banner-pc-1.webp" type="image/webp" />
                        <source srcset="~/www/build/styles/Images/home/main-banners/banner-pc-1.jpg" type="image/jpeg" />
                        <img class="img-item img-responsive" src="~/www/build/styles/Images/home/main-banners/banner-pc-1.jpg" alt="Actived Home Banner" />
                    </picture>
                </a>
                <a class="nounderline home-banner-tracking-flat show-mobile">
                    <picture>
                        <source srcset="~/www/build/styles/Images/home/main-banners/banner-mb-1.webp" type="image/webp" />
                        <source srcset="~/www/build/styles/Images/home/main-banners/banner-mb-1.jpg" type="image/jpeg" />
                        <img class="img-item img-responsive" src="~/www/build/styles/Images/home/main-banners/banner-mb-1.jpg" alt="Actived Home Banner" />
                    </picture>
                </a>
            </div>
        </div>
        <div class="swiper-pagination"></div>
    </div>

    <div class="page-container">
        <div class="block apply-block">
            <div class="image-apply">
                <img src="~/www/build/styles/Images/home/aplly.png" alt="aplly" class="img-responsive show-pc" />
                <img src="~/www/build/styles/Images/home/aplly-mb.png" alt="aplly" class="img-responsive show-mobile" />
            </div>
            <div class="text-apply">
                As affiliates, you will earn revenue share on every player you referred to YashBet over the course of the player's account life.<br />
                Your online system will be serving  you 24/7 for your usage.
            </div>
        </div>
        <div class="block what-new-block">
            <div class="flex-2-column">
                <div class="column column-left">
                    <div class="group-contact">
                        <div class="group-title show-pc">
                            <h2 class="title-block">
                                <span>What’s new in Affiliate</span>
                            </h2>
                        </div>
                        <div class="slogan-block">
                            Can't Get Enough!
                        </div>
                        <div class="heading-block">
                            YOUR CURRENT REVENUE SHARE?
                        </div>
                        <div class="txt-block">
                            Contact your affiliates support team for exclusive revenue rate to growth bigger revenue in your monthly earning
                        </div>
                        <div class="view-more">
                            <a href="#" class="button-bg">Contact Now</a>
                        </div>
                    </div>
                </div>
                <div class="column column-right">
                    <div class="group-title show-mobile">
                        <h2 class="title-block">
                            <span>What’s new in Affiliate</span>
                        </h2>
                    </div>
                    <div class="img-what-new">
                        <img src="~/www/build/styles/Images/home/what-new.png" alt="aplly" class="img-responsive" />
                    </div>
                </div>
            </div>
        </div>
        <div class="block news-block">
            <div class="group-title">
                <h2 class="title-block">
                    <span>Yashbet Affiliate news</span>
                </h2>
            </div>
            <div class="flex-2-column">
                <div class="column column-left">
                    <div class="card-items">
                        <div class="new-bage">
                            <img src="~/www/build/styles/Images/icons/star-fill.svg" alt="start" />
                            <span>new</span>
                        </div>
                        <div class="card-items-header">
                            New banner is now available!
                        </div>
                        <div class="card-items-body">
                            You can now log in your affiliate account to  get new banners to promote in your website.
                        </div>
                    </div>
                </div>
                <div class="column column-right">
                    <div class="card-items">
                        <div class="new-bage">
                            <img src="~/www/build/styles/Images/icons/star-fill.svg" alt="start" />
                            <span>new</span>
                        </div>
                        <div class="card-items-header">
                            What's New in YashBet Promotion !
                        </div>
                        <div class="card-items-body">
                            You can now log in your affiliate account to  get new banners to promote in your website.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<input type="hidden" id="shortedLangCode" value="@Model.ShortedLanguageCode" />
<input type="hidden" id="isCLickedBannerLink" value="0" />
