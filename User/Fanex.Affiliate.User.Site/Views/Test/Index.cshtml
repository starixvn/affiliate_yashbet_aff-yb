@{
    Layout = null;
    var settingService = DependencyResolver.Current.GetService<IAppSetting>();
    var siteName = settingService.SiteName.ToLower();
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Email</title>
    <link rel="icon" href=@Url.VersionedLink("~/favicon-" + siteName + ".ico")>
</head>
<body>
    <div>
        <div>
            Format:
            <label for="Html">
                <input name="Format" id="Html" type="radio" checked value="cshtml" />
                Html
            </label>
            <label for="PlainText">
                <input name="Format" id="PlainText" type="radio" value="txt" />
                Plain Text
            </label>
        </div>
        <div>
            Language:
            <label for="enUS">
                <input name="Language" id="enUS" type="radio" checked value="en-US" />
                English
            </label>
            <label for="bnBD">
                <input name="Language" id="bnBD" type="radio" value="bn-BD" />
                Bangladeshi
            </label>
            <label for="kmKH">
                <input name="Language" id="kmKH" type="radio" value="km-KH" />
                Cambodian
            </label>
            <label for="idID">
                <input name="Language" id="idID" type="radio" value="id-ID" />
                Indonesian
            </label>
            <label for="thTH">
                <input name="Language" id="thTH" type="radio" value="th-TH" />
                Thai
            </label>
            <label for="viVN">
                <input name="Language" id="viVN" type="radio" value="vi-VN" />
                Vietnamese
            </label>
            <label for="zhCN">
                <input name="Language" id="zhCN" type="radio" value="zh-CN" />
                Chinese Simplified
            </label>
            <label for="hiIN">
                <input name="Language" id="hiIN" type="radio" value="hi-IN" />
                India
            </label>
            <label for="msMY">
                <input name="Language" id="msMY" type="radio" value="ms-MY" />
                Malay
            </label>
        </div>

        <div>
            Function:
            <label for="Csd">
                <input name="Function" id="Csd" type="radio" value="Csd" />
                Csd
            </label>
            <label for="RecoverPassword">
                <input name="Function" id="RecoverPassword" type="radio" checked value="RecoverPassword" />
                Forgot Password
            </label>
            <label for="PaymentCancel">
                <input name="Function" id="PaymentCancel" type="radio" value="PaymentCancel" />
                Payment Cancel
            </label>
            <label for="PaymentRequest">
                <input name="Function" id="PaymentRequest" type="radio" value="PaymentRequest" />
                Payment Request
            </label>
            <label for="NewPassword">
                <input name="Function" id="NewPassword" type="radio" value="NewPassword" />
                Recover Password
            </label>
            <label for="VerificationAccount">
                <input name="Function" id="VerificationAccount" type="radio" value="VerificationAccount" />
                Verification Account
            </label>
        </div>

        <div>
            <input id="emailAddress" type="text" placeholder="enter email address to send" />
        </div>

        <div>
            <button type="button" id="btnPreview">Preview</button>
            <button type="button" id="btnSendMail">Send Email</button>
        </div>

        <div style="margin: 15px auto; border: 1px solid #808080; padding: 15px" id="resultContent">
        </div>
    </div>

    <input id="rootAction" type="hidden" value="@Url.Content("~/")" />
    <script src="~/www/build/js/lib/jquery-3.3.1.min.js"></script>
    <script src="~/www/build/js/test.js"></script>
</body>
</html>