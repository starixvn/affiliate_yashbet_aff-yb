@{
    Layout = null;
}
@{
    var from = ViewBag.UmTimeFrom as string;
    var to = ViewBag.UmTimeTo as string;

    var settingService = DependencyResolver.Current.GetService<IAppSetting>();
    var siteName = settingService.SiteName.ToLower();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="refresh" content="30" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Under Maintenance</title>
    <link rel="icon" href=@Url.Content("~/favicon-"+ siteName +".ico")>
    <link href="@Url.RenderLink("~/www/build/styles/css/maintenance.css")" rel="stylesheet" />
</head>
<body>
    <header class="um-header-top">
        <div class="page-container">
            <div class="group-logo">
                <div class="main-logo">
                    <img class="logo" src=@(Url.Content($"~/www/build/styles/Images/notify/maintenance-{siteName}.svg")) alt="The logo" />
                </div>
                <div class="logo-um">
                    <img class="logo" src="~/www/build/styles/Images/notify/banner-um.svg" alt="The banner" />
                </div>
                <div class="text-um">
                    Under Maintenance
                </div>
            </div>
        </div>
    </header>
    <div class="page-container">
        <div class="um-content">
            @*EN*@
            <div class="um-wrapper">
                <div class="um-header">
                    <img src="~/www/build/styles/Images/icons/flags/England.png" alt="England" />
                    <h1>Under Maintenance</h1>
                </div>

                <div class="message-content">
                    <p>We are having server maintenance, website will be unavailable until <span class="um-time info">@to (HK Time GMT +8).</span></p>
                    <p>Please accept our apologies for the inconvenience caused!</p>
                    <p>
                        To reach customer service, please contact CSD
                    </p>
                </div>
            </div>

            @*Hindi*@
            @*<div class="um-wrapper">
                <div class="um-header">
                    <img src="~/www/build/styles/Images/icons/flags/Hindi.png" alt="Hindi" />
                    <h1>रखरखाव जारी</h1>
                </div>

                <div class="message-content">
                    <p>हम सर्वर रखरखाव कर रहे हैं, वेबसाइट तब तक अनुपलब्ध रहेगी जब तक <span class="um-time info">@to (एचके टाइम जीएमटी +8).</span></p>
                    <p>असुविधा के लिए कृपया हमारी क्षमायाचना स्वीकार करें!</p>
                    <p>
                        ग्राहक सेवा तक पहुँचने के लिए, कृपया सीएसडी से संपर्क करें
                    </p>
                </div>
            </div>*@

            @*Banladeshi*@
            <div class="um-wrapper">
                    <div class="um-header">
                        <img src="~/www/build/styles/Images/icons/flags/Bangladeshi.png" alt="Bangladesh" />
                        <h1>রক্ষণাবেক্ষণের অধীনে</h1>
                    </div>

                    <div class="message-content">
                        <p>আমরা সার্ভার রক্ষণাবেক্ষণ করছি, ওয়েবসাইট পর্যন্ত অনুপলব্ধ হবে <span class="um-time info">@to (HK সময় GMT +8)</span></p>
                        <p>সৃষ্ট অসুবিধার জন্য আমাদের ক্ষমাপ্রার্থী গ্রহণ করুন!</p>
                        <p>
                            গ্রাহক সেবা পেতে, CSD-এর সাথে যোগাযোগ করুন
                        </p>
                    </div>
                </div>
        </div>
    </div>

    <div class="footer">
        <div class="line-footer"></div>
        <div class="page-container">
            <div class="footer-text text-center">
                @string.Format(SiteFriendlyNameHelper.ReplaceB2C(Lang.Copyright), DateTime.Now.Year)
            </div>
        </div>
    </div>
</body>
</html>