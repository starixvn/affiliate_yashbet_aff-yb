@{
    Layout = null;
}
@{
    var from = ViewBag.UmTimeFrom as string;
    var to = ViewBag.UmTimeTo as string;

    var settingService = DependencyResolver.Current.GetService<IAppSetting>();
    var siteName = settingService.SiteName.ToLower();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="refresh" content="30" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Under Maintenance</title>
    <link rel="icon" href=@Url.Content("~/favicon-"+ siteName +".ico")>
    <link href="@Url.RenderLink("~/www/build/styles/css/maintenance.css")" rel="stylesheet" />
</head>
<body>
    <div class="um-body">
        <header class="um-header-top">
            <div class="page-container">
                <div class="group-logo">
                    <div class="main-logo">
                        <img class="logo" src="~/www/build/styles/Images/notify/maintenance-yb.svg" alt="The logo" />
                    </div>
                    <div class="text-um">
                        Under Maintenance
                    </div>
                </div>
            </div>
        </header>
        <div class="page-container">
            <div class="um-content">
                @*EN*@
                <div class="um-wrapper">
                    <div class="um-header">
                        <img src="~/www/build/styles/Images/notify/eng.png" alt="eng" />
                        <h1>Under Maintenance</h1>
                    </div>

                    <div class="message-content">
                        <p>We are having server maintenance, website will be unavailable until <span class="um-time info">@to (HK Time GMT +8).</span></p>
                        <p>Please accept our apologies for the inconvenience caused!</p>
                        <p>
                            To reach customer service, please <a class="info" href="https://secure.livechatinc.com/licence/7903821/open_chat.cgi?groups=1" target="_blank">click here</a> or email to
                            <a class="info" href="mailto:support.my@12csd.com?subject=Enquiries%20sent%20from%2012BET%20website">
                                support.my@12csd.com
                            </a>
                        </p>
                    </div>
                </div>
                @*CS*@
                <div class="um-wrapper">
                    <div class="um-header">
                        <img src="~/www/build/styles/Images/notify/hi.png" alt="cs" />
                        <h1>伺服器维护</h1>
                    </div>

                    <div class="message-content">
                        <p>本公司正进行伺服器维护，时间至 <span class="um-time">@to (HK Time GMT +8).</span></p>
                        <p>所有网页将无法登入，不便之处有请见谅！</p>
                        <p>
                            如需要在线帮助，有请<a class="info" href="https://secure.livechatinc.com/licence/7903821/open_chat.cgi?groups=2" target="_blank">点击这里</a>或邮件至
                            <a class="info" href="mailto:support.cs@12csd.com?subject=Enquiries%20sent%20from%2012BET%20website">
                                support.cs@12csd.com
                            </a>
                        </p>
                    </div>
                </div>

                <div class="um-wrapper">
                    <div class="um-header">
                        <img src="~/www/build/styles/Images/notify/ba.png" alt="cs" />
                        <h1>伺服器维护</h1>
                    </div>

                    <div class="message-content">
                        <p>本公司正进行伺服器维护，时间至 <span class="um-time">@to (HK Time GMT +8).</span></p>
                        <p>所有网页将无法登入，不便之处有请见谅！</p>
                        <p>
                            如需要在线帮助，有请<a class="info" href="https://secure.livechatinc.com/licence/7903821/open_chat.cgi?groups=2" target="_blank">点击这里</a>或邮件至
                            <a class="info" href="mailto:support.cs@12csd.com?subject=Enquiries%20sent%20from%2012BET%20website">
                                support.cs@12csd.com
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer">
            <div class="line-footer"></div>
            <div class="page-container">
                <div class="footer-text text-center">
                    Copyright © 2008 - 2023 | yashbet. All Rights Reserved | 18+
                </div>
            </div>
        </div>
    </div>
</body>
</html>