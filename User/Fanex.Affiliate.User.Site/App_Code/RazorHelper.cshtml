@helper RenderMovingTopButton()
{
    <div class="moving-block">
        <button type="button" class="btn btn-circle btn-move-top" id="moveToTop" onclick="(function (event) { window.scrollTo({ top: 0, behavior: 'smooth' }); })(event);" style="display: none;">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M12.9997 7.828V20H10.9997V7.828L5.63568 13.192L4.22168 11.778L11.9997 4L19.7777 11.778L18.3637 13.192L12.9997 7.828Z" fill="white" />
            </svg>
        </button>
    </div>
}

@helper RenderLeftPanelItems(IDictionary<string, string> menuList)
{
    foreach (var item in menuList)
    {
        <li>
            <a class="parent-menu menu-item left-menu-item" href="#@item.Key">
                @item.Value
            </a>
        </li>
    }
}

@helper RenderLeftPanel(IDictionary<string, string> menuList)
{
    <div class="mobile-left-panel">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="17" viewBox="0 0 16 17" fill="none">
            <path d="M7.33333 3.1665H14V4.49984H7.33333V3.1665ZM7.33333 5.83317H11.3333V7.1665H7.33333V5.83317ZM7.33333 9.83317H14V11.1665H7.33333V9.83317ZM7.33333 12.4998H11.3333V13.8332H7.33333V12.4998ZM2 3.1665H6V7.1665H2V3.1665ZM3.33333 4.49984V5.83317H4.66667V4.49984H3.33333ZM2 9.83317H6V13.8332H2V9.83317ZM3.33333 11.1665V12.4998H4.66667V11.1665H3.33333Z" fill="white" />
        </svg>
        <span>@Fanex.Affiliate.User.Core.Resources.Lang.ListCategory</span>
    </div>
    <div class="left-panel">
        <div class="menu desktop-left-panel-menu">
            <div class="heading-left-panel">
                @Fanex.Affiliate.User.Core.Resources.Lang.ListCategory
            </div>
            <ul class="nav navbar-nav desktop-left-panel-nav">
                @RenderLeftPanelItems(menuList)
            </ul>
        </div>
    </div>
    <div class="modal fade leftmenu-dialog" tabindex="-1" role="dialog" id="leftmenu">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-main-content">
                    <div class="modal-body">
                        <div class="left-panel mobile-left-panel-menu">
                            <div class="menu">
                                <div class="heading-left-panel">
                                    @Fanex.Affiliate.User.Core.Resources.Lang.ListCategory
                                    <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="29" viewBox="0 0 28 29" fill="none">
                                            <path d="M13.9999 12.4713L19.7749 6.69629L21.4245 8.34596L15.6495 14.121L21.4245 19.896L19.7749 21.5456L13.9999 15.7706L8.22486 21.5456L6.5752 19.896L12.3502 14.121L6.5752 8.34596L8.22486 6.69629L13.9999 12.4713Z" fill="white" />
                                        </svg>
                                    </button>
                                </div>
                                <ul class="nav navbar-nav mobile-left-panel-nav">
                                    @RenderLeftPanelItems(menuList)
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@helper RenderLeftPanelParentItems(IDictionary<string, Fanex.Affiliate.User.Core.Constants.PrarentMenu> parentMenuList)
{
    foreach (var parentItem in parentMenuList)
    {
        <a class="parent-menu menu-item left-menu-item" href="javascript:;">
            @parentItem.Value.Title
        </a>
        <ul class="sub-menu-group">
            @foreach (var subItem in parentItem.Value.SubMenuList)
            {
                <li>
                    <a class="sub-menu menu-item left-menu-item" href="#@subItem.Key">
                        @subItem.Value
                    </a>
                </li>
            }
        </ul>
    }
}

