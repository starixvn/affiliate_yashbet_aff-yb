@helper RenderMovingTopButton()
{
    <div class="moving-block">
        <button type="button" class="btn btn-circle btn-move-top" id="moveToTop" onclick="(function (event) { window.scrollTo({ top: 0, behavior: 'smooth' }); })(event);" style="display: none;">
            <img src="~/www/source/styles/Images/arrrow.png" alt="back-to-top" />
        </button>
    </div>
}

@helper RenderLeftPanelItems(IDictionary<string, string> menuList)
{
    foreach (var item in menuList)
    {
        <li>
            <a class="left-menu-item" href="#@item.Key">
                @item.Value
            </a>
        </li>
    }
}

@helper RenderLeftPanel(IDictionary<string, string> menuList)
{
    <div class="mobile-left-panel">
        <span>@Fanex.Affiliate.User.Core.Resources.Lang.ListCategory</span>
    </div>
    <div class="left-panel" id="left-panel-menu">
        <div class="menu">
            <ul class="nav navbar-nav" id="left-panel-nav">
                @RenderLeftPanelItems(menuList)
            </ul>
        </div>
    </div>
    <div class="modal fade leftmenu-dialog" tabindex="-1" role="dialog" id="leftmenu">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-main-content">
                    <div class="modal-body">
                        <div class="left-panel">
                            <div class="menu">
                                <ul class="nav navbar-nav">
                                    @RenderLeftPanelItems(menuList)
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal-->
}

@helper RenderHotNews()
{
    <div class="hot-news">
        <div class="inner">
            <div class="title">@Fanex.Affiliate.User.Core.Resources.Lang.HotNews</div>
            <div class="message">
                <div class="marquee-container" id="marqueeContainer"><p class="marquee-content" id="marquee"></p></div>
            </div>
        </div>
    </div>
}

@helper RenderDropdownForMarketing(string id, string label, IEnumerable<System.Web.Mvc.SelectListItem> dataList, bool hasAllOption = true, bool isVisible = true)
{
    if (dataList != null)
    {
        <div class="form-group flex-sm-boostrap flex-center @(isVisible ? string.Empty : "hide")">
            <label class="control-label">@label</label>
            <div class="control-input">
                <select class="form-control" id="@id">
                    @if (hasAllOption)
                    {
                        <option value="">@Fanex.Affiliate.User.Core.Resources.Lang.All</option>
                    }

                    @foreach (var item in dataList)
                    {
                        <option value="@item.Value" @(item.Selected ? "selected" : string.Empty)>@item.Text</option>
                    }
                </select>
            </div>
        </div>
    }
}

@helper RenderAppContact(string language)
{
    const string firstAppName = "Skype";
    var secondAppContactList = new Dictionary<string, string>
    {
        ["en-US"] = "Facebook",
        ["ms-MY"] = "Facebook",
        ["zh-CN"] = "QQ",
        ["zh-TW"] = "QQ",
        ["vi-VN"] = "Zalo",
        ["th-TH"] = "Line",
        ["id-ID"] = "WhatsApp",
        ["hi-IN"] = "WhatsApp",
        ["ko-KR"] = "Telegram",
        ["ja-JP"] = "Facebook"
    };
    var hasTwoContactApp = secondAppContactList.ContainsKey(language);

    <div class="form-group">
        <label class="col-sm-3 control-label @(hasTwoContactApp ? string.Empty : "require")">@firstAppName</label>
        @if (hasTwoContactApp)
        {
            <div class="col-sm-4">
                <input type="text" name="ContactAppList[0].Value" id="ContactAppList[0].Value" class="form-control" value=""
                       data-val="true" data-val-requiredifnullorempty-dependentprop="ContactAppList[1].Value"
                       data-val-requiredifnullorempty="@Fanex.Affiliate.User.Core.Resources.Error.RequireIMAccount" />
            </div>
        }
        else
        {
            <div class="col-sm-4">
                <input type="text" name="ContactAppList[0].Value" id="ContactAppList[0].Value" class="form-control" value=""
                       data-val="true" data-val-required="@Fanex.Affiliate.User.Core.Resources.Error.RequireIMAccount" />
            </div>
        }
        <div class="col-sm-offset-3 col-sm-9">
            <span class="field-validation-valid help-block hide"
                  data-valmsg-for="ContactAppList[@(hasTwoContactApp ? 0 : 1)].Value" data-valmsg-replace="true"></span>
        </div>
        <input type="hidden" name="ContactAppList[0].Name" value="@firstAppName" />
        <input type="hidden" name="ContactAppList[0].Order" value="1" />
    </div>

    if (secondAppContactList.ContainsKey(language))
    {
        var secondAppName = secondAppContactList[language];
        <div class="form-group">
            <label class="col-sm-3 control-label">@secondAppName</label>
            <div class="col-sm-4">
                <input type="text" name="ContactAppList[1].Value" id="ContactAppList[1].Value" class="form-control" value=""
                       data-val="true" data-val-requiredifnullorempty-dependentprop="ContactAppList[0].Value"
                       data-val-requiredifnullorempty="@Fanex.Affiliate.User.Core.Resources.Error.RequireIMAccount" />
            </div>
            <div class="col-sm-offset-3 col-sm-9">
                <span class="field-validation-valid help-block hide"
                      data-valmsg-for="ContactAppList[1].Value" data-valmsg-replace="true"></span>
            </div>
            <input type="hidden" name="ContactAppList[1].Name" value="@secondAppName" />
            <input type="hidden" name="ContactAppList[1].Order" value="2" />
        </div>
    }
}