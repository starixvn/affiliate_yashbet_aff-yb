@helper RenderHotNews()
{
    <div class="hot-news">
        <div class="inner">
            <div class="title">
                <img src="~/www/build/styles/Images/icons/achment.svg" alt="achment" />
                @Fanex.Affiliate.User.Core.Resources.Lang.HotNews
            </div>
            <div class="message">
                <div class="marquee-container" id="marqueeContainer"><p class="marquee-content" id="marquee"></p></div>
            </div>
        </div>
    </div>
}

@helper RenderDropdownForMarketing(string id, string label, IEnumerable<System.Web.Mvc.SelectListItem> dataList, bool hasAllOption = true, bool isVisible = true)
{
    if (dataList != null)
    {
        <div class="items validate-group @(isVisible ? string.Empty : "hide")">
            <label class="custom-label">@label</label>
            <select class="form-input form-select" id="@id">
                @if (hasAllOption)
                {
                    <option value="">@Fanex.Affiliate.User.Core.Resources.Lang.All</option>
                }

                @foreach (var item in dataList)
                {
                    <option value="@item.Value" @(item.Selected ? "selected" : string.Empty)>@item.Text</option>
                }
            </select>
        </div>
    }
}

@helper RenderGender(string attrMale = "checked", string attrFemale = null)
{
    <div class="items validate-group">
        <label class="custom-label require" for="male">@Fanex.Affiliate.User.Core.Resources.Lang.Gender</label>
        <div class="radio-group">
            <label class="radio-button">
                <input type="radio" name="Gender" id="male" value="True" @attrMale />
                <span class="radio-circle @attrMale"></span>
                <span class="radio-label">@Fanex.Affiliate.User.Core.Resources.Lang.Male</span>
            </label>
            <label class="radio-button">
                <input type="radio" name="Gender" id="female" value="False" @attrFemale />
                <span class="radio-circle @attrFemale"></span>
                <span class="radio-label">@Fanex.Affiliate.User.Core.Resources.Lang.Female</span>
            </label>
        </div>
    </div>
}

@helper RenderAppContactItem(string name, int index, string dependentProp, string value = null, bool isOnlyOne = false)
{
    var messageErr = Fanex.Affiliate.User.Core.Resources.Error.RequireIMAccount;

    <div class="items validate-group">
        @if (isOnlyOne)
        {
            <label for="ContactAppList[@index].Value" class="custom-label require">@name</label>
            <input type="text" name="ContactAppList[@index].Value" id="ContactAppList[@index].Value" class="form-input"
                   value="@value" data-val="true" data-val-required="@messageErr" />
        }
        else
        {
            <label for="ContactAppList[@index].Value" class="custom-label">@name</label>
            <input type="text" name="ContactAppList[@index].Value" id="ContactAppList[@index].Value" class="form-input"
                   value="@value" data-val="true" data-val-requiredifnullorempty-dependentprop="@dependentProp" data-val-requiredifnullorempty="@messageErr" />
        }
        <span class="field-validation-valid validate-input hide"
              data-valmsg-for="ContactAppList[@index].Value" data-valmsg-replace="true"></span>

        <input type="hidden" name="ContactAppList[@index].Name" value="@name" />
        <input type="hidden" name="ContactAppList[@index].Order" value="@(index + 1)" />
    </div>

}