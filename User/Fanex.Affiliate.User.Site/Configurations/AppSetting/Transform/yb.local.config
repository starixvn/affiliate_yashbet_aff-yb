<?xml version="1.0" encoding="utf-8"?>
<appSettings xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <add key="Environment" value="LOCAL" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="PromotionYBLink" value="https://aff-yb.nexdev.net/YBUser/Promotion" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="BannerDomain" value="https://aff-yb.nexdev.net/YBBanner/" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

  <add key="LoggingCategory" value="Affiliate-YB" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

  <!--MemberSiteSetting-->
  <add key="MemberSiteApiUrl" value="https://aff-yb.nexdev.net/YBAPI" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="MemberSiteId" value="1" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>

  <!--Site-->
  <add key="SiteName" value="YB" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="SiteFriendlyName" value="YashBet" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="DefaultLanguageCode" value="en-US" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="DefaultShortedLanguageCode" value="en" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="MinWithdrawal" value="100" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="DefaultCurrency" value="INR" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="MaxCommission" value="45%" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="CurrencySymbol" value="USD&#160;" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="CurrencyLabel" value="&lt;br /&gt;(USD)" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="EndDatePromotion" value="2022-02-28T16:00:00.000Z" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="MailContact" value="my@YashBetaff.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>

  <!--UM-->
  <add key="ONEbook.UM:UMLoggingCategory" value="ONEbook-YB-UM" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
</appSettings>