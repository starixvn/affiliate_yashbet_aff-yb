    <authentication mode="Forms">
      <forms loginUrl="~/Portal/Login" path="/" timeout="20" cookieless="UseCookies" defaultUrl="~/Portal/Home" name=".AffAdminFormAuth.YB" protection="All" />
    </authentication>
    <authorization>
      <deny users="?" />
      <!--allow users="*"/-->
    </authorization>
    <sessionState mode="StateServer" cookieName="Fanex.AffAdminSession" stateConnectionString="tcpip=ha.nexdev.net:42424" cookieless="false" timeout="20" />
