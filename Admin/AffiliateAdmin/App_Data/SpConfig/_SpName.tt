<#@ template debug="true" hostSpecific="true" #>
<#@ output extension=".txt" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Linq" #>
<#@ include file="$(SolutionDir)\packages\T4.TemplateFileManager.2.2.1\tools\ttinc\TemplateFilemanager.CS.ttinclude" #>
<#@ include file="_SpNameConfiguration.ttinclude" #>

<#
    var manager = TemplateFileManager.Create(this);
    foreach(var site in sites)
    {
        var fileName = site.Environment == "DEV" ? "SpName.xml" : string.Format("SpName.admin-{0}.{1}.xml", site.LicenseeName, site.Environment);
		var spConfigs = Helper.GetListOfSpConfig();
		var allSpNames = Helper.GetAllSpNames();
        manager.StartNewFile(fileName);
		#>
<#=site.GenerateSpName(allSpNames, spConfigs)#>
		<#
    }
    manager.Process();
#>