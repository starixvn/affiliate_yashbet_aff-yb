exports[`commission group - TierSettingItem Should render correctly with MaxAmout, MaxAp 1`] = `
<tr>
  <td
    className="text-center"
  >
    1
  </td>
  <td>
    <Input
      id="MinAmount1"
      name="MinAmount"
      onChange={[Function]}
      type="text"
      value="100"
    />
  </td>
  <td>
    <Input
      id="MinAp1"
      name="MinAp"
      onChange={[Function]}
      type="text"
      value="10"
    />
  </td>
  <td>
    <select
      className="form-control"
      name="Commission"
      onChange={[Function]}
      value="0.000"
    >
      <option
        key="comm-0"
        value="0"
      >
        0.0%
      </option>
