              <Input
                id="deviceType"
                name="deviceType"
                onChange={[Function]}
                type="select"
                value={0}
              >
                <option
                  key="deviceType-0"
                  value={0}
                >
                  PC / Laptop
                </option>
                <option
                  key="deviceType-1"
                  value={1}
                >
                  Mobile
                </option>
              </Input>
            </Col>
          </FormGroup>
        </Form>
        <Button
          className="mr-3"
          color="success"
          onClick={[Function]}
          tag="button"
          type="button"
        >
          Upload
        </Button>
        <Button
          color="info"
          onClick={[Function]}
          tag="button"
          type="button"
        >
          Cancel
        </Button>
      </div>
    </div>
  </ModalBody>
</Modal>
`;
