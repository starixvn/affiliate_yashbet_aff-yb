
@{
    Layout = null;
}
@model ONEbook.UM.Models.UnderMaintenanceTime

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Under Maintenance</title>
    <link rel="icon" href=@Url.VersionedLink("~/favicon.ico")>
    <link href="~/Areas/Portal/www/dist/vendors/bootstrap.css?v=4.3.1" rel="stylesheet" />
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/under-maintenance.css")" rel="stylesheet" />
</head>
<body>
    <div id="root">
    </div>
    <script type="text/javascript">
        window.initialState = {
