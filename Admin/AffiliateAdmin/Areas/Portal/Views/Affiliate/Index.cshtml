@model Fanex.Affiliate.Admin.Core.ViewModels.Affiliate.AffiliateInfoViewModel

@{
    Html.RenderPartial("~/Areas/Portal/Views/Affiliate/_AffiliateSubMenu.cshtml", Model.SubMenuList);
}

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/affiliate-info.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            commGroupList: @Html.Raw(Json.Encode(Model.CommGroupList)),
            languageList: @Html.Raw(Json.Encode(Model.LanguageList)),
            groupId: @Model.SelectedGroupId,
            param: @Html.Raw(Json.Encode(Model.Param))
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/affiliate/affiliate-info.js")"></script>
}