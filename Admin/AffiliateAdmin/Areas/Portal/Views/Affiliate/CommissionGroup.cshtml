@model Fanex.Affiliate.Admin.Core.ViewModels.CommissionGroupViewModel

@{
    Html.RenderPartial("~/Areas/Portal/Views/Affiliate/_AffiliateSubMenu.cshtml", Model.SubMenuList);
}

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/commission-group.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            productList: @Html.Raw(Json.Encode(Model.ProductList)),
            p2pProductList: @Html.Raw(Json.Encode(Model.P2pProductList)),
            deductionList: @Html.Raw(Json.Encode(Model.DeductionList)),
            defaultCurrency: '@(AppSetting.Instance.DefaultCurrency)'
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/commission/commission-group.js")"></script>
}

