@model Fanex.Affiliate.Admin.Core.ViewModels.MediaGallery.TextListViewModel

@{
    Html.RenderPartial("~/Areas/Portal/Views/MediaGallery/_MediaGallerySubMenu.cshtml", Model.SubMenuList);
}

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/media-gallery/text-list.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            categoryList: @Html.Raw(Json.Encode(Model.CategoryList)),
            languageList: @Html.Raw(Json.Encode(Model.LanguageList)),
            currencyList: @Html.Raw(Json.Encode(Model.CurrencyList)),
            defaultLanguage: '@AppSetting.Instance.DefaultLanguage'
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/media-gallery/text-list.js")"></script>
}

