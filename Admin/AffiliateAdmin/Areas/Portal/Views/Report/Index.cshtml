@model Fanex.Affiliate.Admin.Core.ViewModels.Report.AffiliateReportViewModel
@{
    var appSetting = AppSetting.Instance;
    //DateTimeOffset cutOffDateOffset = DateTime.SpecifyKind(Model.ReportCutOffDate, DateTimeKind.Utc);
}
@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/report.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            productList: @Html.Raw(Json.Encode(Model.ProductList)),
            languageList: @Html.Raw(Json.Encode(Model.LanguageList)),
            today: '@DateTimeOffset.Now.ToOffset(new TimeSpan(8, 0, 0)).ToString("MM/dd/yyyy")',
            reportCutOffDate: '@Model.ReportCutOffDate.ToString("MM/dd/yyyy")',
            currencyList: @Html.Raw(Json.Encode(Model.CurrencyList)),
            baseCurrencyList: @Html.Raw(Json.Encode(Model.BaseCurrencyList)),
            paymentCurrencyList: @Html.Raw(Json.Encode(Model.PaymentCurrencyList)),
            isProduction: '@(appSetting.Environment)'.toLowerCase() === 'production',
            commGroupList: @Html.Raw(Json.Encode(Model.CommGroupList)),
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/report.js")"></script>
}