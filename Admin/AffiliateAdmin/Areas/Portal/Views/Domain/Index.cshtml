@{
    var isAffDomain = Model.IsAffDomain;
}

@model Fanex.Affiliate.Admin.Core.ViewModels.Domain.DomainViewModel

@{
    Html.RenderPartial("~/Areas/Portal/Views/Domain/_DomainSubMenu.cshtml", Model.SubMenuList);
}

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/domain/domain.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            isAffDomain: '@isAffDomain'.toLowerCase() === 'true',
            licenseeName: '@(AppSetting.Instance.SiteFriendlyName)'
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/domain/domain.js")"></script>
}