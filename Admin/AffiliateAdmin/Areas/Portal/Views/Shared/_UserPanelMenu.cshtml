@model Fanex.Affiliate.Admin.Core.ViewModels.UserPanel.UserPanelMenuViewModel

<table cellspacing="0" cellpadding="0" width="100%" border="0">
    <tbody>
        <tr>
            <td width="48">
                <span class="icon-userpanel"></span>
            </td>
            <td>
                <ul class="d-inline-block menu-list">
                    @foreach (var item in Model.SubMenuList)
                    {
                        <li class="up-item">
                            <a class="upitem-link @(item.IsActive ? "active" : string.Empty)" href="@item.Url?affId=@(Model.AffiliateLinkParam.AffId)&affName=@(Model.AffiliateLinkParam.AffName)">
                                <span class="menu-text">@item.Name</span>
                            </a>
                        </li>
                    }
                </ul>
            </td>
            <td width="32">
                <div id="icon_refresh_big" title="Refresh" onclick="location.reload();">&nbsp;</div>
            </td>
        </tr>
    </tbody>
</table>