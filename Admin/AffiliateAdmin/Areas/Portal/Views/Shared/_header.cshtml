@using Fanex.Affiliate.Admin.Core.Configurations;
@{
    var appSetting = DependencyResolver.Current.GetService<IAppSetting>();
}

<div class="headWrapper">
    <div class="float-left logo">
        <img src=@Url.VersionedLink("~/Areas/Portal/www/dist/imgs/theme/" + appSetting.SiteName + ".png") />
    </div>
    <div class="float-left user-info">
        <span class="font-weight-bold icon-top">
            Welcome, @(HttpContext.Current.User.Identity.Name)
        </span>
        <a class="text-redlink btn-changePassword" href="@Url.Content("~/Portal/ChangeAdminPassword")" target="_top">[Change Password]</a>
        <a class="text-redlink btn-logout" href="@Url.Content("~/Portal/Auth/Logout")" target="_self">[Logout]</a>
    </div>

    <div class="float-right clock-container">
        <span class="oi oi-clock"></span><span id="clock"></span> +8
    </div>
</div>
