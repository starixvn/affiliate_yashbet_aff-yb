@using Fanex.Affiliate.Admin.Core.Configurations;
@{
    var appSetting = DependencyResolver.Current.GetService<IAppSetting>();
    var siteName = appSetting.SiteName;
}
<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="icon" href=@Url.VersionedLink("~/favicon.ico")>
    <base href="@Url.Content("~")" />
    <link href="~/Areas/Portal/www/dist/vendors/bootstrap.css?v=4.3.1" rel="stylesheet" />
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/portalmain.css")" rel="stylesheet" />
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/layout.css")" rel="stylesheet" />
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/"+siteName+".css")" rel="stylesheet" />

    @RenderSection("vendorcss", required: false)
    <title>Affiliate Admin</title>
</head>
<body>
    <div class="body-container">
        <header class="header">
            @{ Html.RenderPartial("~/Areas/Portal/Views/Shared/_Header.cshtml"); }
        </header>
        <div class="main-menu-container">
            @{ Html.RenderPartial("~/Areas/Portal/Views/Shared/_MainMenu.cshtml"); }
        </div>
        <div class="main-container">
            @Html.AntiForgeryToken()
            <input type="hidden" id="RootUrl" value="@Url.Content("~")" />
            @RenderBody()
        </div>

        <footer class="footer" style="position: fixed; bottom: 0; left: 0; right: 0; height: 25px; text-align: center;">
            @*<span style="padding: 5px 15px; font-size: 11px; font-family: Arial, Helvetica, sans-serif">&copy; Copyright @DateTime.Now.Year Pacific Sea Invests</span>*@
        </footer>
    </div>

    <script src="~/Areas/Portal/www/dist/jquery-3.3.1.min.js"></script>
    <script src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/layout/pagelayout.js")"></script>
    <iframe width="0" height="0" style="display: none" src="@Url.Content("~/Portal/Auth/ReCheckIn")"></iframe>
    @RenderSection("vendorjs", required: false)

</body>
</html>