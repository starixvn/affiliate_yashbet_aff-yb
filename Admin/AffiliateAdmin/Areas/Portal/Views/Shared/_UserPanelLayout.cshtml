@{
    Layout = "~/Areas/Portal/Views/Shared/_SinglePageLayout.cshtml";
}

@section styles{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/user-panel-layout.css")" rel="stylesheet" />
    <style type="text/css">
        .main-container {
            padding: 0;
        }

        .user-panel-content-container{
            padding-right: 10px;
        }

        .breadcrumb{
            padding: 0 0.75rem;
            background: transparent;
            margin-bottom: 0;
        }

        .breadcrumb-item.active{
            color: #333;
        }
    </style>
    @RenderSection("styles", required: false)
}

@section scripts{
    @RenderSection("scripts", required: false)
}

<div class="user-panel-container">
    <div class="user-panel-menu-container">
        @RenderSection("menu", required: false)
    </div>
    <div class="user-panel-content-container">
        @RenderBody()
    </div>
</div>