@model Fanex.Affiliate.Admin.Core.DTO.Email.PaymentRequestUpdateEmail

    <div>
        Dear @Raw(Model.FirstName),  <br /><br />

        Request reference number is @Model.TransId, dated @Model.TransDate.<br /><br />

        We are pleased to inform that your payment request amount of @Model.Amount @Model.DefaultCurrency has been completed successfully and money sent to your payment processor.<br /><br />

        This is a system auto generated email, please do not reply to this email directly. <br />
        Do not hesitate to contact us if you have any questions or comments at <a href="mailto:@Model.MailContact">@Model.MailContact</a><br /> <br />

        Sincerely,<br /><br />
        @(Model.SiteFriendlyName) Affiliates Team<br />
        <a href="mailto:@Model.MailContact">@Model.MailContact</a>
    </div>