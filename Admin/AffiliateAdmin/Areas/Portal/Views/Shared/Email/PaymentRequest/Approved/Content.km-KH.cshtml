@model Fanex.Affiliate.Admin.Core.DTO.Email.PaymentRequestUpdateEmail

<div>
    សូមគោរព @Raw(Model.FirstName),  <br /><br />

    ស្នើសុំលេខយោងគឺ @Model.TransId, ចុះថ្ងៃទី @Model.TransDate<br /><br />

    យើងមានសេចក្តីសោមនស្សរីករាយក្នុងការជូនដំណឹងថាចំនួនទឹកប្រាក់នៃការស្នើសុំការទូទាត់របស់អ្នកចំនួន @Model.Amount @Model.DefaultCurrency ត្រូវបានអនុញ្ញាដោយជោគជ័យ ហើយប្រាក់បានផ្ញើទៅដំណើរការទូទាត់របស់អ្នក។<br /><br />

    នេះជាអ៊ីមែលដែលគ្រប់គ្រងដោយប្រព័ន្ធស្វ័យប្រវត្តិ សូមកុំឆ្លើយតបអ៊ីមែលនេះដោយផ្ទាល់<br />
    សូមកុំស្ទាក់ស្ទើរក្នុងការទាក់ទងមកកាន់យើងខ្ញុំ <a href="mailto:@Model.MailContact">@Model.MailContact</a> ប្រសិនបើលោកអ្នកមានចម្ងល់ ឬ មតិយោបល់បន្ថែមទៀត<br /> <br />

    ដោយក្តីគោរព<br /><br />
    ក្រុមសាខាសម្ព័ន្ធ @(Model.SiteFriendlyName)<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>