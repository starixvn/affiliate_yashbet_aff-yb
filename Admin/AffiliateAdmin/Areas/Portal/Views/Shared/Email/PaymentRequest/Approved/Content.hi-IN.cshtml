@model Fanex.Affiliate.Admin.Core.DTO.Email.PaymentRequestUpdateEmail

<div>
    प्रिय @Raw(Model.FirstName),  <br /><br />

    अनुरोध संदर्भ संख्या @Model.TransId है, दिनांक @Model.TransDate<br /><br />

    हमें यह सूचित करते हुए प्रसन्नता हो रही है कि आपके भुगतान अनुरोध की @Model.Amount @Model.DefaultCurrency की राशि सफलतापूर्वक पूरी हो गई है और आपके भुगतान प्रोसेसर को पैसा भेज दिया गया है।<br /><br />

    यह एक सिस्टम स्वतः उत्पन्न ईमेल है, कृपया इस ईमेल का उत्तर न दें। <br />
    यदि आपके पास <a href="mailto:@Model.MailContact">@Model.MailContact</a> . पर कोई प्रश्न या टिप्पणी है, तो हमसे संपर्क करने में संकोच न करें<br /> <br />

    आपका,<br /><br />
    @(Model.SiteFriendlyName) सहयोगी टीम<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>