@model Fanex.Affiliate.Admin.Core.DTO.Email.PaymentRequestUpdateEmail

<div>
    प्रिय @Raw(Model.FirstName),  <br /><br />

    अनुरोध संदर्भ संख्या @Model.TransId है, दिनांक @Model.TransDate<br /><br />

    हमें आपको यह बताते हुए खेद हो रहा है कि आपके @Model.Amount @Model.DefaultCurrency के भुगतान अनुरोध को अस्वीकार कर दिया गया है।<br /><br />

    सहायता के लिए कृपया हमसे <a href="mailto:@Model.MailContact">@Model.MailContact</a> पर संपर्क करें।<br />
    यह एक सिस्टम स्वतः उत्पन्न ईमेल है, कृपया इस ईमेल का उत्तर न दें।<br /><br />

    आपका,<br /><br />
    @(Model.SiteFriendlyName) सहयोगी टीम<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>