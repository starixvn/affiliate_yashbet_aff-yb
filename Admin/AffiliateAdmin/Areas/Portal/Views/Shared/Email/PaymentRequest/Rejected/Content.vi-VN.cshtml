@model Fanex.Affiliate.Admin.Core.DTO.Email.PaymentRequestUpdateEmail

<div>
    Kính gửi @Raw(Model.FirstName),<br /><br />

    Bạn đã gửi cho chúng tôi yêu cầu thanh toán số @Model.TransId vào ngày @Model.TransDate.<br /><br />

    Chúng tôi rất tiếc thông báo yêu cầu thanh toán của bạn với số tiền @Model.Amount @Model.DefaultCurrency đã bị từ chối.<br />

    Vui lòng liên hệ <a href="mailto:@Model.MailContact">@Model.MailContact</a> để được hỗ trợ.<br />

    Đây là thư tự động do hệ thống gửi, xin vui lòng không trả lời trực tiếp thư này.<br />

    Thân mến,<br /><br />
    Chương trình đại lý @(Model.SiteFriendlyName).<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>