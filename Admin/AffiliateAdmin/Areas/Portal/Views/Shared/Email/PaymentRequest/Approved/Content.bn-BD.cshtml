@model Fanex.Affiliate.Admin.Core.DTO.Email.PaymentRequestUpdateEmail

<div>
    প্রিয় @Raw(Model.FirstName),  <br /><br />

    অনুরোধ রেফারেন্স নম্বর হল @Model.TransId, তারিখ @Model.TransDate<br /><br />

    আমি সন্তুষ্ট মনে করছি যে, আপনার @Model.Amount @Model.DefaultCurrency পেমেন্ট অনুরোধটি সফলভাবে সম্পন্ন হয়েছে এবং অর্থ আপনার পেমেন্ট প্রসেসরে পাঠানো হয়েছে।<br /><br />

    এটি একটি সিস্টেম স্বয়ংক্রিয় জেনারেট ইমেল, দয়া করে এই ইমেলে সরাসরি উত্তর দিবেন না।<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a> এ যোগাযোগ করার জন্য আপনি যদি কোনও প্রশ্ন বা মন্তব্য থাকে তাহলে আমাদের সাথে যোগাযোগ করবেন।<br /> <br />

    সাদরে,<br /><br />
    @(Model.SiteFriendlyName) অফিলিয়েট টীম<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>