@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<div>
    Dear @Raw(Model.FirstName),<br /><br />

    I regret to inform you that your application to join the @(Model.SiteFriendlyName) Affiliates program has been disapproved/rejected. I apologise for any inconvenience this may have caused.<br /><br />

    If you have any queries regarding why your website has not met the required criteria, please feel free to contact me at <a href="mailto:@Model.MailContact">@Model.MailContact</a>.<br /><br />

    Sincerely,<br /><br />
    Affiliate Services Manager,<br />
    @(Model.SiteFriendlyName) Affiliates Team<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div> 