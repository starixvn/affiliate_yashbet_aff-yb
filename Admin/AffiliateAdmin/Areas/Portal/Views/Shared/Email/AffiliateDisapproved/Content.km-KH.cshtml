@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<div>
    សូមគោរព @Raw(Model.FirstName),<br /><br />

    ខ្ញុំសោកស្ដាយក្នុងការជូនដំណឹងដល់អ្នកថាពាក្យសុំចូលរួមកម្មវិធី សម្ព័ន្ធ @(Model.SiteFriendlyName) របស់អ្នកត្រូវបានបដិសេធ/បដិសេធ។ ខ្ញុំសូមអភ័យទោសចំពោះភាពរអាក់រអួលណាមួយដែលវាអាចបង្កឡើង។<br /><br />

    ប្រសិនបើអ្នកមានចម្ងល់ទាក់ទងនឹងមូលហេតុដែលគេហទំព័ររបស់អ្នកមិនបំពេញតាមលក្ខខណ្ឌតម្រូវ សូមទាក់ទងមកខ្ញុំតាមរយៈ <a href="mailto:@Model.MailContact">@Model.MailContact</a><br /><br />

    ដោយក្តីគោរព<br /><br />
    អ្នកគ្រប់គ្រងសេវាសាខាសម្ព័ន្ធ,<br />
    ក្រុមសាខាសម្ព័ន្ធ @(Model.SiteFriendlyName)<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div> 