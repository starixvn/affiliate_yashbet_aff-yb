@using Fanex.Affiliate.Admin.Core.Resources
@using Fanex.Affiliate.Admin.Core.Utilities
@model Fanex.Affiliate.Admin.Core.ViewModels.EmailTemplateViewModel
@*@{
    var siteName = AppSetting.Instance.SiteName;
}*@

<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.ImageRootUrl/@Model.SiteName/bgMain.png?v=002">
            <table width="599" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="88" background="@Model.ImageRootUrl/@Model.SiteName/banner_@(Model.Language).png?v=002"></td>
                </tr>
                @*<tr height="3">
                    <td height="3" bgcolor="#ff0000"></td>
                </tr>*@
                <tr>
                    <td>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr bgcolor="#ffffff">
                                <td width="100%" height="31" background="@Model.ImageRootUrl/@Model.SiteName/header.png?v=002">
                                    &nbsp;&nbsp;
                                    <strong style="color: rgb(255, 255, 255);">
                                        <font style="font-size: 9px; font-family: Verdana,Arial,Helvetica,sans-serif; text-transform: uppercase;">
                                            @Model.Title&nbsp;
                                        </font>
                                    </strong>
                                </td>
                                @*<td bgcolor="#f9f9f9" width="117">&nbsp;</td>*@
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td bgcolor="#ffffff">
                        <br />
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="15">&nbsp;</td>
                                <td>
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        @Raw(Model.Content)
                                    </font>
                                </td>
                                <td width="15">&nbsp;</td>
                            </tr>
                        </table>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="400">&nbsp;</td>
                                <td align="center" width="185" height="41" background="@Model.ImageRootUrl/@Model.SiteName/button.png?v=002">
                                    <a href="@Model.UserSiteUrl" style="text-decoration: none; border: 0px; color: rgb(255, 255, 255); margin-left: 20px">
                                        <font style="font-size: 20px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 1.5">
                                            @Lang.Affiliate
                                        </font>
                                    </a><br />
                                </td>
                                <td width="19">&nbsp;</td>
                            </tr>
                            <tr>
                                <td colspan="3" height="30">&nbsp;</td>
                            </tr>
                            <tr>
                                <td colspan="2" align="right" bgcolor="#b6b6b6" height="30" style="text-align: center">
                                    <font style="font-size: 11px; color: #333333; font-family: Verdana,Arial,Helvetica,sans-serif;">
                                        @string.Format(SiteFriendlyNameHelper.ReplaceB2C(Lang.Copyright), DateTime.Now.Year)
                                    </font>
                                </td>
                                <td width="5" bgcolor="#b6b6b6"></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td heght="20">&nbsp;</td>
                </tr>
                <tr>
                    <td align="center" height="48" background="@Model.ImageRootUrl/note.png?v=002">
                        <font style="font-size: 11px; color: rgb(255, 255, 255); font-family: Verdana,Arial,Helvetica,sans-serif;">
                            @Lang.EmailAutoNotification
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>