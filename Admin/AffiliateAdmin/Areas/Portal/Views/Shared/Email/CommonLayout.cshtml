@using Fanex.Affiliate.Admin.Core.Resources
@using Fanex.Affiliate.Admin.Core.Utilities
@model Fanex.Affiliate.Admin.Core.ViewModels.EmailTemplateViewModel

<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.ImageRootUrl/bgMain.png?v=001">
            <table width="599" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="88" background="@Model.ImageRootUrl/banner.@(Model.Language).png?v=001"></td>
                </tr>
                <tr>
                    <td>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr bgcolor="#ffffff">
                                <td width="100%" height="62" background="@Model.ImageRootUrl/header.png?v=001">
                                    &nbsp;&nbsp;
                                    <strong style="color: rgb(255, 255, 255); padding-left : 15px; ">
                                        <font style="font-size: 20px; font-family: Verdana,Arial,Helvetica,sans-serif; text-transform: uppercase; color : #333;">
                                            @Model.Title&nbsp;
                                        </font>
                                    </strong>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td bgcolor="#ffffff">
                        <br />
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="15">&nbsp;</td>
                                <td>
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        @Raw(Model.Content)
                                    </font>
                                </td>
                                <td width="15">&nbsp;</td>
                            </tr>
                        </table>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="395">&nbsp;</td>
                                <td align="center" width="184" height="44" background="@Model.ImageRootUrl/button.png?v=001">
                                    <a href="@Model.ImageRootUrl" style="text-decoration: none; border: 0px; color: rgb(255, 255, 255); margin-left: 20px">
                                        <font style="font-size: 20px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 1.5">@Lang.Affiliate</font>
                                    </a><br />
                                </td>
                                <td width="19">&nbsp;</td>
                            </tr>
                            <tr>
                                <td colspan="3" height="30">&nbsp;</td>
                            </tr>
                            <tr>
                                <td colspan="2" align="right" bgcolor="#E5C589" height="30" style="text-align: center">
                                    <font style="font-size: 14px; color: #333333; font-family: Verdana,Arial,Helvetica,sans-serif;">
                                        @string.Format(SiteFriendlyNameHelper.ReplaceB2C(Lang.Copyright), DateTime.Now.Year)
                                    </font>
                                </td>
                                <td width="5" bgcolor="#E5C589"></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td align="center" height="48" background="@Model.ImageRootUrl/note.png?v=001" style="padding-top:20px;">
                        <font style="font-size: 14px; font-weight: 600; color: #967435; font-family: Verdana,Arial,Helvetica,sans-serif; ">
                            @Lang.EmailAutoNotification
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>