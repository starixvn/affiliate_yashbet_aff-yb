@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail
@{
    var isN88 = string.Equals("Nova88", Model.SiteFriendlyName);
}

<div>
    প্রিয় @Raw(Model.FirstName),<br /><br />

    অভিনন্দন, @(Model.SiteFriendlyName) অফিলিয়েট হওয়ার আপনার আবেদন অনুমোদিত হয়েছে!<br /><br />

    আমরা আপনাকে আমাদের অফিলিয়েট পরিবারে স্বাগত জানাই এবং আমরা আপনার সাথে একটি লাভজনক ব্যবসায়িক সম্পর্ক গড়তে উদ্বুদ্ধ আছি। নীচের তথ্যটি ব্যবহার করে আপনার @(Model.SiteFriendlyName) অফিলিয়েট অ্যাকাউন্টে সাইন ইন করুন:<br /><br />

    পাঠ্য লিঙ্ক: <a href="@Model.UserSiteUrl">@Model.UserSiteUrl</a><br />
    ব্যবহারকারীনাম: @Model.UserName<br />
    পাসওয়ার্ড: @Model.Password<br />
    অ্যাফিলিয়েট আইডি: @Model.AffCode<br /><br />

    আপনার অ্যাকাউন্টে আপনি আপনার অফিলিয়েট ট্র্যাকিং ইউআরএল সহ ব্যানার এবং প্রমোশনাল উপাদান পেতে পাবেন। আপনার ট্র্যাফিক প্রেরণ করুন এবং আজই উপার্জন শুরু করুন!<br /><br />

    যদি আপনার কোনও প্রশ্ন থাকে এবং সাহায্য প্রয়োজন হয় তবে অনুগ্রহ করে আমাদের সাথে যোগাযোগ করতে সহজেই বিলম্ব করবেন না।<br /><br />

    সাদরে,<br /><br />
    @(Model.SiteFriendlyName) অফিলিয়েট টীম<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>