@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail
@{
    var isN88 = string.Equals("Nova88", Model.SiteFriendlyName);
}

<div>
    Dear @Raw(Model.FirstName),<br /><br />

    Congratulations, your application to become a @(Model.SiteFriendlyName) Affiliates has been approved!<br /><br />

    We are glad to have you as part of our Affiliates family and we are looking forward to building a profitable business relationship with you.  Please use the below information to sign into your @(Model.SiteFriendlyName) affiliate account:<br /><br />

    Text link: @(isN88 ? "Website (Insert backlink" : "") <a href="@Model.UserSiteUrl">@Model.UserSiteUrl</a>@(isN88 ? ")" : "")<br />
    Username: @Model.UserName<br />
    Password: @Model.Password<br />
    Affiliate ID: @Model.AffCode<br /><br />

    In your account you will find your affiliate tracking URL as well as banners and promotional materials. Send your traffic and start earning today!<br /><br />

    If you have any questions and require any help please do not hesitate to contact us. <br /><br />

    Sincerely,<br /><br />
    @(Model.SiteFriendlyName) Affiliates Team<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>