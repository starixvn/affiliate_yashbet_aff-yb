@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<div>
    प्रिय @Raw(Model.FirstName),<br /><br />

    बधाई हो, @(Model.SiteFriendlyName) सहयोगी बनने के लिए आपका आवेदन स्वीकृत हो गया है!<br /><br />

    हम आपको हमारे सहयोगी परिवार के हिस्से के रूप में पाकर खुश हैं और हम आपके साथ एक लाभदायक व्यावसायिक संबंध बनाने की आशा कर रहे हैं। अपने @(Model.SiteFriendlyName) संबद्ध खाते में साइन इन करने के लिए कृपया नीचे दी गई जानकारी का उपयोग करें:<br /><br />

    टेक्स्ट लिंक: <a href="@Model.UserSiteUrl">@Model.UserSiteUrl</a><br />
    उपयोगकर्ता: @Model.UserName<br />
    पासवर्ड: @Model.Password<br />
    संबद्ध आईडी: @Model.AffCode<br /><br />

    आपके खाते में आप अपने संबद्ध ट्रैकिंग URL के साथ-साथ बैनर और प्रचार सामग्री पाएंगे। अपना ट्रैफ़िक भेजें और आज ही कमाई शुरू करें!<br /><br />

    यदि आपके कोई प्रश्न हैं और किसी भी सहायता की आवश्यकता है, तो कृपया हमसे संपर्क करने में संकोच न करें।<br /><br />

    आपका,<br /><br />
    @(Model.SiteFriendlyName) सहयोगी टीम<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>