@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail
@{
    var isN88 = string.Equals("Nova88", Model.SiteFriendlyName);
}

<div>
    尊敬的 @(Model.FirstName),<br /><br />

    恭喜您, 您的@(Model.SiteFriendlyName)合作伙伴加盟申请已获核准!<br /><br />

    欢迎您成为@(Model.SiteFriendlyName)合作大家庭中的一员，并祝愿我们之间的合作能成为现代商业共赢典范.  请使用以下信息登入您的@(Model.SiteFriendlyName)合作伙伴帐号：<br /><br />

    链接: @(isN88 ? "网站 (Insert backlink" : "") <a href="@Model.UserSiteUrl">@Model.UserSiteUrl</a>@(isN88 ? ")" : "")<br />
    用户名: @Model.UserName<br />
    密码: @Model.Password<br />
    推荐代码: @Model.AffCode<br />
    文本链接 有请登陆您的帐号后，在“媒体册”中查看。<br /><br />

    您可在该帐户内查询到合作伙伴跟踪链接以及横幅等促销素材，无需犹豫，赶快利用您的流量开始赚钱吧！<br /><br />

    如果您遇到任何疑问需要帮助，欢迎随时联系我们.<br /><br />

    诚挚的,<br /><br />
    @(Model.SiteFriendlyName)合作伙伴团队<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>