@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail
@{
    var isN88 = string.Equals("Nova88", Model.SiteFriendlyName);
}

<div>
    សូមគោរព @Raw(Model.FirstName),<br /><br />

    សូមអបអរសាទរ កម្មវិធីសម្ព័ន្ធរបស់អ្នកនៅ@(Model.SiteFriendlyName)បានក្លាយជាសាខាសម្ព័ន្ធពេញសិទ្ធហើយត្រូវបានអនុម័តរួចរាល់!<br /><br />

    យើងខ្ញុំមានសេចក្តីសោមនស្សរីករាយជាខ្លាំងដែលមានអ្នកជាផ្នែកនៃគ្រួសារសាខារបស់យើង ហើយយើងកំពុងទន្ទឹងរង់ចាំក្នុងការកសាងទំនាក់ទំនងអាជីវកម្មដែលមានផលចំណេញជាមួយអ្នក។ សូមប្រើព័ត៌មានខាងក្រោមដើម្បីចូលគណនីសាខាសម្ព័ន្ធ @(Model.SiteFriendlyName) របស់អ្នក៖<br /><br />

    តំណលីងភ្ជាប់អត្ថបទ៖ <a href="@Model.UserSiteUrl">@Model.UserSiteUrl</a><br />
    ឈ្មោះ​អ្នកប្រើប្រាស់: @Model.UserName<br />
    លេខសម្ងាត់: @Model.Password<br />
    លេខសម្គាល់សាខាសម្ព័ន្ធ: @Model.AffCode<br /><br />

    នៅក្នុងគណនីរបស់អ្នក អ្នកនឹងឃើញ URL តាមដានសាខាសម្ព័ន្ធរបស់អ្នក ក៏ដូចជាផ្ទាំង និង សម្ភារៈផ្សព្វផ្សាយផងដែរ។ ផ្ញើចរាចរណ៍របស់អ្នក ហើយចាប់ផ្តើមរកប្រាក់ចំណូលថ្ងៃនេះ!<br /><br />

    ប្រសិនបើអ្នកមានសំណួរ និងទាមទារជំនួយណាមួយ សូមកុំស្ទាក់ស្ទើរក្នុងការទាក់ទងមកយើងខ្ញុំ។<br /><br />

    ដោយក្តីគោរព<br /><br />
    ក្រុមសាខាសម្ព័ន្ធ @(Model.SiteFriendlyName)<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>