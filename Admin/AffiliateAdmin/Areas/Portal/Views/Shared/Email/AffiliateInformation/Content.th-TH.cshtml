@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<div>
    เรียน @(Model.FirstName),<br /><br />

    ขอแสดงความยินดีด้วยครับ ใบสมัครของคุณในการเป็นพันธมิตรกับ @(Model.SiteFriendlyName) ได้รับการอนุมัติเรียบร้อยแล้ว<br /><br />

    เรามีความยินดีเป็นอย่างมากที่ได้คุณมาเป็นส่วนหนึ่งในในครอบครับพันธมิตร เราหวังเป็นอย่างยิ่งที่จะได้สร้างผลกำไรจากความร่วมมือกันกับคุณ  กรุณาใช้ข้อมูลด้านล่างนี้เพื่อล๊อคอินเข้าไปยังบัญชีพันธมิตรของคุณ<br /><br />

    ลิ๊งค์ข้อความ <a href="@Model.UserSiteUrl">@Model.UserSiteUrl</a><br />
    ชื่อที่ใช้เข้าระบบ @Model.UserName<br />
    รหัสผ่านที่ใช้เข้าระบบ @Model.Password<br />
    พันธมิตร ID: @Model.AffCode<br /><br />

    ในบัญชีพันธมิตรของคุณคุณจะเห็นลิ๊งค์พันธมิตรของคุณเช่นเดียวกับแบบเนอร์ที่จะใช้ในการโปรโมต เริ่มรับรายได้ตั้งแต่วันนี้เป็นต้นไป  ถ้าคุณมีคำถามหรือต้องการความช่วยเหลือ กรุณาอย่าลังเลที่จะติดต่อเรา<br /><br />

    ขอแสดงความนับถือ<br /><br />
    ทีมงานพันธมิตร @(Model.SiteFriendlyName)<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>